@model List<WebSapaForestForStaff.DTOs.EventDto>
@{
    ViewData["Title"] = "Quản lý Sự kiện";
    var total = ViewBag.TotalCount ?? 0;
    var page = ViewBag.Page ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var search = ViewBag.Search as string ?? "";
    int totalPages = (int)Math.Ceiling((double)total / pageSize);
}

<h2>Quản lý Sự kiện</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}


<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create">Thêm mới</a>
</div>

<form method="get" class="mb-3">
    <input type="text" name="search" value="@search" placeholder="Tìm kiếm theo tiêu đề" class="form-control" style="width:300px; display:inline-block;" />
    <button type="submit" class="btn btn-secondary">Tìm</button>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Tiêu đề</th>
            <th>Hình ảnh</th>
            <th>Mô tả</th>
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th>Địa điểm</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-center">Không có dữ liệu</td>
            </tr>
        }
        else
        {
            int index = (page - 1) * pageSize + 1;
            foreach (var ev in Model)
            {
                <tr>
                    <td>@index</td>
                    <td>@ev.Title</td>
                    <td>
                        @if (!string.IsNullOrEmpty(ev.ImageUrl))
                        {
                            <img src="@ev.ImageUrl" alt="image" style="width:100px;" />
                        }
                    </td>
                    <td>@ev.Description</td>
                    <td>@ev.StartDate?.ToString("dd/MM/yyyy")</td>
                    <td>@ev.EndDate?.ToString("dd/MM/yyyy")</td>
                    <td>@ev.Location</td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@ev.Id">Sửa</a>
                        <form method="post" asp-action="Delete" asp-route-id="@index" style="display:inline-block;" onsubmit="return confirm('Bạn có chắc muốn xóa?');">
                            <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
                index++;
            }
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == page ? "active" : "")">
                <a class="page-link" href="?search=@search&page=@i&pageSize=@pageSize">@i</a>
            </li>
        }
    </ul>
</nav>
