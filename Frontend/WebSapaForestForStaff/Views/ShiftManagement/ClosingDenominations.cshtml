@model WebSapaForestForStaff.DTOs.ShiftManagement.ShiftDto

@{
    ViewData["Title"] = "Kiểm kê tiền cuối ca";
    Layout = "~/Views/Shared/_counterstaffLayout.cshtml";
}

<style>
    .closing-denominations-container {
        max-width: 900px;
        margin: 40px auto;
        padding: 24px;
    }

    .step-header {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        border-radius: 18px;
        padding: 24px;
        color: white;
        margin-bottom: 32px;
        box-shadow: 0 12px 30px rgba(239, 68, 68, 0.2);
    }

    .denomination-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 20px;
        background: #fef2f2;
        border-radius: 12px;
        margin-bottom: 12px;
        transition: all 0.2s;
        border: 2px solid transparent;
    }

    .denomination-row:hover {
        background: #fee2e2;
        border-color: #ef4444;
    }

    .currency-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: bold;
    }

    .currency-label {
        flex: 1;
        font-weight: 600;
        color: #374151;
        font-size: 18px;
    }

    .count-input {
        width: 120px;
        text-align: center;
        font-size: 18px;
        font-weight: 600;
        border: 2px solid #fca5a5;
        border-radius: 8px;
        padding: 8px;
    }

    .count-input:focus {
        border-color: #ef4444;
        outline: none;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
    }

    .amount-display {
        min-width: 180px;
        text-align: right;
        font-weight: 700;
        color: #ef4444;
        font-size: 20px;
    }

    .total-card {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
        border-radius: 16px;
        padding: 24px;
        margin: 24px 0;
        box-shadow: 0 8px 24px rgba(239, 68, 68, 0.25);
    }

    .reference-card {
        background: #fffbeb;
        border: 2px solid #fbbf24;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 24px;
    }
</style>

<div class="closing-denominations-container">
    <!-- Step Header -->
    <div class="step-header">
        <div class="d-flex align-items-center mb-2">
            <i class="bi bi-calculator fs-1 me-3"></i>
            <div>
                <h3 class="mb-1">Kiểm kê tiền cuối ca</h3>
                <p class="mb-0 opacity-90">Bước 2/4: Đếm số tiền thực tế trong ngăn kéo</p>
            </div>
        </div>
        <div class="progress mt-3" style="height: 6px;">
            <div class="progress-bar" role="progressbar" style="width: 50%; background-color: white;"></div>
        </div>
    </div>

    <!-- Reference Info -->
    <div class="reference-card">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-2"><i class="bi bi-cash-stack me-2"></i><strong>Số dư đầu ca:</strong></div>
                <div class="fs-4 fw-bold text-success">@Model.OpeningBalance?.ToString("N0") ₫</div>
            </div>
            <div class="col-md-6">
                <div class="mb-2"><i class="bi bi-graph-up me-2"></i><strong>Doanh thu tiền mặt (ước tính):</strong></div>
                <div class="fs-4 fw-bold text-primary" id="expectedRevenue">
                    <span class="spinner-border spinner-border-sm me-2"></span>Đang tính...
                </div>
            </div>
        </div>
    </div>

    <!-- Denominations Form -->
    <div class="info-card">
        <h5 class="mb-4"><i class="bi bi-list-check me-2 text-danger"></i>Nhập số lượng tờ tiền</h5>

        <form id="closingDenominationsForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="shiftId" value="@Model.ShiftId" />

            <!-- Denominations List -->
            <div class="denomination-row">
                <div class="currency-icon">500K</div>
                <div class="currency-label">500,000 ₫</div>
                <input type="number" class="form-control count-input" data-denomination="500000" min="0" value="0" onchange="updateTotal()">
                <div class="amount-display">0 ₫</div>
            </div>

            <div class="denomination-row">
                <div class="currency-icon">200K</div>
                <div class="currency-label">200,000 ₫</div>
                <input type="number" class="form-control count-input" data-denomination="200000" min="0" value="0" onchange="updateTotal()">
                <div class="amount-display">0 ₫</div>
            </div>

            <div class="denomination-row">
                <div class="currency-icon">100K</div>
                <div class="currency-label">100,000 ₫</div>
                <input type="number" class="form-control count-input" data-denomination="100000" min="0" value="0" onchange="updateTotal()">
                <div class="amount-display">0 ₫</div>
            </div>

            <div class="denomination-row">
                <div class="currency-icon">50K</div>
                <div class="currency-label">50,000 ₫</div>
                <input type="number" class="form-control count-input" data-denomination="50000" min="0" value="0" onchange="updateTotal()">
                <div class="amount-display">0 ₫</div>
            </div>

            <div class="denomination-row">
                <div class="currency-icon">20K</div>
                <div class="currency-label">20,000 ₫</div>
                <input type="number" class="form-control count-input" data-denomination="20000" min="0" value="0" onchange="updateTotal()">
                <div class="amount-display">0 ₫</div>
            </div>

            <div class="denomination-row">
                <div class="currency-icon">10K</div>
                <div class="currency-label">10,000 ₫</div>
                <input type="number" class="form-control count-input" data-denomination="10000" min="0" value="0" onchange="updateTotal()">
                <div class="amount-display">0 ₫</div>
            </div>

            <div class="denomination-row">
                <div class="currency-icon">5K</div>
                <div class="currency-label">5,000 ₫</div>
                <input type="number" class="form-control count-input" data-denomination="5000" min="0" value="0" onchange="updateTotal()">
                <div class="amount-display">0 ₫</div>
            </div>

            <div class="denomination-row">
                <div class="currency-icon">2K</div>
                <div class="currency-label">2,000 ₫</div>
                <input type="number" class="form-control count-input" data-denomination="2000" min="0" value="0" onchange="updateTotal()">
                <div class="amount-display">0 ₫</div>
            </div>

            <div class="denomination-row">
                <div class="currency-icon">1K</div>
                <div class="currency-label">1,000 ₫</div>
                <input type="number" class="form-control count-input" data-denomination="1000" min="0" value="0" onchange="updateTotal()">
                <div class="amount-display">0 ₫</div>
            </div>

            <!-- Total -->
            <div class="total-card">
                <div class="text-center">
                    <div class="mb-2 opacity-90">Tổng số tiền kiểm kê:</div>
                    <div class="fs-1 fw-bold" id="totalAmount">0 ₫</div>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-3 mt-4">
                <a asp-action="Closing" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại
                </a>
                <button type="button" onclick="submitClosingDenominations()" class="btn btn-danger btn-lg flex-grow-1 action-btn" id="submitBtn">
                    <i class="bi bi-arrow-right me-2"></i>Tiếp theo
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const shiftId = @Model.ShiftId;
        const openingBalance = @(Model.OpeningBalance ?? 0);

        function formatCurrency(amount) {
            return amount.toLocaleString('vi-VN') + ' ₫';
        }

        function updateTotal() {
            let total = 0;
            
            document.querySelectorAll('.count-input').forEach(input => {
                const denom = parseInt(input.dataset.denomination);
                const count = parseInt(input.value) || 0;
                const amount = denom * count;
                total += amount;
                
                // Update row total
                const row = input.closest('.denomination-row');
                const amountDisplay = row.querySelector('.amount-display');
                amountDisplay.textContent = formatCurrency(amount);
            });
            
            // Update total display
            document.getElementById('totalAmount').textContent = formatCurrency(total);
        }

        async function submitClosingDenominations() {
            const denominations = [];
            let totalAmount = 0;
            
            document.querySelectorAll('.count-input').forEach(input => {
                const denom = parseInt(input.dataset.denomination);
                const count = parseInt(input.value) || 0;
                
                if (count > 0) {
                    denominations.push({
                        denomination: denom,
                        count: count
                    });
                    totalAmount += denom * count;
                }
            });
            
            if (totalAmount === 0) {
                showToast('Vui lòng nhập số lượng tiền', 'error');
                return;
            }
            
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...';
            
            try {
                const response = await fetch('/shift-management/closing/denominations', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        shiftId: shiftId,
                        denominations: denominations,
                        totalAmount: totalAmount
                    })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Navigate to review page with difference data
                    sessionStorage.setItem('closingDifference', JSON.stringify(result.difference));
                    window.location.href = `/shift-management/closing/review`;
                } else {
                    showToast(result.message || 'Lỗi khi lưu mệnh giá', 'error');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-arrow-right me-2"></i>Tiếp theo';
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Lỗi kết nối. Vui lòng thử lại.', 'error');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-arrow-right me-2"></i>Tiếp theo';
            }
        }

        function showToast(message, type = 'success') {
            let container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                container.style.cssText = 'position: fixed; top: 80px; right: 20px; z-index: 9999;';
                document.body.appendChild(container);
            }

            const bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
            const icon = type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation';

            const toastHtml = `
                <div class="toast align-items-center text-white ${bgClass} border-0 mb-2 show" role="alert">
                    <div class="d-flex">
                        <div class="toast-body"><i class="fa-solid ${icon} me-2"></i> ${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', toastHtml);

            setTimeout(() => {
                const toastElement = container.lastElementChild;
                if (toastElement) {
                    toastElement.classList.remove('show');
                    setTimeout(() => toastElement.remove(), 300);
                }
            }, 3000);
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            updateTotal();
        });
    </script>
}

