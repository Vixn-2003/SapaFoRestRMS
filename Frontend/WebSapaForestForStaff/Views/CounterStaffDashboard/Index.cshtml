@model WebSapaForestForStaff.ViewModels.CounterStaff.CounterStaffDashboardViewModel

@{
    ViewData["Title"] = "Bảng điều khiển Nhân viên quầy";
    Layout = "~/Views/Shared/_counterstaffLayout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Bảng điều khiển Nhân viên quầy</h2>
            <small class="text-muted">Tổng quan thời gian thực - @DateTime.Today.ToString("dd/MM/yyyy")</small>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "CounterStaffOrder")" class="btn btn-outline-primary">
                <i class="bi bi-list-ul me-1"></i>Danh sách đơn hàng
            </a>
            <a href="@Url.Action("Index", "CounterStaffTransaction")" class="btn btn-outline-info">
                <i class="bi bi-receipt me-1"></i>Lịch sử giao dịch
            </a>
            <a href="@Url.Action("Index", "ShiftManagement")" class="btn btn-outline-secondary">
                <i class="bi bi-calendar3 me-1"></i>Quản lý ca làm việc
            </a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-calendar-check fs-4 text-primary"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Đặt bàn hôm nay</h6>
                            <h3 class="mb-0">@Model.Dashboard.TodayReservations</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-success bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-cash-stack fs-4 text-success"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Doanh thu hôm nay</h6>
                            <h3 class="mb-0">@Model.Dashboard.TodayRevenue.ToString("N0") ₫</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-warning bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-cart fs-4 text-warning"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Đơn hàng đang xử lý</h6>
                            <h3 class="mb-0">@Model.Dashboard.ActiveOrders</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-danger bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-clock-history fs-4 text-danger"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Thanh toán chờ xử lý</h6>
                            <h3 class="mb-0">@Model.Dashboard.PendingPayments</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-info bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-table fs-4 text-info"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Bàn đang sử dụng</h6>
                            <h3 class="mb-0">@Model.Dashboard.ActiveTables</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 bg-secondary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-check-circle fs-4 text-secondary"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Giao dịch hoàn thành</h6>
                            <h3 class="mb-0">@Model.Dashboard.CompletedTransactions</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-3">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Xu hướng doanh thu (Hôm nay)</h5>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Số đơn hàng theo giờ (Hôm nay)</h5>
                </div>
                <div class="card-body">
                    <canvas id="orderChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Revenue Chart Data (embedded from Model)
        const revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Dashboard.RevenueChart));
        const orderData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Dashboard.OrderChart));

        // Revenue Trend Chart
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: revenueData.map(d => `${d.hour}:00`),
                datasets: [{
                    label: 'Doanh thu (₫)',
                    data: revenueData.map(d => d.revenue),
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ' + context.parsed.y.toLocaleString('vi-VN') + ' ₫';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('vi-VN') + ' ₫';
                            }
                        }
                    }
                }
            }
        });

        // Order Count Chart
        const orderCtx = document.getElementById('orderChart').getContext('2d');
        new Chart(orderCtx, {
            type: 'bar',
            data: {
                labels: orderData.map(d => `${d.hour}:00`),
                datasets: [{
                    label: 'Số đơn hàng',
                    data: orderData.map(d => d.orderCount),
                    backgroundColor: 'rgba(255, 159, 64, 0.6)',
                    borderColor: 'rgb(255, 159, 64)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                }
            }
        });
    </script>
}

