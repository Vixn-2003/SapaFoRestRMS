@using System.Text.Json
@model dynamic

@{
    ViewData["Title"] = "Xác Nhận Hóa Đơn";
    Layout = "~/Views/Shared/_counterstaffLayout.cshtml";
    
    var order = ViewBag.Order as JsonElement?;
    var orderId = ViewBag.OrderId;
}

<style>
    /* === Main Layout === */
    .confirmation-container {
        padding: 24px;
        background: #f8f9fa;
        min-height: calc(100vh - 80px);
    }
    
    .confirmation-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        margin-bottom: 20px;
    }
    
    .card-header-custom {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 16px 24px;
        border-radius: 12px 12px 0 0;
        font-weight: 600;
        font-size: 18px;
    }
    
    .card-body-custom {
        padding: 24px;
    }
    
    /* === Section Headers === */
    .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid #e9ecef;
    }
    
    .section-icon {
        font-size: 24px;
    }
    
    .section-title {
        font-size: 20px;
        font-weight: 600;
        color: #2d3748;
        margin: 0;
    }
    
    .section-subtitle {
        font-size: 14px;
        color: #718096;
        margin: 0;
    }
    
    /* === Kitchen Items Table === */
    .kitchen-section {
        margin-bottom: 32px;
    }
    
    .table-kitchen {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }
    
    .table-kitchen thead {
        background: #f7fafc;
    }
    
    .table-kitchen th {
        padding: 12px 16px;
        text-align: left;
        font-weight: 600;
        color: #4a5568;
        border-bottom: 2px solid #e2e8f0;
        font-size: 14px;
    }
    
    .table-kitchen td {
        padding: 16px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 14px;
    }
    
    /* Row background colors */
    .bg-cancelable {
        background-color: #E8FBE8 !important; /* Xanh nhạt - có thể hủy */
    }
    
    .bg-non-cancelable {
        background-color: #F5F5F5 !important; /* Xám nhạt - không thể hủy */
    }
    
    .table-kitchen tbody tr:hover {
        filter: brightness(0.97);
    }
    
    /* === Kitchen Status Badges === */
    .badge-kitchen-notstarted {
        background: #48bb78;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    
    .badge-kitchen-cooking {
        background: #ed8936;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    
    .badge-kitchen-done {
        background: #4299e1;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    
    .badge-kitchen-removed {
        background: #e53e3e;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    
    /* === Consumption Items Section === */
    .consumption-section {
        margin-bottom: 32px;
    }
    
    .quantity-input {
        width: 80px;
        text-align: center;
        border: 2px solid #cbd5e0;
        border-radius: 6px;
        padding: 8px;
        font-size: 14px;
        font-weight: 600;
    }
    
    .quantity-input:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }
    
    .quantity-input.invalid {
        border-color: #fc8181;
        background-color: #fff5f5;
    }
    
    .quantity-info {
        font-size: 12px;
        color: #718096;
        margin-top: 4px;
    }
    
    /* === Tooltips === */
    .tooltip-icon {
        display: inline-block;
        width: 18px;
        height: 18px;
        background: #4299e1;
        color: white;
        border-radius: 50%;
        text-align: center;
        line-height: 18px;
        font-size: 12px;
        cursor: help;
        margin-left: 6px;
    }
    
    /* === Action Buttons === */
    .btn-cancel-item {
        background: #fc8181;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .btn-cancel-item:hover {
        background: #e53e3e;
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(229, 62, 62, 0.3);
    }
    
    .btn-cancel-item:disabled {
        background: #cbd5e0;
        cursor: not-allowed;
        transform: none;
    }
    
    /* === Summary Section === */
    .summary-section {
        background: #f7fafc;
        padding: 24px;
        border-radius: 8px;
        margin-top: 24px;
    }
    
    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        font-size: 15px;
    }
    
    .summary-row.highlight {
        font-weight: 600;
        font-size: 18px;
        padding-top: 16px;
        margin-top: 16px;
        border-top: 2px solid #cbd5e0;
        color: #2d3748;
    }
    
    .summary-label {
        color: #4a5568;
    }
    
    .summary-value {
        color: #2d3748;
        font-weight: 600;
    }
    
    /* === Action Footer === */
    .action-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1px solid #e2e8f0;
    }
    
    .btn-confirm-order {
        background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
        color: white;
        padding: 14px 32px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 12px rgba(72, 187, 120, 0.4);
    }
    
    .btn-confirm-order:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(72, 187, 120, 0.5);
    }
    
    .btn-confirm-order:disabled {
        background: #cbd5e0;
        cursor: not-allowed;
        box-shadow: none;
        transform: none;
    }
    
    .btn-back {
        background: #e2e8f0;
        color: #2d3748;
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .btn-back:hover {
        background: #cbd5e0;
    }
    
    /* === Alert Messages === */
    .alert-custom {
        padding: 16px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .alert-info {
        background: #ebf8ff;
        border-left: 4px solid #4299e1;
        color: #2c5282;
    }
    
    .alert-warning {
        background: #fffaf0;
        border-left: 4px solid #ed8936;
        color: #7c2d12;
    }
    
    /* === Empty State === */
    .empty-state {
        text-align: center;
        padding: 48px 24px;
        color: #718096;
    }
    
    .empty-state-icon {
        font-size: 48px;
        margin-bottom: 16px;
    }
    
    /* === Responsive === */
    @@media (max-width: 768px) {
        .confirmation-container {
            padding: 16px;
        }
        
        .table-kitchen {
            font-size: 13px;
        }
        
        .table-kitchen th,
        .table-kitchen td {
            padding: 10px 8px;
        }
        
        .action-footer {
            flex-direction: column;
            gap: 12px;
        }
        
        .btn-confirm-order,
        .btn-back {
            width: 100%;
        }
    }
</style>

<div class="confirmation-container">
    <!-- Header -->
    <div class="confirmation-card">
        <div class="card-header-custom">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <div style="font-size: 24px; margin-bottom: 4px;">🧾 Xác Nhận Hóa Đơn</div>
                    <div style="font-size: 14px; font-weight: 400; opacity: 0.9;">
                        Đơn hàng #@(order?.GetProperty("orderCode").GetString() ?? "N/A") | 
                        Bàn: @(order?.GetProperty("tableNumber").GetString() ?? "N/A")
                    </div>
                </div>
                <div style="text-align: right;">
                    <div style="font-size: 13px; opacity: 0.8;">Khách hàng</div>
                    <div style="font-size: 16px;">@(order?.GetProperty("customerName").GetString() ?? "Khách vãng lai")</div>
                </div>
            </div>
        </div>
    </div>
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-custom alert-warning">
            <i class="bi bi-exclamation-triangle" style="font-size: 20px;"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-custom alert-info">
            <i class="bi bi-check-circle" style="font-size: 20px;"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    
    <form id="confirmOrderForm" asp-action="Confirm" asp-controller="OrderConfirmation" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="orderId" value="@orderId" />
        <input type="hidden" name="consumptionItemsJson" id="consumptionItemsJson" value="" />
        
        <!-- SECTION 1: Kitchen Items -->
        @if (order.HasValue)
        {
            var kitchenItems = order.Value.GetProperty("kitchenItems");
            
            if (kitchenItems.GetArrayLength() > 0)
            {
                <div class="confirmation-card kitchen-section">
                    <div class="card-body-custom">
                        <div class="section-header">
                            <span class="section-icon">👨‍🍳</span>
                            <div>
                                <h3 class="section-title">Món Chế Biến Trong Bếp</h3>
                                <p class="section-subtitle">
                                    Các món này bắt buộc thanh toán 100% số lượng đã đặt nếu bếp đã bắt đầu chế biến
                                    <span class="tooltip-icon" title="Món ở trạng thái 'Chưa chế biến' có thể hủy. Món đang hoặc đã chế biến không thể hủy.">?</span>
                                </p>
                            </div>
                        </div>
                        
                        <table class="table-kitchen">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">STT</th>
                                    <th>Tên Món</th>
                                    <th style="width: 100px; text-align: center;">SL Đặt</th>
                                    <th style="width: 180px;">Trạng Thái Bếp</th>
                                    <th style="width: 120px; text-align: right;">Đơn Giá</th>
                                    <th style="width: 140px; text-align: right;">Thành Tiền</th>
                                    <th style="width: 100px; text-align: center;">Tác Vụ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var kitchenIndex = 1;
                                    foreach (var item in kitchenItems.EnumerateArray())
                                    {
                                        var canCancel = item.GetProperty("canCancel").GetBoolean();
                                        var rowClass = canCancel ? "bg-cancelable" : "bg-non-cancelable";
                                        var statusBadge = item.GetProperty("statusBadgeClass").GetString();
                                        var kitchenStatus = item.GetProperty("kitchenStatus").GetString();
                                        
                                        <tr class="@rowClass">
                                            <td style="text-align: center; font-weight: 600;">@kitchenIndex</td>
                                            <td>
                                                <div style="font-weight: 600;">@item.GetProperty("itemName").GetString()</div>
                                                @if (item.GetProperty("itemType").GetString() == "Combo")
                                                {
                                                    <div style="font-size: 12px; color: #718096;">Combo</div>
                                                }
                                            </td>
                                            <td style="text-align: center; font-weight: 600; font-size: 16px;">
                                                @item.GetProperty("quantityOrdered").GetInt32()
                                            </td>
                                            <td>
                                                <span class="@statusBadge">@kitchenStatus</span>
                                                @if (canCancel)
                                                {
                                                    <div style="font-size: 11px; color: #48bb78; margin-top: 4px;">
                                                        ✓ Có thể hủy món
                                                    </div>
                                                }
                                            </td>
                                            <td style="text-align: right; font-weight: 500;">
                                                @item.GetProperty("unitPrice").GetDecimal().ToString("N0") ₫
                                            </td>
                                            <td style="text-align: right; font-weight: 600; color: #2d3748; font-size: 15px;">
                                                @item.GetProperty("totalPrice").GetDecimal().ToString("N0") ₫
                                            </td>
                                            <td style="text-align: center;">
                                                @if (canCancel)
                                                {
                                                    <button type="button" class="btn-cancel-item" 
                                                            onclick="cancelKitchenItem(@item.GetProperty("orderDetailId").GetInt32())">
                                                        ❌ Hủy món
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span style="color: #cbd5e0;">—</span>
                                                }
                                            </td>
                                        </tr>
                                        kitchenIndex++;
                                    }
                                }
                            </tbody>
                        </table>
                        
                        <div style="margin-top: 16px; padding: 12px; background: #f7fafc; border-radius: 6px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-weight: 600; color: #4a5568;">Tổng tiền món bếp:</span>
                                <span style="font-size: 18px; font-weight: 700; color: #2d3748;">
                                    @order.Value.GetProperty("kitchenItemsSubtotal").GetDecimal().ToString("N0") ₫
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        
        <!-- SECTION 2: Consumption Items -->
        @if (order.HasValue)
        {
            var consumptionItems = order.Value.GetProperty("consumptionItems");
            
            if (consumptionItems.GetArrayLength() > 0)
            {
                <div class="confirmation-card consumption-section">
                    <div class="card-body-custom">
                        <div class="section-header">
                            <span class="section-icon">🍺</span>
                            <div>
                                <h3 class="section-title">Món Tính Theo Số Lượng Sử Dụng Thực Tế</h3>
                                <p class="section-subtitle">
                                    Bia, nước ngọt, khăn lạnh... Khách chỉ thanh toán số lượng đã sử dụng
                                    <span class="tooltip-icon" title="Nhập số lượng thực tế khách đã sử dụng. Chỉ tính tiền theo số lượng này.">?</span>
                                </p>
                            </div>
                        </div>
                        
                        <table class="table-kitchen">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">STT</th>
                                    <th>Tên Món</th>
                                    <th style="width: 100px; text-align: center;">SL Đặt</th>
                                    <th style="width: 140px; text-align: center;">
                                        SL Dùng 
                                        <span class="tooltip-icon" title="Số lượng thực tế khách đã sử dụng">?</span>
                                    </th>
                                    <th style="width: 120px; text-align: right;">Đơn Giá</th>
                                    <th style="width: 140px; text-align: right;">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody id="consumptionItemsTable">
                                @{
                                    var consumptionIndex = 1;
                                    foreach (var item in consumptionItems.EnumerateArray())
                                    {
                                        var itemId = item.GetProperty("orderDetailId").GetInt32();
                                        var quantityOrdered = item.GetProperty("quantityOrdered").GetInt32();
                                        var quantityUsed = item.TryGetProperty("quantityUsed", out var qu) ? qu.GetInt32() : quantityOrdered;
                                        var unitPrice = item.GetProperty("unitPrice").GetDecimal();
                                        
                                        <tr data-item-id="@itemId" data-unit-price="@unitPrice">
                                            <td style="text-align: center; font-weight: 600;">@consumptionIndex</td>
                                            <td>
                                                <div style="font-weight: 600;">@item.GetProperty("itemName").GetString()</div>
                                            </td>
                                            <td style="text-align: center; font-weight: 600; font-size: 16px; color: #718096;">
                                                @quantityOrdered
                                            </td>
                                            <td style="text-align: center;">
                                                <input type="number" 
                                                       class="quantity-input consumption-quantity"
                                                       data-item-id="@itemId"
                                                       data-max="@quantityOrdered"
                                                       value="@quantityUsed"
                                                       min="0"
                                                       max="@quantityOrdered"
                                                       onchange="updateConsumptionTotal(@itemId)"
                                                       oninput="validateQuantityInput(this)" />
                                                <div class="quantity-info">Max: @quantityOrdered</div>
                                            </td>
                                            <td style="text-align: right; font-weight: 500;">
                                                @unitPrice.ToString("N0") ₫
                                            </td>
                                            <td style="text-align: right; font-weight: 600; color: #2d3748; font-size: 15px;">
                                                <span class="item-total" data-item-id="@itemId">
                                                    @((quantityUsed * unitPrice).ToString("N0")) ₫
                                                </span>
                                            </td>
                                        </tr>
                                        consumptionIndex++;
                                    }
                                }
                            </tbody>
                        </table>
                        
                        <div style="margin-top: 16px; padding: 12px; background: #f7fafc; border-radius: 6px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-weight: 600; color: #4a5568;">Tổng tiền món tiêu hao:</span>
                                <span id="consumptionSubtotal" style="font-size: 18px; font-weight: 700; color: #2d3748;">
                                    @order.Value.GetProperty("consumptionItemsSubtotal").GetDecimal().ToString("N0") ₫
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        
        <!-- Summary Section -->
        <div class="confirmation-card">
            <div class="card-body-custom">
                <div class="summary-section">
                    <div class="summary-row">
                        <span class="summary-label">Tạm tính:</span>
                        <span class="summary-value" id="subtotalDisplay">
                            @order?.GetProperty("subtotal").GetDecimal().ToString("N0") ₫
                        </span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">VAT (10%):</span>
                        <span class="summary-value" id="vatDisplay">
                            @order?.GetProperty("vatAmount").GetDecimal().ToString("N0") ₫
                        </span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Phí dịch vụ (5%):</span>
                        <span class="summary-value" id="serviceFeeDisplay">
                            @order?.GetProperty("serviceFee").GetDecimal().ToString("N0") ₫
                        </span>
                    </div>
                    @if (order?.GetProperty("discountAmount").GetDecimal() > 0)
                    {
                        <div class="summary-row">
                            <span class="summary-label">Giảm giá:</span>
                            <span class="summary-value" style="color: #e53e3e;">
                                -@order?.GetProperty("discountAmount").GetDecimal().ToString("N0") ₫
                            </span>
                        </div>
                    }
                    <div class="summary-row highlight">
                        <span>Tổng cộng thanh toán:</span>
                        <span id="totalDisplay" style="color: #667eea; font-size: 22px;">
                            @order?.GetProperty("totalAmount").GetDecimal().ToString("N0") ₫
                        </span>
                    </div>
                </div>
                
                <div class="action-footer">
                    <a href="@Url.Action("OrderSelection", "CashierPaymentFlow")" class="btn-back">
                        ← Quay lại danh sách
                    </a>
                    
                    <button type="submit" class="btn-confirm-order" id="btnConfirmOrder">
                        ✓ Xác Nhận Hóa Đơn
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Store initial values
        let kitchenSubtotal = @order?.GetProperty("kitchenItemsSubtotal").GetDecimal();
        let initialConsumptionSubtotal = @order?.GetProperty("consumptionItemsSubtotal").GetDecimal();
        let discountAmount = @order?.GetProperty("discountAmount").GetDecimal();
        
        // Validate quantity input
        function validateQuantityInput(input) {
            const max = parseInt(input.dataset.max);
            const value = parseInt(input.value) || 0;
            
            if (value < 0) {
                input.value = 0;
                input.classList.add('invalid');
            } else if (value > max) {
                input.value = max;
                input.classList.add('invalid');
                setTimeout(() => input.classList.remove('invalid'), 300);
            } else {
                input.classList.remove('invalid');
            }
        }
        
        // Update consumption item total
        function updateConsumptionTotal(itemId) {
            const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
            if (!row) return;
            
            const input = row.querySelector('.consumption-quantity');
            const quantityUsed = parseInt(input.value) || 0;
            const unitPrice = parseFloat(row.dataset.unitPrice);
            const totalPrice = quantityUsed * unitPrice;
            
            const totalSpan = row.querySelector(`.item-total[data-item-id="${itemId}"]`);
            if (totalSpan) {
                totalSpan.textContent = totalPrice.toLocaleString('vi-VN') + ' ₫';
            }
            
            // Recalculate consumption subtotal
            updateConsumptionSubtotal();
        }
        
        // Update consumption subtotal
        function updateConsumptionSubtotal() {
            let total = 0;
            document.querySelectorAll('#consumptionItemsTable tr').forEach(row => {
                const itemId = row.dataset.itemId;
                if (!itemId) return;
                
                const input = row.querySelector('.consumption-quantity');
                const quantityUsed = parseInt(input.value) || 0;
                const unitPrice = parseFloat(row.dataset.unitPrice);
                
                total += quantityUsed * unitPrice;
            });
            
            document.getElementById('consumptionSubtotal').textContent = 
                total.toLocaleString('vi-VN') + ' ₫';
            
            // Recalculate grand total
            updateGrandTotal(total);
        }
        
        // Update grand total
        function updateGrandTotal(consumptionSubtotal) {
            const subtotal = kitchenSubtotal + consumptionSubtotal;
            const vat = subtotal * 0.1;
            const serviceFee = subtotal * 0.05;
            const total = subtotal + vat + serviceFee - discountAmount;
            
            document.getElementById('subtotalDisplay').textContent = 
                subtotal.toLocaleString('vi-VN') + ' ₫';
            document.getElementById('vatDisplay').textContent = 
                vat.toLocaleString('vi-VN') + ' ₫';
            document.getElementById('serviceFeeDisplay').textContent = 
                serviceFee.toLocaleString('vi-VN') + ' ₫';
            document.getElementById('totalDisplay').textContent = 
                total.toLocaleString('vi-VN') + ' ₫';
        }
        
        // Cancel kitchen item
        async function cancelKitchenItem(orderDetailId) {
            const confirmCancel = confirm('Bạn có chắc chắn muốn hủy món này?');
            if (!confirmCancel) return;
            
            const reason = prompt('Nhập lý do hủy món:');
            if (!reason || reason.trim() === '') {
                alert('Vui lòng nhập lý do hủy món');
                return;
            }
            
            try {
                const token = getCookie('jwtToken');
                const response = await fetch('/api/orderconfirmation/cancel-item', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        orderId: @orderId,
                        orderDetailId: orderDetailId,
                        reason: reason
                    })
                });
                
                if (response.ok) {
                    alert('Hủy món thành công!');
                    location.reload();
                } else {
                    const error = await response.json();
                    alert('Không thể hủy món: ' + (error.message || 'Lỗi không xác định'));
                }
            } catch (error) {
                console.error('Error cancelling item:', error);
                alert('Có lỗi xảy ra khi hủy món');
            }
        }
        
        // Handle form submission
        document.getElementById('confirmOrderForm').addEventListener('submit', function(e) {
            // Collect consumption items data
            const consumptionItems = [];
            document.querySelectorAll('.consumption-quantity').forEach(input => {
                const itemId = parseInt(input.dataset.itemId);
                const quantityUsed = parseInt(input.value) || 0;
                
                consumptionItems.push({
                    orderDetailId: itemId,
                    quantityUsed: quantityUsed
                });
            });
            
            // Set hidden input value
            document.getElementById('consumptionItemsJson').value = JSON.stringify(consumptionItems);
        });
        
        // Utility: Get cookie
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }
        
        // Initialize tooltips (if using Bootstrap)
        document.querySelectorAll('.tooltip-icon').forEach(el => {
            el.title = el.getAttribute('title');
        });
    </script>
}

