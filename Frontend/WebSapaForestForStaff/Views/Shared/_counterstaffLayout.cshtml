@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="~/css/waiter/restaurant-layout.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>

    <!-- HEADER -->
    <div class="top-navbar pos-navbar">
        <div class="top-left">
            <!-- Logo / Home -->
            <div class="home-icon">
                🏠
                <span class="app-title">Sapa Restaurant</span>
            </div>

            <!-- Menu chính -->
            <div class="top-menu">
                <a href="/DashboardTable/ListOrder" class="menu-item">Đơn đặt bàn</a>
                <a href="/DashboardTable/Index" class="menu-item">Sơ đồ bàn</a>
                <a href="/OrderTable/AssistanceList" class="menu-item">Hỗ trợ</a>
            </div>
        </div>

        <!-- Phần thông tin / icon -->
        <div class="top-right">
            <div class="icon-btn notifications">
                🔔
                <span class="badge"></span>
            </div>
            <div class="icon-btn user-profile">
                <i class="fa-solid fa-user"></i>
            </div>
        </div>
    </div>


    <div class="main-container">
        @RenderBody()
    </div>

    <!-- SCRIPT ACTIVE MENU -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentUrl = window.location.pathname.toLowerCase();
            document.querySelectorAll(".menu-item").forEach(function(item) {
                const href = item.getAttribute("href").toLowerCase();
                if (currentUrl === href || currentUrl.startsWith(href)) {
                    item.classList.add("active");
                } else {
                    item.classList.remove("active");
                }
            });
        });
    </script>
</body>
</html>
