<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - Sapa Forest Kitchen</title>

    <!-- plugins:css -->
    <link rel="stylesheet" href="~/assets/vendors/feather/feather.css">
    <link rel="stylesheet" href="~/assets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/assets/vendors/ti-icons/css/themify-icons.css">
    <link rel="stylesheet" href="~/assets/vendors/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/assets/vendors/typicons/typicons.css">
    <link rel="stylesheet" href="~/assets/vendors/simple-line-icons/css/simple-line-icons.css">
    <link rel="stylesheet" href="~/assets/vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="~/assets/vendors/bootstrap-datepicker/bootstrap-datepicker.min.css">
    <link rel="stylesheet" href="~/assets/vendors/datatables.net-bs4/dataTables.bootstrap4.css">
    <link rel="stylesheet" type="text/css" href="~/assets/js/select.dataTables.min.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="shortcut icon" href="~/assets/images/favicon.png" />
    
    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    
    <!-- jQuery + Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    
    <!-- Toastr config -->
    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "5000",
            "extendedTimeOut": "2000",
            "escapeHtml": false
        };
    </script>

    @RenderSection("Styles", required: false)
</head>

<body class="with-welcome-text">
    <div class="container-scroller">
        <!-- Header -->
        <nav class="navbar default-layout col-lg-12 col-12 p-0 fixed-top d-flex align-items-top flex-row">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-start">
                <div class="me-3">
                    <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-bs-toggle="minimize">
                        <span class="icon-menu"></span>
                    </button>
                </div>
                <div>
                    <a class="navbar-brand brand-logo" href="/KitchenDisplay/Index">
                        <img src="~/assets/images/logo.svg" alt="logo" />
                    </a>
                    <a class="navbar-brand brand-logo-mini" href="/KitchenDisplay/Index">
                        <img src="~/assets/images/logo-mini.svg" alt="logo" />
                    </a>
                </div>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-top">
                <ul class="navbar-nav">
                    <li class="nav-item fw-semibold d-none d-lg-block ms-0">
                        <h1 class="welcome-text">Hệ thống Bếp, <span class="text-black fw-bold">@(User.Identity?.Name ?? "User")</span></h1>
                        <h3 class="welcome-sub-text">Chúc làm việc tốt!!!</h3>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown d-none d-lg-block user-dropdown">
                        <a class="nav-link" id="UserDropdown" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                            <img class="img-xs rounded-circle" src="~/assets/images/faces/face8.jpg" alt="Profile image">
                        </a>
                        <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="UserDropdown">
                            <div class="dropdown-header text-center">
                                <img class="img-md rounded-circle" src="~/assets/images/faces/face8.jpg" alt="Profile image">
                                <p class="mb-1 mt-3 fw-semibold">@(User.Identity?.Name ?? "User")</p>
                                <p class="fw-light text-muted mb-0">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "")</p>
                            </div>
                            <a class="dropdown-item" asp-controller="UserProfile" asp-action="Index">
                                <i class="dropdown-item-icon mdi mdi-account-circle text-primary me-2"></i>Hồ sơ của tôi
                            </a>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="dropdown-item p-0 m-0">
                                <button type="submit" class="btn btn-link dropdown-item p-0 m-0 w-100 text-start">
                                    <i class="dropdown-item-icon mdi mdi-power text-primary me-2"></i>Đăng xuất
                                </button>
                            </form>
                        </div>
                    </li>
                </ul>
                <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-bs-toggle="offcanvas">
                    <span class="mdi mdi-menu"></span>
                </button>
            </div>
        </nav>

        <div class="container-fluid page-body-wrapper">
            <!-- Sidebar -->
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav">
                    <li class="nav-item nav-category">Màn hình Bếp</li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="KitchenDisplay" asp-action="Index">
                            <span class="menu-icon"><i class="mdi mdi-monitor"></i></span>
                            <span class="menu-title">Bếp Phó (KDS)</span>
                        </a>
                    </li>
                    <li class="nav-item nav-category">Trạm Bếp</li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="KitchenDisplay" asp-action="Station" asp-route-categoryName="Khai Vị">
                            <span class="menu-icon"><i class="mdi mdi-leaf"></i></span>
                            <span class="menu-title">Trạm Khai Vị</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="KitchenDisplay" asp-action="Station" asp-route-categoryName="Lẩu">
                            <span class="menu-icon"><i class="mdi mdi-pot-steam"></i></span>
                            <span class="menu-title">Trạm Lẩu</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="KitchenDisplay" asp-action="Station" asp-route-categoryName="Nướng than">
                            <span class="menu-icon"><i class="mdi mdi-fire"></i></span>
                            <span class="menu-title">Trạm Nướng than</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="KitchenDisplay" asp-action="Station" asp-route-categoryName="Xào – Chiên">
                            <span class="menu-icon"><i class="mdi mdi-stove"></i></span>
                            <span class="menu-title">Trạm Xào – Chiên</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="KitchenDisplay" asp-action="Station" asp-route-categoryName="Trạm Cơm – Canh">
                            <span class="menu-icon"><i class="mdi mdi-bowl"></i></span>
                            <span class="menu-title">Trạm Cơm – Canh</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="KitchenDisplay" asp-action="Station" asp-route-categoryName="Tráng Miệng">
                            <span class="menu-icon"><i class="mdi mdi-cupcake"></i></span>
                            <span class="menu-title">Trạm Tráng Miệng</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Main Content -->
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>

                <!-- Footer -->
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">
                            © 2025 Sapa Forest Restaurant Management - Kitchen System
                        </span>
                        <span class="float-none float-sm-right d-block mt-1 mt-sm-0 text-center">
                            Made with <i class="mdi mdi-heart text-danger"></i> by Lương
                        </span>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <!-- Vendor Scripts -->
    <script src="~/assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/assets/vendors/bootstrap-datepicker/bootstrap-datepicker.min.js"></script>
    <script src="~/assets/vendors/chart.js/chart.umd.js"></script>
    <script src="~/assets/vendors/progressbar.js/progressbar.min.js"></script>

    <!-- Framework Scripts -->
    <script src="~/assets/js/off-canvas.js"></script>
    <script src="~/assets/js/template.js"></script>
    <script src="~/assets/js/settings.js"></script>
    <script src="~/assets/js/hoverable-collapse.js"></script>
    <script src="~/assets/js/todolist.js"></script>
    <script src="~/assets/js/jquery.cookie.js"></script>
    <script src="~/assets/js/dashboard.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>

