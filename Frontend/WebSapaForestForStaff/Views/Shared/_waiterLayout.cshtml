@using System.Security.Claims
@{
    Layout = null;

    // Xác định controller hiện tại để highlight menu
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Waiter</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<style>
    /* Layout tổng kiểu dashboard như screenshot (sidebar trái + nội dung phải) */
    body {
        margin: 0;
        padding: 0;
        background: #f5f7fb;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .waiter-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 240px;
        height: 100vh;
        background: #111827;
        color: #e5e7eb;
        display: flex;
        flex-direction: column;
        padding: 16px 14px;
        box-shadow: 4px 0 18px rgba(15, 23, 42, 0.35);
        z-index: 9999;
    }

    .waiter-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        font-size: 18px;
        color: #f9fafb;
        padding: 4px 6px;
    }

    .waiter-brand span {
        letter-spacing: 0.03em;
    }

    .waiter-menu {
        margin-top: 32px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .waiter-menu-section-title {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #6b7280;
        margin: 8px 4px 4px;
    }

    .waiter-menu-item {
        transition: all 0.25s ease;
        padding: 9px 12px;
        border-radius: 10px;
        color: #e5e7eb;
        text-decoration: none;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .waiter-menu-item i {
        font-size: 15px;
    }

    .waiter-menu-item.active {
        background: #facc15;
        color: #111827 !important;
        font-weight: 600;
        box-shadow: 0 6px 14px rgba(234, 179, 8, 0.45);
    }

    .waiter-menu-item:hover {
        background-color: rgba(249, 250, 251, 0.08);
        color: #f9fafb;
    }

    .waiter-footer {
        margin-top: auto;
        padding-top: 16px;
        border-top: 1px solid rgba(148, 163, 184, 0.5);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        font-size: 13px;
    }

    .waiter-main {
        margin-left: 260px;
        padding: 20px 24px;
        min-height: 100vh;
    }
</style>
<body>
    <div class="waiter-sidebar">
        <div class="waiter-brand">
            <i class="fa-solid fa-utensils"></i>
            <span>Sapa Restaurant</span>
        </div>

        <div class="waiter-menu">
            <span class="waiter-menu-section-title">Waiter</span>

            <!-- Orders = Tiến độ phục vụ -->
            <a href="/WaiterOrderTracking/Index"
               class="waiter-menu-item @(currentController == "WaiterOrderTracking" ? "active" : "")">
                <i class="fa-solid fa-clipboard-check"></i>
                <span>Tiến độ phục vụ</span>
            </a>

            <!-- Table = Dashboard bàn -->
            <a href="/DashboardTable/Index"
               class="waiter-menu-item @(currentController == "DashboardTable" && currentAction == "Index" ? "active" : "")">
                <i class="fa-solid fa-border-all"></i>
                <span>Sơ đồ bàn</span>
            </a>

            <!-- Assistance -->
            <a href="/OrderTable/AssistanceList"
               class="waiter-menu-item @(currentController == "OrderTable" && currentAction == "AssistanceList" ? "active" : "")">
                <i class="fa-solid fa-hand-holding-heart"></i>
                <span>Hỗ trợ</span>
            </a>
        </div>

        <div class="waiter-footer">
            <span>Waiter</span>
            <form id="waiterLogoutForm" asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-light">
                    <i class="fa-solid fa-right-from-bracket me-1"></i> Thoát
                </button>
            </form>
        </div>
    </div>

    <div class="waiter-main">
        @RenderBody()
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>


