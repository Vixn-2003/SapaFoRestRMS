@{
    ViewData["Title"] = "Quản lý Nhân viên";
    Layout = "~/Views/Shared/_LayoutManager.cshtml";
}

<!-- Page Header -->
<div class="page-header">
    <div class="row align-items-center">
        <div class="col">
            <h3 class="page-title">Quản lý Nhân viên</h3>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active">Quản lý Nhân viên</li>
            </ul>
        </div>
        <div class="col-auto">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Thêm nhân viên mới
            </a>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>Tìm kiếm</label>
                    <input type="text" id="searchKeyword" class="form-control" placeholder="Tên, số điện thoại, email...">
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>Chức vụ</label>
                    <input type="text" id="positionFilter" class="form-control" placeholder="Chức vụ...">
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>Trạng thái</label>
                    <select id="statusFilter" class="form-control">
                        <option value="">Tất cả</option>
                        <option value="1">Đang hoạt động</option>
                        <option value="0">Ngừng hoạt động</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>Sắp xếp theo</label>
                    <select id="sortBy" class="form-control">
                        <option value="HireDate">Ngày vào làm</option>
                        <option value="Name">Tên</option>
                        <option value="BaseSalary">Lương</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>Thứ tự</label>
                    <select id="sortDirection" class="form-control">
                        <option value="desc">Giảm dần</option>
                        <option value="asc">Tăng dần</option>
                    </select>
                </div>
            </div>
            <div class="col-md-1">
                <div class="form-group">
                    <label>&nbsp;</label>
                    <button type="button" class="btn btn-primary btn-block" onclick="filterStaff()">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Staff Table -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-center mb-0">
                <thead>
                    <tr>
                        <th>Ảnh đại diện</th>
                        <th>Tên</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Chức vụ</th>
                        <th>Lương cơ bản</th>
                        <th>Trạng thái</th>
                        <th>Ngày vào làm</th>
                        <th class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="staffTableBody">
                    <tr>
                        <td colspan="9" class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="sr-only">Đang tải...</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="row mt-3">
            <div class="col-md-6">
                <div class="dataTables_info" id="staffTableInfo">
                    Hiển thị 0 đến 0 trong tổng số 0 bản ghi
                </div>
            </div>
            <div class="col-md-6">
                <div class="dataTables_paginate paging_simple_numbers float-right">
                    <ul class="pagination" id="staffPagination">
                        <!-- Pagination will be generated by JavaScript -->
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Deactivate Modal -->
<div class="modal fade" id="deactivateModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ngừng hoạt động nhân viên</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn ngừng hoạt động nhân viên này?</p>
                <p><strong>Tên:</strong> <span id="deactivateStaffName"></span></p>
                <div class="form-group">
                    <label for="deactivateReason">Lý do (tùy chọn)</label>
                    <textarea id="deactivateReason" class="form-control" rows="3" placeholder="Nhập lý do ngừng hoạt động..."></textarea>
                </div>
                <input type="hidden" id="deactivateStaffId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="submitDeactivate()">Ngừng hoạt động</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/staff-management.js"></script>
    <script>
        // Initialize on page load
        $(document).ready(function() {
            loadStaffList();
        });

        // Show success/error messages from TempData
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            toastr.success('@TempData["SuccessMessage"]');
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            toastr.error('@TempData["ErrorMessage"]');
            </text>
        }
    </script>
}

