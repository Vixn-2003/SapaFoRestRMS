@model WebSapaForestForStaff.DTOs.ManagementCombo.ComboDetailDto

<div id="viewForm" class="row">
    <div class="col-lg-12 mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <h2 id="formTitle" class="text-2xl font-bold text-gray-800">Chỉnh sửa Combo</h2>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="mdi mdi-close"></i> Hủy
            </a>
        </div>
    </div>

    <!-- Form Info -->
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-4">Thông tin Combo</h5>
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="ComboId" />

                    <div class="mb-3">
                        <label class="form-label">Tên Combo</label>
                        <input asp-for="Name" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tổng tiền các món (VNĐ)</label>
                        <input asp-for="OriginalPrice" type="number" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Giá bán thực tế (VNĐ)</label>
                        <input asp-for="SellingPrice" type="number" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tiết kiệm được (VNĐ)</label>
                        <input value="@Model.SavingsAmount.ToString("N0")" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hình ảnh</label>
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" alt="Combo Image" style="max-height: 100px;" />
                            }
                            <input asp-for="ImageUrl" class="form-control" placeholder="Nhập URL ảnh hoặc tải lên" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Món ăn trong Combo (@Model.Items.Count)</label>
                        <div id="selectedDishes" class="border rounded p-3" style="min-height: 300px; max-height: 400px; overflow-y: auto;">
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <input type="hidden" asp-for="Items[@i].MenuItemId" />
                                    <span>@Model.Items[i].Name</span>
                                    <input asp-for="Items[@i].Quantity" type="number" class="form-control" style="width: 80px;" />
                                    <span class="ms-2">@Model.Items[i].Price.ToString("N0") đ</span>
                                </div>
                            }
                        </div>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 py-2">
                        <i class="mdi mdi-check"></i> Lưu Combo
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Top Dishes và Low Dishes -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-4">Món Ăn Nổi Bật</h5>
                <div class="mb-4">
                    <h6 class="text-success mb-2 d-flex align-items-center gap-2">
                        <i class="mdi mdi-trending-up"></i> Top món được gọi nhiều
                    </h6>
                    <div id="topDishes" class="d-flex flex-column gap-2" style="max-height: 400px; overflow-y: auto;"></div>
                </div>
                <div>
                    <h6 class="text-danger mb-2 d-flex align-items-center gap-2">
                        <i class="mdi mdi-trending-down"></i> Món gọi ít tuần qua
                    </h6>
                    <div id="lowDishes" class="d-flex flex-column gap-2" style="max-height: 400px; overflow-y: auto;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- All Dishes -->
    <div class="col-lg-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-4">Tất cả Món Ăn</h5>
                <div class="mb-3">
                    <div class="position-relative">
                        <i class="mdi mdi-magnify position-absolute" style="left: 12px; top: 50%; transform: translateY(-50%); color: #6c757d;"></i>
                        <input type="text" id="searchDish" class="form-control ps-5" placeholder="Tìm món ăn...">
                    </div>
                </div>
                <div id="allDishes" class="d-flex flex-column gap-2" style="max-height: 700px; overflow-y: auto;"></div>
            </div>
        </div>
    </div>
</div>
