    <!-- Main Table -->
    <div class="export-mgmt__table-section">
        <h2 class="export-mgmt__section-header">Chi tiết đơn xuất (@viewModel.TotalTransactions giao dịch)</h2>

        @if (viewModel.ExportData != null && viewModel.ExportData.Any())
        {
            <div class="export-mgmt__table-wrapper">
                <table class="export-mgmt__table" id="exportTable">
                    <thead>
                        <tr>
                            <th>Mặt hàng</th>
                            <th>Số lượng</th>
                            <th>Thời gian</th>
                            <th>Kho</th>
                            <th>Lô hàng</th>
                            <th>Ghi chú</th>
                            <th>Trạng thái</th>
                            <th style="text-align: right;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in viewModel.ExportData.OrderByDescending(x => x.TransactionDate))
                        {
                            <tr data-ingredient-id="@item.IngredientId"
                                data-warehouse-id="@item.WarehouseId"
                                data-date="@item.TransactionDate?.ToString("yyyy-MM-dd")">
                                <td>
                                    <div class="export-mgmt__ingredient-info">
                                        <strong class="export-mgmt__ingredient-name">@item.IngredientName</strong>
                                        <small class="export-mgmt__ingredient-meta">@item.IngredientCode </small>
                                    </div>
                                </td>
                                <td>
                                    <span class="export-mgmt__quantity-badge">-@item.Quantity @item.UnitName</span>
                                </td>
                                <td>
                                    @if (item.TransactionDate.HasValue)
                                    {
                                        @item.TransactionDate.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="export-mgmt__text-muted">Chưa có</span>
                                    }
                                </td>
                                <td>@item.WarehouseName</td>
                                <td>
                                    <span class="export-mgmt__batch-badge">
                                        @if (!string.IsNullOrEmpty(item.PurchaseOrderId))
                                        {
                                            @item.PurchaseOrderId
                                        }
                                        else
                                        {
                                            <span>#LOT-@item.BatchId</span>
                                        }
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Note))
                                    {
                                        @item.Note
                                    }
                                    else
                                    {
                                        <span class="export-mgmt__text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var statusClass = item.StatusExport switch
                                        {
                                            "Delivered" => "export-mgmt__badge--success",
                                            "Received" => "export-mgmt__badge--success",
                                            "Missing" => "export-mgmt__badge--danger",
                                            "Cancelled" => "export-mgmt__badge--cancelled",
                                            _ => "export-mgmt__badge--warning"
                                        };

                                        var statusText = item.StatusExport switch
                                        {
                                            "Delivered" => "Đã giao",
                                            "Received" => "Đã nhận",
                                            "Missing" => "Thiếu",
                                            "Cancelled" => "Từ chối",
                                            "Requested" => "Đang yêu cầu",
                                            _ => "Đang xử lý"
                                        };
                                    }
                                    <span class="export-mgmt__badge @statusClass" id="status-@item.TransactionId">
