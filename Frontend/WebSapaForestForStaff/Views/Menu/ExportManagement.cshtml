                <span class="export-mgmt__stat-label">Tổng xuất hôm nay</span>
                <span class="export-mgmt__stat-value" id="todayExport">0</span>
                <span class="export-mgmt__stat-status" id="todayCompare">Đang tải...</span>
            </div>
        </div>

        <div class="export-mgmt__stat-card export-mgmt__stat-card--orange">
            <div class="export-mgmt__stat-content">
                <span class="export-mgmt__stat-label">Tổng xuất 7 ngày qua</span>
                <span class="export-mgmt__stat-value" id="week7Export">0</span>
                <span class="export-mgmt__stat-status" id="week7Compare">Đang tải...</span>
            </div>
        </div>

        <div class="export-mgmt__stat-card export-mgmt__stat-card--green">
            <div class="export-mgmt__stat-content">
