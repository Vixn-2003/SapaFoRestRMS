    <script>
        const exportData = @Html.Raw(Json.Serialize(viewModel.ExportData));

<!-- Modal Confirmation -->
<div class="export-mgmt__modal-overlay" id="confirmModal">
    <div class="export-mgmt__modal">
        <div class="export-mgmt__modal-header">
            <div class="export-mgmt__modal-icon" id="modalIcon">
                ✓
            </div>
            <h3 class="export-mgmt__modal-title" id="modalTitle">Xác nhận</h3>
        </div>
        <div class="export-mgmt__modal-body" id="modalBody">
            Bạn có chắc chắn muốn thực hiện hành động này?
        </div>
        <div class="export-mgmt__modal-actions">
            <button class="export-mgmt__modal-btn export-mgmt__modal-btn--cancel" onclick="closeModal()">
                Hủy
            </button>
            <button class="export-mgmt__modal-btn export-mgmt__modal-btn--confirm" id="modalConfirmBtn">
                Xác nhận
            </button>
        </div>
    </div>
</div>

<script>
    const exportData = @Html.Raw(Json.Serialize(Model.ExportData));

    // Tạo mảng receivedExports có thể thay đổi được
    let receivedExports = exportData.filter(x => x.statusExport === "Received");

    // ==================== TOAST NOTIFICATION SYSTEM ====================
    function showToast(message, type = 'info', duration = 3000) {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = `export-mgmt__toast export-mgmt__toast--${type}`;

        const icons = {
            success: '✓',
            error: '✕',
            info: 'ℹ',
            warning: '⚠'
        };

        const titles = {
            success: 'Thành công',
            error: 'Lỗi',
            info: 'Thông báo',
            warning: 'Cảnh báo'
        };

        toast.innerHTML = `
                <div class="export-mgmt__toast-icon">${icons[type]}</div>
                <div class="export-mgmt__toast-content">
                    <div class="export-mgmt__toast-title">${titles[type]}</div>
                    <div class="export-mgmt__toast-message">${message}</div>
                </div>
                <button class="export-mgmt__toast-close" onclick="this.parentElement.remove()">×</button>
            `;

        container.appendChild(toast);

        // Auto remove
        setTimeout(() => {
            toast.classList.add('removing');
            setTimeout(() => toast.remove(), 300);
        }, duration);
    }

    // ==================== MODAL CONFIRMATION SYSTEM ====================
    let modalCallback = null;

    function showConfirmModal(title, message, type = 'success', onConfirm) {
        const modal = document.getElementById('confirmModal');
        const modalIcon = document.getElementById('modalIcon');
        const modalTitle = document.getElementById('modalTitle');
        const modalBody = document.getElementById('modalBody');
        const confirmBtn = document.getElementById('modalConfirmBtn');

        // Set content
        modalTitle.textContent = title;
        modalBody.textContent = message;

        // Set icon style
        modalIcon.className = `export-mgmt__modal-icon export-mgmt__modal-icon--${type}`;
        modalIcon.textContent = type === 'success' ? '✓' : '⚠';

        // Set button style
        confirmBtn.className = `export-mgmt__modal-btn export-mgmt__modal-btn--${type === 'danger' ? 'danger' : 'confirm'}`;
        confirmBtn.textContent = type === 'danger' ? 'Xác nhận' : 'Xác nhận';

        // Store callback
        modalCallback = onConfirm;

        // Show modal
        modal.classList.add('active');
    }

    function closeModal() {
        const modal = document.getElementById('confirmModal');
        modal.classList.remove('active');
        modalCallback = null;
    }

    function confirmModal() {
        if (modalCallback) {
            modalCallback();
        }
        closeModal();
    }

    // Attach confirm to button
    document.getElementById('modalConfirmBtn').onclick = confirmModal;

    // Close on overlay click
    document.getElementById('confirmModal').addEventListener('click', function (e) {
        if (e.target === this) {
            closeModal();
        }
    });

    // ==================== TAB MANAGEMENT ====================
    let currentExportTab = 'all';

    function switchExportTab(tab) {
        currentExportTab = tab;

        // Update tab UI
        document.querySelectorAll('.export-mgmt__export-tab').forEach(btn => {
            btn.classList.remove('active');
        });
        event.target.closest('.export-mgmt__export-tab').classList.add('active');

        // Filter table
        filterTable();
    }

    // ==================== FILTER TABLE ====================
    function filterTable() {
        const searchText = document.getElementById('searchInput').value.toLowerCase();
        const dateFilter = document.getElementById('dateFilter').value;
        const warehouseId = document.getElementById('warehouseFilter').value;

        const rows = document.querySelectorAll('#exportTable tbody tr');
        let visibleCount = 0;

        rows.forEach(row => {
            let show = true;

            // TAB FILTER - LỌC THEO TRẠNG THÁI
            if (currentExportTab !== 'all') {
                const statusBadge = row.querySelector('.export-mgmt__badge');

                if (statusBadge) {
                    const transactionId = parseInt(statusBadge.id.replace('status-', ''));
                    const rowData = exportData.find(x => x.transactionId === transactionId);

                    if (rowData) {
                        const status = rowData.statusExport;

                        switch (currentExportTab) {
                            case 'requested':
                                show = show && status === 'Requested';
                                break;
                            case 'delivered':
                                show = show && status === 'Delivered';
                                break;
                            case 'received':
                                show = show && status === 'Received';
                                break;
                            case 'missing':
                                show = show && status === 'Missing';
                                break;
                            case 'cancelled':
                                show = show && status === 'Cancelled';
                                break;
                        }
                    }
                }
            }

            // SEARCH - TÌM KIẾM
            if (searchText && show) {
                const ingredientName = row.querySelector('.export-mgmt__ingredient-name')?.textContent.toLowerCase() || '';
                const ingredientCode = row.querySelector('.export-mgmt__ingredient-meta')?.textContent.toLowerCase() || '';
                const batchInfo = row.querySelector('.export-mgmt__batch-badge')?.textContent.toLowerCase() || '';

                const matchName = ingredientName.includes(searchText);
                const matchCode = ingredientCode.includes(searchText);
                const matchBatch = batchInfo.includes(searchText);

                show = show && (matchName || matchCode || matchBatch);
            }

            // DATE FILTER
            if (dateFilter !== 'all' && show) {
                const rowDate = new Date(row.dataset.date);
                const now = new Date();
                const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

                switch (dateFilter) {
                    case 'today':
                        show = show && rowDate >= today;
                        break;
                    case 'yesterday':
                        const yesterday = new Date(today);
                        yesterday.setDate(yesterday.getDate() - 1);
                        show = show && rowDate >= yesterday && rowDate < today;
                        break;
                    case '7days':
                        const sevenDays = new Date(today);
                        sevenDays.setDate(sevenDays.getDate() - 7);
                        show = show && rowDate >= sevenDays;
                        break;
                    case '30days':
                        const thirtyDays = new Date(today);
                        thirtyDays.setDate(thirtyDays.getDate() - 30);
                        show = show && rowDate >= thirtyDays;
                        break;
                }
            }

            // WAREHOUSE FILTER
            if (warehouseId && show) {
                show = show && row.dataset.warehouseId === warehouseId;
            }

            row.style.display = show ? '' : 'none';
            if (show) visibleCount++;
        });

        // Update count display
        document.getElementById('tableCountDisplay').textContent = `${visibleCount} giao dịch`;
    }

    // ==================== TAB COUNTS ====================
    function updateTabCounts() {
        const counts = {
            all: exportData.length,
            requested: exportData.filter(x => x.statusExport === 'Requested').length,
            delivered: exportData.filter(x => x.statusExport === 'Delivered').length,
            received: exportData.filter(x => x.statusExport === 'Received').length,
            missing: exportData.filter(x => x.statusExport === 'Missing').length,
            cancelled: exportData.filter(x => x.statusExport === 'Cancelled').length
        };

        document.getElementById('count-all').textContent = counts.all;
        document.getElementById('count-requested').textContent = counts.requested;
        document.getElementById('count-delivered').textContent = counts.delivered;
        document.getElementById('count-received').textContent = counts.received;
        document.getElementById('count-missing').textContent = counts.missing;
        document.getElementById('count-cancelled').textContent = counts.cancelled;
    }

    // ==================== UPDATE EXPORT STATUS ====================
    async function updateExportStatus(transactionId, newStatus) {
        const isDelivered = newStatus === 'Delivered';

        showConfirmModal(
            isDelivered ? 'Xác nhận giao hàng' : 'Xác nhận báo thiếu',
            isDelivered
                ? `Bạn có chắc chắn muốn xác nhận đã giao hàng cho đơn xuất này?`
                : `Bạn có chắc chắn muốn báo thiếu hàng cho đơn xuất này?`,
            isDelivered ? 'success' : 'danger',
            async () => {
                const actionsDiv = document.getElementById(`actions-${transactionId}`);
                const buttons = actionsDiv.querySelectorAll('button');
                buttons.forEach(btn => btn.disabled = true);

                try {
                    const formData = new FormData();
                    formData.append('transactionId', transactionId);
                    formData.append('status', newStatus);

                    const response = await fetch('/ExportManagement/UpdateExportStatus', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        showToast(result.message, 'success');
                        updateStatusUI(transactionId, newStatus);

                        // Cập nhật dữ liệu
                        const exportItem = exportData.find(x => x.transactionId === transactionId);
                        if (exportItem) {
                            exportItem.statusExport = newStatus;
                        }

                        // Cập nhật receivedExports
                        receivedExports = exportData.filter(x => x.statusExport === "Received");

                        // Tính lại thống kê
                        calculateStats();
                    } else {
                        showToast(result.message || 'Không thể cập nhật trạng thái', 'error');
                        buttons.forEach(btn => btn.disabled = false);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showToast('Lỗi kết nối: ' + error.message, 'error');
                    buttons.forEach(btn => btn.disabled = false);
                }
            }
        );
    }

    function updateStatusUI(transactionId, newStatus) {
        const statusBadge = document.getElementById(`status-${transactionId}`);
        const actionsDiv = document.getElementById(`actions-${transactionId}`);

        if (statusBadge) {
            statusBadge.className = 'export-mgmt__badge';

            switch (newStatus) {
                case 'Delivered':
                    statusBadge.classList.add('export-mgmt__badge--success');
                    statusBadge.textContent = 'Đã giao';
                    break;
                case 'Missing':
                    statusBadge.classList.add('export-mgmt__badge--danger');
                    statusBadge.textContent = 'Thiếu';
                    break;
                case 'Received':
                    statusBadge.classList.add('export-mgmt__badge--success');
                    statusBadge.textContent = 'Đã nhận';
                    break;
                case 'Cancelled':
                    statusBadge.classList.add('export-mgmt__badge--cancelled');
                    statusBadge.textContent = 'Từ chối';
                    break;
            }
        }

        if (actionsDiv) {
            actionsDiv.innerHTML = '<span class="export-mgmt__text-muted">Đã xử lý</span>';
        }

        // Cập nhật lại tab counts và filter
        updateTabCounts();
        filterTable();
    }

    // ==================== STATISTICS CALCULATIONS ====================
    function calculateStats() {
        const now = new Date();
        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const yesterday = new Date(today);
        yesterday.setDate(yesterday.getDate() - 1);
        const sevenDaysAgo = new Date(today);
        sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
        const fourteenDaysAgo = new Date(today);
        fourteenDaysAgo.setDate(fourteenDaysAgo.getDate() - 14);
        const thirtyDaysAgo = new Date(today);
        thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
        const sixtyDaysAgo = new Date(today);
        sixtyDaysAgo.setDate(sixtyDaysAgo.getDate() - 60);

        // Xuất hôm nay
        const todayExports = receivedExports.filter(x => {
            const transDate = new Date(x.transactionDate);
            return transDate >= today;
        });
        const todayTotal = todayExports.reduce((sum, x) => sum + x.quantity, 0);

        // Xuất hôm qua
        const yesterdayExports = receivedExports.filter(x => {
            const transDate = new Date(x.transactionDate);
            return transDate >= yesterday && transDate < today;
        });
        const yesterdayTotal = yesterdayExports.reduce((sum, x) => sum + x.quantity, 0);

        const todayPercent = yesterdayTotal > 0 ? ((todayTotal / yesterdayTotal - 1) * 100).toFixed(0) : 0;
        const todayArrow = todayPercent > 0 ? '↑' : todayPercent < 0 ? '↓' : '→';
        const todayColor = todayPercent > 0 ? '#ef4444' : todayPercent < 0 ? '#22c55e' : '#6b7280';

        document.getElementById('todayExport').textContent = `${todayTotal.toFixed(2)} đơn vị`;
        document.getElementById('todayCompare').innerHTML = `<span style="color: ${todayColor}">${todayArrow} ${Math.abs(todayPercent)}% vs hôm qua</span>`;

        // Xuất 7 ngày
        const week7Exports = receivedExports.filter(x => {
            const transDate = new Date(x.transactionDate);
            return transDate >= sevenDaysAgo;
        });
        const week7Total = week7Exports.reduce((sum, x) => sum + x.quantity, 0);

        const prevWeek7Exports = receivedExports.filter(x => {
            const transDate = new Date(x.transactionDate);
            return transDate >= fourteenDaysAgo && transDate < sevenDaysAgo;
        });
        const prevWeek7Total = prevWeek7Exports.reduce((sum, x) => sum + x.quantity, 0);

        const week7Percent = prevWeek7Total > 0 ? ((week7Total / prevWeek7Total - 1) * 100).toFixed(0) : 0;
        const week7Arrow = week7Percent > 0 ? '↑' : week7Percent < 0 ? '↓' : '→';
        const week7Color = week7Percent > 0 ? '#ef4444' : week7Percent < 0 ? '#22c55e' : '#6b7280';

        document.getElementById('week7Export').textContent = `${week7Total.toFixed(2)} đơn vị`;
        document.getElementById('week7Compare').innerHTML = `<span style="color: ${week7Color}">${week7Arrow} ${Math.abs(week7Percent)}% vs 7 ngày trước</span>`;

        // Xuất 30 ngày
        const month30Exports = receivedExports.filter(x => {
            const transDate = new Date(x.transactionDate);
            return transDate >= thirtyDaysAgo;
        });
        const month30Total = month30Exports.reduce((sum, x) => sum + x.quantity, 0);

        const prevMonth30Exports = receivedExports.filter(x => {
            const transDate = new Date(x.transactionDate);
            return transDate >= sixtyDaysAgo && transDate < thirtyDaysAgo;
        });
        const prevMonth30Total = prevMonth30Exports.reduce((sum, x) => sum + x.quantity, 0);

        const month30Percent = prevMonth30Total > 0 ? ((month30Total / prevMonth30Total - 1) * 100).toFixed(0) : 0;
        const month30Arrow = month30Percent > 0 ? '↑' : month30Percent < 0 ? '↓' : '→';
        const month30Color = month30Percent > 0 ? '#ef4444' : month30Percent < 0 ? '#22c55e' : '#6b7280';

        document.getElementById('month30Export').textContent = `${month30Total.toFixed(2)} đơn vị`;
        document.getElementById('month30Compare').innerHTML = `<span style="color: ${month30Color}">${month30Arrow} ${Math.abs(month30Percent)}% vs 30 ngày trước</span>`;

        calculateAbnormalExports(todayExports, week7Exports);
        calculateTopIngredients(todayExports);
        calculateWarehouseStats(todayExports);
        calculateComparison();
    }

    // Phát hiện xuất bất thường
    function calculateAbnormalExports(todayExports, week7Exports) {
        const avgByIngredient = {};

        // Tính trung bình 7 ngày
        week7Exports.forEach(x => {
            if (!avgByIngredient[x.ingredientId]) {
                avgByIngredient[x.ingredientId] = { total: 0, count: 0, name: x.ingredientName };
            }
            avgByIngredient[x.ingredientId].total += x.quantity;
            avgByIngredient[x.ingredientId].count++;
        });

        // Tìm xuất bất thường (> 150% trung bình)
        const abnormal = [];
        todayExports.forEach(x => {
            const avg = avgByIngredient[x.ingredientId];
            if (avg && avg.count > 0) {
                const avgQty = avg.total / avg.count;
                if (x.quantity > avgQty * 1.5) {
                    abnormal.push({
                        name: x.ingredientName,
                        today: x.quantity,
                        avg: avgQty,
                        percent: ((x.quantity / avgQty - 1) * 100).toFixed(0)
                    });
                }
            }
        });

        document.getElementById('abnormalExport').textContent = `${abnormal.length} loại`;

        if (abnormal.length > 0) {
            const html = abnormal.map(a =>
                `<div class="export-mgmt__alert-item">
                        <div class="export-mgmt__alert-item-left">
                            <div class="export-mgmt__alert-item-name">${a.name}</div>
                            <div class="export-mgmt__alert-item-detail">Hôm nay: ${a.today.toFixed(2)} | TB 7 ngày: ${a.avg.toFixed(2)}</div>
                        </div>
                        <span class="export-mgmt__badge export-mgmt__badge--danger">+${a.percent}%</span>
                    </div>`
            ).join('');
            document.getElementById('abnormalAlerts').innerHTML = html;
        } else {
            document.getElementById('abnormalAlerts').innerHTML = `
                    <div class="export-mgmt__empty" style="padding: 2rem;">
                        <div class="export-mgmt__empty-icon">📊</div>
                        <div style="color: #6b7280; font-size: 0.875rem;">Không có dữ liệu xuất bất thường</div>
                    </div>`;
        }
    }

    // Top Mặt hàng xuất hôm nay
    function calculateTopIngredients(todayExports) {
        const byIngredient = {};

        todayExports.forEach(x => {
            if (!byIngredient[x.ingredientId]) {
                byIngredient[x.ingredientId] = { name: x.ingredientName, total: 0, unit: x.unitName };
            }
            byIngredient[x.ingredientId].total += x.quantity;
        });

        const top = Object.values(byIngredient)
            .sort((a, b) => b.total - a.total)
            .slice(0, 5);

        if (top.length > 0) {
            const html = top.map((item, idx) =>
                `<div class="export-mgmt__top-item">
                        <div class="export-mgmt__top-item-name">${idx + 1}. ${item.name}</div>
                        <div class="export-mgmt__top-item-value">${item.total.toFixed(2)} ${item.unit}</div>
                    </div>`
            ).join('');
            document.getElementById('topIngredients').innerHTML = html;
        } else {
            document.getElementById('topIngredients').innerHTML = `
                    <div class="export-mgmt__empty" style="padding: 2rem;">
                        <div class="export-mgmt__empty-icon">🏆</div>
                        <div style="color: #6b7280; font-size: 0.875rem;">Chưa có dữ liệu hôm nay</div>
                    </div>`;
        }
    }

    // Xuất theo kho hôm nay
    function calculateWarehouseStats(todayExports) {
        const byWarehouse = {};

        todayExports.forEach(x => {
            if (!byWarehouse[x.warehouseId]) {
                byWarehouse[x.warehouseId] = { name: x.warehouseName, count: 0 };
            }
            byWarehouse[x.warehouseId].count++;
        });

        const stats = Object.values(byWarehouse);

        if (stats.length > 0) {
            const html = stats.map(s =>
                `<div class="export-mgmt__warehouse-stat">
                        <div class="export-mgmt__warehouse-name">${s.name}</div>
                        <div class="export-mgmt__warehouse-count">${s.count} giao dịch</div>
                    </div>`
            ).join('');
            document.getElementById('warehouseStats').innerHTML = html;
        } else {
            document.getElementById('warehouseStats').innerHTML = `
                    <div class="export-mgmt__empty" style="padding: 2rem;">
                        <div class="export-mgmt__empty-icon">🏢</div>
                        <div style="color: #6b7280; font-size: 0.875rem;">Chưa có dữ liệu hôm nay</div>
                    </div>`;
        }
    }

    // So sánh tiêu hao
    function calculateComparison() {
        const now = new Date();
        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const sevenDaysAgo = new Date(today);
        sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);

        const todayExports = receivedExports.filter(x => new Date(x.transactionDate) >= today);
        const week7Exports = receivedExports.filter(x => new Date(x.transactionDate) >= sevenDaysAgo);

        const comparison = {};

        // Hôm nay
        todayExports.forEach(x => {
            if (!comparison[x.ingredientId]) {
                comparison[x.ingredientId] = { name: x.ingredientName, today: 0, week: 0, unit: x.unitName };
            }
            comparison[x.ingredientId].today += x.quantity;
        });

        // 7 ngày
        week7Exports.forEach(x => {
            if (!comparison[x.ingredientId]) {
                comparison[x.ingredientId] = { name: x.ingredientName, today: 0, week: 0, unit: x.unitName };
            }
            comparison[x.ingredientId].week += x.quantity;
        });

        const rows = Object.values(comparison).map(c => {
            const avg7 = c.week / 7;
            const percent = avg7 > 0 ? ((c.today / avg7 - 1) * 100).toFixed(0) : 0;
            const arrow = percent > 0 ? '⬆️' : percent < 0 ? '⬇️' : '➡️';
            const colorClass = percent > 20 ? 'export-mgmt__trend-up' : percent < -20 ? 'export-mgmt__trend-down' : '';

            return `<tr>
                            <td>${c.name}</td>
                            <td>${c.today.toFixed(2)} ${c.unit}</td>
                            <td>${avg7.toFixed(2)} ${c.unit}</td>
                            <td class="${colorClass}">${arrow} ${percent}%</td>
                        </tr>`;
        });

        document.querySelector('#comparisonTable tbody').innerHTML = rows.length > 0 ? rows.join('') :
            `<tr><td colspan="4" style="text-align: center; padding: 2rem;">
                    <div class="export-mgmt__empty-icon">📊</div>
                    <div style="color: #6b7280; font-size: 0.875rem;">Không có dữ liệu so sánh</div>
                </td></tr>`;
    }

    // Filter comparison table
    document.getElementById('comparisonSearch').addEventListener('input', function () {
        const searchText = this.value.toLowerCase();
        const rows = document.querySelectorAll('#comparisonTable tbody tr');

        let hasVisibleRow = false;
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            const shouldShow = text.includes(searchText);
            row.style.display = shouldShow ? '' : 'none';
            if (shouldShow) hasVisibleRow = true;
        });

        // Hiển thị "Không tìm thấy" nếu không có kết quả
        if (!hasVisibleRow && rows.length > 0) {
            const emptyRow = document.createElement('tr');
            emptyRow.id = 'no-comparison-result';
            emptyRow.innerHTML = `<td colspan="4" style="text-align: center; padding: 2rem; color: #6b7280;">
                    Không tìm thấy Mặt hàng "${searchText}"
                </td>`;

            const oldEmpty = document.getElementById('no-comparison-result');
            if (oldEmpty) oldEmpty.remove();

            document.querySelector('#comparisonTable tbody').appendChild(emptyRow);
        } else {
            const oldEmpty = document.getElementById('no-comparison-result');
            if (oldEmpty) oldEmpty.remove();
        }
    });

    // ==================== KHỞI TẠO ====================
    document.addEventListener('DOMContentLoaded', function () {
        updateTabCounts();
        calculateStats();

        // Gắn filter listeners
        document.getElementById('searchInput').addEventListener('input', filterTable);
        document.getElementById('dateFilter').addEventListener('change', filterTable);
        document.getElementById('warehouseFilter').addEventListener('change', filterTable);
    });
</script>

