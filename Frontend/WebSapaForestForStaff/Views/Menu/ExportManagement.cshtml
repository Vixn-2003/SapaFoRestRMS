                                            <button class="export-mgmt__btn export-mgmt__btn--danger"
                                                    onclick="updateExportStatus(@item.TransactionId, 'Missing')">
                                                Báo thiếu
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="export-mgmt__text-muted">Đã xử lý</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
