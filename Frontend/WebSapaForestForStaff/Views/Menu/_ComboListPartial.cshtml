@model WebSapaForestForStaff.DTOs.ManagementCombo.PagedResult<WebSapaForestForStaff.DTOs.ManagementCombo.ComboDisplayDto>

<div id="comboList" class="d-flex flex-column gap-3">
    @if (Model?.Items != null && Model.Items.Any())
    {
        @foreach (var combo in Model.Items)
        {
            <div class="card combo-card hover-shadow  border-2 border-warning cursor-pointer" style="border-color: #dc2626;" onclick="selectCombo(@combo.ComboId)">
                <div class="card-body d-flex gap-3">
                    <div style="font-size: 4rem;">
                        <img src="@combo.ImageUrl" style="width:80px;height:80px; object-fit: cover; border-radius: 8px;" />
                    </div>
                    <div class="flex-fill">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0" style="color:red">@combo.ComboName</h4>
                            <div class="d-flex align-items-center gap-2">
                                <span class="h5 text-warning mb-0">@combo.Price.ToString("N0") đ</span>
                                <button class="btn btn-sm btn-outline-primary" onclick="editCombo(@combo.ComboId)">
                                    <i class="mdi mdi-pencil"></i>
                                </button>
                            </div>
                        </div>
                        <h7 style="font-size:12px">Các món có trong combo: </h7>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                            @foreach (var dish in combo.MenuItems ?? Enumerable.Empty<string>())
                            {
                                <span class="badge bg-warning">@dish</span>
                            }
                        </div>
                        <div class="d-flex gap-3 mt-2">
                            <small class="text-muted"><strong>@combo.WeeklyUsed</strong> lượt gọi tuần này</small>
                            <small class="text-muted"><strong>@combo.MonthlyUsed</strong> lượt gọi tháng này</small>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted">Chưa có combo nào để hiển thị.</p>
    }

    @if (Model?.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-3">
                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link" href="#" onclick="loadPage(@(Model.PageIndex - 1)); return false;">Previous</a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                        <a class="page-link" href="#" onclick="loadPage(@i); return false;">@i</a>
                    </li>
                }

                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="#" onclick="loadPage(@(Model.PageIndex + 1)); return false;">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
