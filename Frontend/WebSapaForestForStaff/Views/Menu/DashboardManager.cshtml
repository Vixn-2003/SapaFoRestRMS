    // Update performance stats
    function updatePerformanceStats() {
        const filteredItems = getFilteredItems();
        const hotCount = filteredItems.filter(item => getPerformance(item, state.selectedPeriod).status === 'hot').length;
        const normalCount = filteredItems.filter(item => getPerformance(item, state.selectedPeriod).status === 'normal').length;
        const lowCount = filteredItems.filter(item => getPerformance(item, state.selectedPeriod).status === 'low').length;

        document.getElementById('hotCount').textContent = hotCount;
        document.getElementById('normalCount').textContent = normalCount;
        document.getElementById('lowCount').textContent = lowCount;
    }

