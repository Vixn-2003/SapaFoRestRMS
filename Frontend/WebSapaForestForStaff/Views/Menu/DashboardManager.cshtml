    function handleEditMenu(event, itemId) {
        event.stopPropagation();
        const item = menuItems.find(i => i.id === itemId);
        alert(`Chỉnh sửa món: ${item.name}`);
    }

    // ===== MODAL FUNCTIONS =====

    // Open modal
    function openModal(itemId) {
        const item = menuItems.find(i => i.id === itemId);
        if (!item) return;

        state.selectedItem = item;

        // Populate modal content
        document.getElementById('modalItemName').textContent = item.name;
        document.getElementById('modalItemCategory').textContent = item.category;
        document.getElementById('modalItemPrice').textContent = item.price;

        // Render ingredients
        const ingredientsList = document.getElementById('modalIngredientsList');
        ingredientsList.innerHTML = item.ingredients.map(ing => `
            <div class="ingredient-item">
                <div class="ingredient-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <div class="ingredient-details">
                    <div class="ingredient-detail">
                        <span class="ingredient-detail-label">Tên nguyên liệu</span>
                        <span class="ingredient-detail-value">${ing.name}</span>
                    </div>
                    <div class="ingredient-detail">
                        <span class="ingredient-detail-label">Số lượng</span>
                        <span class="ingredient-detail-value">${ing.quantity}</span>
                    </div>
                    <div class="ingredient-detail">
                        <span class="ingredient-detail-label">Đơn vị</span>
                        <span class="ingredient-detail-value">${ing.unit}</span>
                    </div>
                </div>
            </div>
        `).join('');

        // Render history
        const historyList = document.getElementById('modalHistoryList');
        historyList.innerHTML = `
            <div class="history-item today">
                <span class="history-label">Hôm nay</span>
                <span class="history-value">${item.today} phần</span>
            </div>
            <div class="history-item">
                <span class="history-label">Hôm qua</span>
                <span class="history-value">${item.history.yesterday} phần</span>
            </div>
            <div class="history-item">
                <span class="history-label">Trung bình 7 ngày</span>
                <span class="history-value">${item.history.avg7days} phần</span>
            </div>
            <div class="history-item">
                <span class="history-label">Trung bình 1 tháng</span>
                <span class="history-value">${item.history.avg30days} phần</span>
            </div>
            <div class="history-item">
                <span class="history-label">Trung bình 3 tháng</span>
                <span class="history-value">${item.history.avg90days} phần</span>
            </div>
        `;

        // Render performance
        const performanceList = document.getElementById('modalPerformanceList');
        performanceList.innerHTML = periods.map(period => {
            const perf = getPerformance(item, period.value);
            return `
                <div class="performance-item ${perf.status}">
                    <div class="performance-item-left">
                        ${getPerformanceIcon(perf.status)}
                        <span class="performance-item-label">vs ${period.label}</span>
                    </div>
                    <span class="performance-percentage">${perf.percentage}</span>
                        </div>
            `;
        }).join('');

        // Render strategy
        const currentPerf = getPerformance(item, state.selectedPeriod);
        const strategyBox = document.getElementById('modalStrategyBox');

        if (currentPerf.status === 'hot') {
            strategyBox.innerHTML = `
                <div class="strategy-box hot">
                    <p>✓ Món đang bán rất tốt! Đảm bảo đủ nguyên liệu và có thể tăng giá nhẹ để tối ưu lợi nhuận.</p>
                </div>
            `;
        } else if (currentPerf.status === 'low') {
            strategyBox.innerHTML = `
                <div class="strategy-box low">
                    <p>⚠ Món bán chậm hơn bình thường. Xem xét giảm giá, cải tiến món hoặc tăng cường marketing.</p>
                </div>
            `;
        } else {
            strategyBox.innerHTML = `
                <div class="strategy-box normal">
                    <p>ⓘ Món đang bán ổn định. Duy trì chất lượng và theo dõi xu hướng.</p>
                </div>
            `;
        }

        // Show modal
        document.getElementById('menuModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    // Close modal
    function closeModal(event) {
        // If event is passed and target is not the overlay, don't close
        if (event && event.target.classList.contains('menu-modal-content')) {
            return;
        }

        document.getElementById('menuModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
        state.selectedItem = null;
    }

    // Handle escape key to close modal
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeModal();
        }
    });

    // ===== INITIALIZATION =====
    function init() {
        // Render initial data
        renderCategoryStats();
        renderCategoryFilters();
        renderMenuItems();
        updatePerformanceStats();
        renderTopOrdered();
        renderLeastOrdered();

        // Sync period selectors
        document.getElementById('topPeriodSelector').value = state.topPeriod;
        document.getElementById('leastPeriodSelector').value = state.topPeriod;
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    // ===== ADDITIONAL FEATURES =====

    // Export data to CSV (bonus feature)
    function exportToCSV() {
        const filteredItems = getFilteredItems();
        const csvContent = [
            ['Tên món', 'Loại', 'Giá', 'Hôm nay', 'Trung bình', 'Hiệu suất'].join(','),
            ...filteredItems.map(item => {
                const performance = getPerformance(item, state.selectedPeriod);
                const avgValue = state.selectedPeriod === 'yesterday' ? item.history.yesterday :
                    state.selectedPeriod === '7days' ? item.history.avg7days :
                        state.selectedPeriod === '30days' ? item.history.avg30days :
                            item.history.avg90days;

                return [
                    `"${item.name}"`,
                    `"${item.category}"`,
                    `"${item.price}"`,
                    item.today,
                    avgValue,
                    `"${performance.label} (${performance.percentage})"`
                ].join(',');
            })
        ].join('\n');

        const blob = new Blob(['\ufeff' + csvContent], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);

        link.setAttribute('href', url);
        link.setAttribute('download', `menu_report_${new Date().toISOString().split('T')[0]}.csv`);
        link.style.visibility = 'hidden';

        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

