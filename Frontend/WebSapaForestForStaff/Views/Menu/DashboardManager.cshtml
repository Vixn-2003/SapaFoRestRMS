    // ===== EVENT HANDLERS =====

    // Handle search input
    function handleSearch() {
        state.searchTerm = document.getElementById('searchInput').value;
        renderMenuItems();
        updatePerformanceStats();
    }

    // Handle category filter
    function handleCategoryFilter(category) {
        state.selectedCategory = category;
        renderCategoryFilters();
        renderMenuItems();
        updatePerformanceStats();
    }

    // Handle performance filter
    function handlePerformanceFilter(performance) {
        state.selectedPerformance = performance;

        // Update button active states
        document.querySelectorAll('.performance-filter-btn').forEach(btn => {
            btn.classList.remove('active');
        });
        document.querySelector(`.performance-filter-btn[data-filter="${performance}"]`).classList.add('active');

        renderMenuItems();
        updatePerformanceStats();
    }

    // Handle period change
    function handlePeriodChange() {
        state.selectedPeriod = document.getElementById('periodSelector').value;
        renderMenuItems();
        updatePerformanceStats();
    }

    // Handle top period change
    function handleTopPeriodChange() {
        state.topPeriod = document.getElementById('topPeriodSelector').value;
        // Sync both selectors
        document.getElementById('leastPeriodSelector').value = state.topPeriod;
        renderTopOrdered();
        renderLeastOrdered();
    }

