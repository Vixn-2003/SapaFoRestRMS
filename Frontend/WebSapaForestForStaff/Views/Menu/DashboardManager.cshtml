    // Sort items (bonus feature)
    function sortItems(sortBy, order = 'desc') {
        const filteredItems = getFilteredItems();

        const sortedItems = [...filteredItems].sort((a, b) => {
            let aValue, bValue;

            switch (sortBy) {
                case 'name':
                    aValue = a.name.toLowerCase();
                    bValue = b.name.toLowerCase();
                    return order === 'asc' ? aValue.localeCompare(bValue) : bValue.localeCompare(aValue);

                case 'price':
                    aValue = parseInt(a.price.replace(/\D/g, ''));
                    bValue = parseInt(b.price.replace(/\D/g, ''));
                    return order === 'asc' ? aValue - bValue : bValue - aValue;

                case 'today':
                    return order === 'asc' ? a.today - b.today : b.today - a.today;

                case 'performance':
                    const perfA = getPerformance(a, state.selectedPeriod);
                    const perfB = getPerformance(b, state.selectedPeriod);
                    const valueA = parseFloat(perfA.percentage);
                    const valueB = parseFloat(perfB.percentage);
                    return order === 'asc' ? valueA - valueB : valueB - valueA;

                default:
                    return 0;
            }
        });

        // Re-render with sorted items
        const container = document.getElementById('menuItemsList');
        container.innerHTML = sortedItems.map(item => {
            const performance = getPerformance(item, state.selectedPeriod);
            const avgValue = state.selectedPeriod === 'yesterday' ? item.history.yesterday :
                state.selectedPeriod === '7days' ? item.history.avg7days :
                    state.selectedPeriod === '30days' ? item.history.avg30days :
                        item.history.avg90days;

            return `
                <div class="menu-item-card ${performance.status}" onclick="openModal(${item.id})">
                    <div class="menu-item-content">
                        <div class="menu-item-image">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div class="menu-item-info">
                            <div class="menu-item-header">
                                <h3 class="menu-item-name">${item.name}</h3>
                                <span class="performance-badge ${performance.status}">
                                    ${getPerformanceIcon(performance.status)}
                                    ${performance.label}
                                </span>
                            </div>
                            <div class="menu-item-details">
                                <div class="menu-item-detail-row">
                                    <span class="menu-item-detail-label">Loại:</span>
                                    <span class="menu-item-detail-value">${item.category}</span>
                                </div>
                                <div class="menu-item-detail-row">
                                    <span class="menu-item-detail-label">Giá:</span>
                                    <span class="menu-item-detail-value price">${item.price}</span>
                                </div>
                                <div class="menu-item-detail-row">
                                    <span class="menu-item-detail-label">Hôm nay:</span>
                                    <span class="menu-item-detail-value">${item.today} phần</span>
                                </div>
                                <div class="menu-item-detail-row">
                                    <span class="menu-item-detail-label">Trung bình:</span>
                                    <span class="menu-item-detail-value">${avgValue} phần</span>
                                </div>
                                <div class="menu-item-detail-row" style="grid-column: span 2;">
                                    <span class="menu-item-detail-label">So sánh:</span>
                                    <span class="menu-item-detail-value comparison ${performance.status}">${performance.percentage}</span>
                                </div>
                            </div>
                        </div>
                        <button class="menu-item-edit-btn" onclick="handleEditMenu(event, ${item.id})" title="Chỉnh sửa món ăn">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                        </button>
                    </div>
                </div>
            `;
        }).join('');
    }

