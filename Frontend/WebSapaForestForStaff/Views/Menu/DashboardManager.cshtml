    // Get statistics summary
    function getStatsSummary() {
        const filteredItems = getFilteredItems();
        const totalOrders = filteredItems.reduce((sum, item) => sum + item.today, 0);
        const avgOrders = totalOrders / filteredItems.length;

        const performanceBreakdown = {
            hot: filteredItems.filter(item => getPerformance(item, state.selectedPeriod).status === 'hot').length,
            normal: filteredItems.filter(item => getPerformance(item, state.selectedPeriod).status === 'normal').length,
            low: filteredItems.filter(item => getPerformance(item, state.selectedPeriod).status === 'low').length,
        };

        return {
            totalItems: filteredItems.length,
            totalOrders: totalOrders,
            avgOrders: avgOrders.toFixed(1),
            performanceBreakdown: performanceBreakdown
        };
    }

