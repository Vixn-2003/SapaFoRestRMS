@model IEnumerable<WebSapaForestForStaff.DTOs.Customers.CustomerVipListItemDto>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Quản lý Khách hàng VIP";
    Layout = "~/Views/Shared/_LayoutManager.cshtml";
    var antiToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    
    // Sắp xếp theo điểm tích lũy giảm dần
    var sortedCustomers = Model.OrderByDescending(c => c.LoyaltyPoints).ToList();
    
    // Thống kê
    var totalCustomers = sortedCustomers.Count;
    var vipCustomers = sortedCustomers.Count(c => c.IsVip);
    var normalCustomers = totalCustomers - vipCustomers;
    var vipPercentage = totalCustomers > 0 ? (vipCustomers * 100.0 / totalCustomers) : 0;
    var totalPoints = sortedCustomers.Sum(c => c.LoyaltyPoints);
    var avgPoints = totalCustomers > 0 ? (totalPoints / totalCustomers) : 0;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Quản lý Khách hàng VIP</h2>
        <p class="text-muted mb-0">Theo dõi và quản lý khách hàng thân thiết</p>
    </div>
</div>

<!-- Success/Error Messages from TempData -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="mdi mdi-check-circle me-2"></i>
        <strong>Thành công!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="mdi mdi-alert-circle me-2"></i>
        <strong>Lỗi!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle  p-3">
                            <i class="mdi mdi-account-multiple text-primary" style="font-size: 24px;"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Tổng khách hàng</h6>
                        <h3 class="mb-0">@totalCustomers</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle  bg-opacity-10 p-3">
                            <i class="mdi mdi-crown text-warning" style="font-size: 24px;"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Khách VIP</h6>
                        <h3 class="mb-0">@vipCustomers</h3>
                        <small class="text-muted">(@vipPercentage.ToString("F1")%)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle  bg-opacity-10 p-3">
                            <i class="mdi mdi-account text-info" style="font-size: 24px;"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Khách thường</h6>
                        <h3 class="mb-0">@normalCustomers</h3>
                        <small class="text-muted">(@((100 - vipPercentage).ToString("F1"))%)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle bg-opacity-10 p-3">
                            <i class="mdi mdi-star text-success" style="font-size: 24px;"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Điểm TB/Khách</h6>
                        <h3 class="mb-0">@avgPoints.ToString("N0")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Additional Statistics Row -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle  bg-opacity-10 p-3">
                            <i class="mdi mdi-chart-line text-primary" style="font-size: 24px;"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Tổng điểm tích lũy</h6>
                        <h3 class="mb-0">@totalPoints.ToString("N0")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle bg-opacity-10 p-3">
                            <i class="mdi mdi-trophy text-danger" style="font-size: 24px;"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Khách hàng cao nhất</h6>
                        <h3 class="mb-0">@(sortedCustomers.FirstOrDefault()?.LoyaltyPoints.ToString("N0") ?? "0")</h3>
                        <small class="text-muted">@(sortedCustomers.FirstOrDefault()?.FullName ?? "N/A")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Customer List Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">
            <i class="mdi mdi-format-list-numbered me-2"></i>
            Danh sách Khách hàng
            <span class="text-muted small">(Xếp hạng theo điểm tích lũy)</span>
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 60px;">#</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th class="text-center">
                            <i class="mdi mdi-star text-warning"></i> Điểm tích lũy
                        </th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Cấp VIP</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rank = 1;
                    }
                    @foreach (var customer in sortedCustomers)
                    {
                        <tr data-customer-id="@customer.CustomerId">
                            <td class="text-center">
                                @if (rank <= 3)
                                {
                                    <span class="badge rounded-pill @(rank == 1 ? "bg-warning" : rank == 2 ? "bg-secondary" : "bg-danger") text-dark" style="font-size: 14px;">
                                        @if (rank == 1)
                                        {
                                            <i class="mdi mdi-trophy"></i>
                                        }
                                        else if (rank == 2)
                                        {
                                            <i class="mdi mdi-medal"></i>
                                        }
                                        else
                                        {
                                            <i class="mdi mdi-medal-outline"></i>
                                        }
                                        @rank
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted fw-bold">@rank</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-2" style="width: 40px; height: 40px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                                        @(string.IsNullOrWhiteSpace(customer.FullName) ? "?" : customer.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(customer.FullName) ? "Khách lẻ" : customer.FullName)</div>
                                        <small class="text-muted">ID: @customer.CustomerId</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <i class="mdi mdi-phone text-muted me-1"></i>
                                @customer.Phone
                            </td>
                            <td class="text-center">
                                <span class="badge  bg-opacity-10 text-primary" style="font-size: 14px; padding: 8px 12px;">
                                    <i class="mdi mdi-star"></i> @customer.LoyaltyPoints.ToString("N0")
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge vip-badge @(customer.IsVip ? "bg-warning text-dark" : "bg-secondary text-white")">
                                    @if (customer.IsVip)
                                    {
                                        <i class="mdi mdi-crown"></i>
                                        <text> VIP</text>
                                    }
                                    else
                                    {
                                        <i class="mdi mdi-account"></i>
                                        <text> Thường</text>
                                    }
                                </span>
                            </td>
                            <td class="text-center">
                                <form asp-action="UpdateVip" asp-controller="ManagerCustomer" method="post" class="vip-form d-inline-block" data-customer-id="@customer.CustomerId">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="customerId" value="@customer.CustomerId" />
                                    <input type="hidden" name="isVip" value="@(!customer.IsVip)" class="vip-value" />
                                    <div class="form-check form-switch d-flex justify-content-center">
                                        <input class="form-check-input vip-toggle" type="checkbox" role="switch" data-customer-id="@customer.CustomerId" @(customer.IsVip ? "checked" : "") style="cursor: pointer;">
                                    </div>
                                </form>
                            </td>
                            <td class="text-center">
                                <a class="btn btn-sm btn-outline-info" href="@Url.Action("Details", new { id = customer.CustomerId })">
                                    <i class="mdi mdi-eye"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
    
    .table tbody tr {
        transition: background-color 0.2s;
    }
    
    .table tbody tr:hover {
    }
    
    .vip-toggle {
        width: 50px;
        height: 25px;
        cursor: pointer;
    }
    
    .avatar-circle {
        font-size: 18px;
    }
    
    .badge {
        font-weight: 500;
    }

    
    /* Statistics cards animation */
    .card-body i {
        transition: transform 0.3s;
    }
    
    .card:hover .card-body i {
        transform: scale(1.1);
    }
    
    /* Table header styling */
    .table-light {
        background-color: #f8f9fa !important;
    }
    
    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 0.5px;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Handle VIP toggle switches
        document.querySelectorAll('.vip-toggle').forEach(toggle => {
            toggle.addEventListener('change', function(e) {
                const checkbox = e.target;
                const isVip = checkbox.checked;
                const form = checkbox.closest('.vip-form');
                const customerId = form.dataset.customerId;
                
                // Confirmation message
                const confirmText = isVip
                    ? 'Bạn có chắc muốn đánh dấu khách này là VIP?'
                    : 'Bạn có chắc muốn hủy VIP của khách này?';

                if (!confirm(confirmText)) {
                    // Revert checkbox if cancelled
                    checkbox.checked = !isVip;
                    return;
                }

                // Update hidden input value
                const hiddenInput = form.querySelector('.vip-value');
                hiddenInput.value = isVip.toString();
                
                // Show loading state
                checkbox.disabled = true;
                
                // Submit form via Controller
                form.submit();
            });
        });

        // Auto-hide success/error messages after 5 seconds
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
        
        // Smooth scroll to messages if they exist
        const alerts = document.querySelectorAll('.alert');
        if (alerts.length > 0) {
            alerts[0].scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    });
</script>

