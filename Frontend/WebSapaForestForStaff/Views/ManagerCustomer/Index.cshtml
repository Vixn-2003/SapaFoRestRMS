@model WebSapaForestForStaff.ViewModels.CustomerManagement.CustomerListViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Quản lý Khách hàng";
    Layout = "~/Views/Shared/_LayoutManager.cshtml";
    var antiToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    // Thống kê
    var totalCustomers = Model.Items.Count;
    var vipCustomers = Model.Items.Count(c => c.IsVip);
    var normalCustomers = totalCustomers - vipCustomers;
    var vipPercentage = totalCustomers > 0 ? (vipCustomers * 100.0 / totalCustomers) : 0;
    var totalPoints = Model.Items.Sum(c => c.LoyaltyPoints);
    var avgPoints = totalCustomers > 0 ? (totalPoints / totalCustomers) : 0;
    var topCustomer = Model.Items.OrderByDescending(c => c.LoyaltyPoints).FirstOrDefault();
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Quản lý Khách hàng</h2>
        <p class="text-muted mb-0">Theo dõi và quản lý khách hàng</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" onclick="refreshData()">
            <i class="mdi mdi-refresh me-1"></i>Làm mới
        </button>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                            <i class="mdi mdi-account-multiple text-primary" style="font-size: 24px;"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Tổng khách hàng</h6>
                        <h3 class="mb-0">@totalCustomers.ToString()</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                            <i class="mdi mdi-crown text-warning" style="font-size: 24px;"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Khách VIP</h6>
                        <h3 class="mb-0">@vipCustomers.ToString()</h3>
                        <small class="text-muted">(@vipPercentage.ToString("F1")%)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle bg-info bg-opacity-10 p-3">
                            <i class="mdi mdi-account text-info" style="font-size: 24px;"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Khách thường</h6>
                        <h3 class="mb-0">@normalCustomers.ToString()</h3>
                        <small class="text-muted">(@((100 - vipPercentage).ToString("F1"))%)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3">
                            <i class="mdi mdi-star text-success" style="font-size: 24px;"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Điểm TB/Khách</h6>
                        <h3 class="mb-0">@avgPoints.ToString()</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Additional Statistics Row -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                            <i class="mdi mdi-chart-line text-primary" style="font-size: 24px;"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Tổng điểm tích lũy</h6>
                        <h3 class="mb-0">@totalPoints.ToString()</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3">
                            <i class="mdi mdi-trophy text-danger" style="font-size: 24px;"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Khách hàng cao nhất</h6>
                        <h3 class="mb-0">@(topCustomer?.LoyaltyPoints.ToString() ?? "0")</h3>
                        <small class="text-muted">@(topCustomer?.FullName ?? "N/A")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Messages from TempData -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="mdi mdi-check-circle me-2"></i>
        <strong>Thành công!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="mdi mdi-alert-circle me-2"></i>
        <strong>Lỗi!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Two Column Layout: Search and Filter Section (col-3) | Customer List Section (col-7) -->
<div class="row">
    <!-- Search and Filter Section (Left - col-3) -->
    <div class="col-3">
        <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
            <div class="card-header bg-light">
                <h6 class="mb-0">
                    <i class="mdi mdi-filter-outline me-2"></i>
                    Tìm kiếm & Lọc
                </h6>
            </div>
            <div class="card-body">
                <form id="filterForm" method="get">
                    <!-- Search Keyword -->
                    <div class="mb-3">
                        <label for="searchKeyword" class="form-label">Tìm kiếm</label>
                        <input type="text" class="form-control" id="searchKeyword" name="keyword"
                               value="@Model.Filters.Keyword" placeholder="Tên, số điện thoại, email">
                    </div>

                    <!-- VIP Filter -->
                    <div class="mb-3">
                        <label for="isVip" class="form-label">Trạng thái VIP</label>
                        <select class="form-select" id="isVip" name="isVip">
                            <option value="" selected="@(Model.Filters.IsVip == null)">Tất cả</option>
                            <option value="true" selected="@(Model.Filters.IsVip == true)">VIP</option>
                            <option value="false" selected="@(Model.Filters.IsVip == false)">Thường</option>
                        </select>
                    </div>

                    <!-- Spending Range -->
                    <div class="mb-3">
                        <label class="form-label">Chi tiêu (VNĐ)</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" class="form-control" id="minSpending" name="minSpending"
                                       value="@Model.Filters.MinSpending" placeholder="Từ">
                            </div>
                            <div class="col-6">
                                <input type="number" class="form-control" id="maxSpending" name="maxSpending"
                                       value="@Model.Filters.MaxSpending" placeholder="Đến">
                            </div>
                        </div>
                    </div>

                    <!-- Visit Count -->
                    <div class="mb-3">
                        <label class="form-label">Số lần ghé thăm</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" class="form-control" id="minVisits" name="minVisits"
                                       value="@Model.Filters.MinVisits" placeholder="Từ">
                            </div>
                            <div class="col-6">
                                <input type="number" class="form-control" id="maxVisits" name="maxVisits"
                                       value="@Model.Filters.MaxVisits" placeholder="Đến">
                            </div>
                        </div>
                    </div>

                    <!-- Sort Options -->
                    <div class="mb-3">
                        <label for="sortBy" class="form-label">Sắp xếp theo</label>
                        <select class="form-select" id="sortBy" name="sortBy">
                            <option value="TotalSpending" selected="@(Model.Filters.SortBy == "TotalSpending")">Tổng chi tiêu</option>
                            <option value="FullName" selected="@(Model.Filters.SortBy == "FullName")">Tên khách hàng</option>
                            <option value="LastVisit" selected="@(Model.Filters.SortBy == "LastVisit")">Lần ghé cuối</option>
                            <option value="TotalVisits" selected="@(Model.Filters.SortBy == "TotalVisits")">Số lần ghé</option>
                        </select>
                    </div>

                    <!-- Sort Direction -->
                    <div class="mb-3">
                        <label for="sortDirection" class="form-label">Thứ tự</label>
                        <select class="form-select" id="sortDirection" name="sortDirection">
                            <option value="desc" selected="@(Model.Filters.SortDirection == "desc")">Giảm dần</option>
                            <option value="asc" selected="@(Model.Filters.SortDirection == "asc")">Tăng dần</option>
                        </select>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="mdi mdi-magnify me-1"></i>Tìm kiếm
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="resetFilters()">
                            <i class="mdi mdi-refresh me-1"></i>Đặt lại
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Customer List Section (Right - col-7) -->
    <div class="col-7">
        <!-- Statistics Summary -->
       

        <!-- Customer List Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <i class="mdi mdi-format-list-numbered me-2"></i>
                    Danh sách Khách hàng
                </h6>
                <small class="text-muted">
                    Hiển thị @(Model.Pagination.StartRecord) đến @(Model.Pagination.EndRecord) của @Model.Pagination.TotalRecords.ToString("N0") khách hàng
                </small>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Khách hàng</th>
                                <th>
                                    <a href="#" class="text-decoration-none" onclick="sortBy('TotalSpending')">
                                        Chi tiêu <i class="mdi mdi-sort@(Model.Filters.SortBy == "TotalSpending" ? (Model.Filters.SortDirection == "asc" ? "-ascending" : "-descending") : "")"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="#" class="text-decoration-none" onclick="sortBy('TotalVisits')">
                                        Ghé thăm <i class="mdi mdi-sort@(Model.Filters.SortBy == "TotalVisits" ? (Model.Filters.SortDirection == "asc" ? "-ascending" : "-descending") : "")"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="#" class="text-decoration-none" onclick="sortBy('LastVisit')">
                                        Ghé cuối <i class="mdi mdi-sort@(Model.Filters.SortBy == "LastVisit" ? (Model.Filters.SortDirection == "asc" ? "-ascending" : "-descending") : "")"></i>
                                    </a>
                                </th>
                                <th class="text-center">VIP</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="customerTableBody">
                            @foreach (var customer in Model.Items)
                            {
                                <tr data-customer-id="@customer.CustomerId">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle me-2" style="width: 35px; height: 35px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 14px;">
                                                @(string.IsNullOrWhiteSpace(customer.FullName) ? "?" : customer.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(customer.FullName) ? "Khách lẻ" : customer.FullName)</div>
                                                <small class="text-muted">
                                                    <i class="mdi mdi-phone me-1"></i>@customer.Phone
                                                    @if (!string.IsNullOrWhiteSpace(customer.Email))
                                                    {
                                                        <br><i class="mdi mdi-email me-1"></i>@customer.Email
                                                    }
                                                </small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-success">@customer.TotalSpending.ToString("N0") đ</span>
                                        <br><small class="text-muted">@customer.AverageSpendPerVisit.ToString("N0") đ/lần</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@customer.TotalVisits</span>
                                    </td>
                                    <td>
                                        @if (customer.LastVisit.HasValue)
                                        {
                                            <span>@customer.LastVisit.Value.ToString("dd/MM/yyyy")</span>
                                            <br><small class="text-muted">@customer.LastVisit.Value.ToString("HH:mm")</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa có</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(customer.IsVip ? "bg-warning text-dark" : "bg-secondary text-white")">
                                            @if (customer.IsVip)
                                            {
                                                <i class="mdi mdi-crown"></i> @Html.Raw("VIP")
                                            }
                                            else
                                            {
                                                <i class="mdi mdi-account"></i> @Html.Raw("Thường")
                                            }
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a class="btn btn-sm btn-outline-info" href="@Url.Action("Details", new { id = customer.CustomerId })" title="Chi tiết">
                                                <i class="mdi mdi-eye"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-warning" onclick="openVipUpdateModal(@customer.CustomerId, @customer.IsVip.ToString().ToLower())" title="Cập nhật VIP">
                                                <i class="mdi mdi-crown"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.Pagination.TotalPages > 1)
                {
                    <div class="card-footer bg-white">
                        <nav aria-label="Customer pagination">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <!-- Previous -->
                                @if (Model.Pagination.HasPreviousPage)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="#" onclick="goToPage(@(Model.Pagination.PageNumber - 1))">
                                            <i class="mdi mdi-chevron-left"></i> Trước
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">
                                            <i class="mdi mdi-chevron-left"></i> Trước
                                        </span>
                                    </li>
                                }

                                <!-- Page Numbers -->
                                @for (int i = Math.Max(1, Model.Pagination.PageNumber - 2); i <= Math.Min(Model.Pagination.TotalPages, Model.Pagination.PageNumber + 2); i++)
                                {
                                    <li class="page-item @(i == Model.Pagination.PageNumber ? "active" : "")">
                                        <a class="page-link" href="#" onclick="goToPage(@i)">@i</a>
                                    </li>
                                }

                                <!-- Next -->
                                @if (Model.Pagination.HasNextPage)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="#" onclick="goToPage(@(Model.Pagination.PageNumber + 1))">
                                            Sau <i class="mdi mdi-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">
                                            Sau <i class="mdi mdi-chevron-right"></i>
                                        </span>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- VIP Update Modal -->
<div class="modal fade" id="vipUpdateModal" tabindex="-1" aria-labelledby="vipUpdateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="vipUpdateModalLabel">Cập nhật trạng thái VIP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="vipModalText">Bạn có chắc muốn cập nhật trạng thái VIP của khách hàng này?</p>
                <div class="alert alert-info">
                    <small>
                        <strong>Lưu ý:</strong> Thay đổi trạng thái VIP sẽ ảnh hưởng đến quyền lợi và ưu đãi của khách hàng.
                    </small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning" id="confirmVipUpdate">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        font-size: 14px;
    }

    .badge {
        font-weight: 500;
    }

    .table th a {
        color: inherit;
        text-decoration: none;
    }

    .table th a:hover {
        color: #0d6efd;
    }

    .sticky-top {
        z-index: 100;
    }

    /* Statistics cards animation */
    .card-body i {
        transition: transform 0.3s;
    }

    .card:hover .card-body i {
        transform: scale(1.1);
    }

    /* Table header styling */
    .table-light {
        background-color: #f8f9fa !important;
    }

    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.5px;
        border: none;
        padding: 12px 8px;
    }

    .table td {
        padding: 12px 8px;
        border: none;
    }

    /* Filter form styling */
    .form-label {
        font-weight: 600;
        font-size: 13px;
        color: #495057;
        margin-bottom: 4px;
    }

    .form-control, .form-select {
        font-size: 14px;
        border-radius: 6px;
        border: 1px solid #dee2e6;
    }

    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }

    /* Pagination styling */
    .pagination .page-link {
        color: #0d6efd;
        border: none;
        padding: 8px 12px;
        margin: 0 2px;
    }

    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    .pagination .page-link:hover {
        background-color: #e9ecef;
        color: #0d6efd;
    }
</style>

<script>
    let currentPage = @Model.Pagination.PageNumber;
    let pageSize = @Model.Pagination.PageSize;

    // Global variables for VIP modal
    let currentCustomerId = null;
    let currentVipStatus = null;

    function submitFilterForm() {
        // Update page to 1 when filtering
        const form = document.getElementById('filterForm');
        const pageInput = document.createElement('input');
        pageInput.type = 'hidden';
        pageInput.name = 'pageNumber';
        pageInput.value = '1';
        form.appendChild(pageInput);
        form.submit();
    }

    function resetFilters() {
        document.getElementById('searchKeyword').value = '';
        document.getElementById('isVip').value = '';
        document.getElementById('minSpending').value = '';
        document.getElementById('maxSpending').value = '';
        document.getElementById('minVisits').value = '';
        document.getElementById('maxVisits').value = '';
        document.getElementById('sortBy').value = 'TotalSpending';
        document.getElementById('sortDirection').value = 'desc';
        submitFilterForm();
    }

    function sortBy(sortField) {
        const currentSortBy = '@Model.Filters.SortBy';
        const currentSortDirection = '@Model.Filters.SortDirection';

        let newSortDirection = 'asc';
        if (sortField === currentSortBy && currentSortDirection === 'asc') {
            newSortDirection = 'desc';
        }

        document.getElementById('sortBy').value = sortField;
        document.getElementById('sortDirection').value = newSortDirection;
        submitFilterForm();
    }

    function goToPage(page) {
        const form = document.getElementById('filterForm');
        const pageInput = document.createElement('input');
        pageInput.type = 'hidden';
        pageInput.name = 'pageNumber';
        pageInput.value = page;
        form.appendChild(pageInput);
        form.submit();
    }

    function refreshData() {
        // Show loading state
        const refreshBtn = document.querySelector('button[onclick="refreshData()"]');
        const originalText = refreshBtn.innerHTML;
        refreshBtn.innerHTML = '<i class="mdi mdi-loading mdi-spin me-1"></i>Đang tải...';
        refreshBtn.disabled = true;

        // Reload the page
        setTimeout(() => {
            window.location.reload();
        }, 500);
    }

    function openVipUpdateModal(customerId, isVip) {
        currentCustomerId = customerId;
        currentVipStatus = isVip === 'true';

        const modalText = currentVipStatus
            ? 'Bạn có chắc muốn hủy trạng thái VIP của khách hàng này?'
            : 'Bạn có chắc muốn cấp trạng thái VIP cho khách hàng này?';

        document.getElementById('vipModalText').textContent = modalText;

        const confirmBtn = document.getElementById('confirmVipUpdate');
        confirmBtn.className = currentVipStatus ? 'btn btn-danger' : 'btn btn-warning';
        confirmBtn.textContent = currentVipStatus ? 'Hủy VIP' : 'Cấp VIP';

        const modal = new bootstrap.Modal(document.getElementById('vipUpdateModal'));
        modal.show();
    }

    function confirmVipUpdate() {
        if (!currentCustomerId) return;

        const formData = new FormData();
        formData.append('__RequestVerificationToken', '@antiToken');
        formData.append('customerId', currentCustomerId);
        formData.append('isVip', (!currentVipStatus).toString());

        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('vipUpdateModal'));
        modal.hide();

        // Show loading
        const confirmBtn = document.getElementById('confirmVipUpdate');
        const originalText = confirmBtn.textContent;
        confirmBtn.innerHTML = '<i class="mdi mdi-loading mdi-spin me-1"></i>Đang xử lý...';
        confirmBtn.disabled = true;

        fetch('/ManagerCustomer/UpdateVip', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Reload page to show updated data
                window.location.reload();
            } else {
                alert('Lỗi: ' + (data.message || 'Không thể cập nhật trạng thái VIP'));
                confirmBtn.innerHTML = originalText;
                confirmBtn.disabled = false;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Đã xảy ra lỗi khi cập nhật trạng thái VIP');
            confirmBtn.innerHTML = originalText;
            confirmBtn.disabled = false;
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Auto-hide success/error messages after 5 seconds
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);

        // Smooth scroll to messages if they exist
        const alerts = document.querySelectorAll('.alert');
        if (alerts.length > 0) {
            alerts[0].scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // Handle Enter key in filter inputs
        document.querySelectorAll('#filterForm input').forEach(input => {
            input.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    submitFilterForm();
                }
            });
        });

        // Handle filter form submission
        document.getElementById('filterForm').addEventListener('submit', function(e) {
            e.preventDefault();
            submitFilterForm();
        });
    });
</script>
