        );

        if (!confirmed) {
            return;
        }

        try {
            // ✅ Gọi qua Controller thay vì gọi API trực tiếp
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const response = await fetch('/DashboardTable/CancelOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    orderId: activeOrderId,
                    reason: "Khách rời đi trước khi món làm"
                })
