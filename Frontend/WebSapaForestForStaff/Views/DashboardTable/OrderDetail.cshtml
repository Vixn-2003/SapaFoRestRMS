</script>

@* Gọi file JS riêng *@
<script src="~/js/waiter/OrderDetail.js"></script>

<script>
    // Khởi tạo biến JS từ Razor
        cartItems = window.__INITIAL_ORDER_DATA__ || [];
        tableId = window.__TABLE_ID__;

    // Modal Bootstrap
    var modalDelEl = document.getElementById('confirmDeleteModal');
    if(modalDelEl) modalDelete = new bootstrap.Modal(modalDelEl);

    var modalWarnEl = document.getElementById('modifyWarningModal');
