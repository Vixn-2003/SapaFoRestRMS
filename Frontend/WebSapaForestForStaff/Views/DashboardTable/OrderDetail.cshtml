    /**
     * ↩️ HOÀN TÁC XÁC NHẬN ĐƠN HÀNG
     * Hoàn tác xác nhận đơn hàng (chuyển status từ "Confirmed" về "WaitingConfirmation")
     * Cho phép waiter sửa lại đơn hàng nếu xác nhận sai
     */
    async function handleUndoConfirmPayment() {
        const activeOrderId = window.__ACTIVE_ORDER_ID__;
        if (activeOrderId <= 0) {
            alert('Không tìm thấy đơn hàng. Vui lòng thử lại.');
            return;
        }

        const tableNumber = '@Model.TableNumber';
        const customerName = '@(Model.CustomerName ?? "Khách vãng lai")';

        // Hiển thị popup xác nhận với input lý do
        const reason = prompt(
            `Bạn có chắc muốn hoàn tác xác nhận đơn hàng?\n\n` +
            `Bàn: ${tableNumber}\n` +
            `Khách hàng: ${customerName}\n\n` +
            `Vui lòng nhập lý do hoàn tác (ít nhất 10 ký tự):`,
            ""
        );

        if (!reason || reason.trim().length < 10) {
            if (reason !== null) { // User đã nhập nhưng không đủ ký tự
                alert('Lý do hoàn tác phải có ít nhất 10 ký tự. Vui lòng thử lại.');
            }
            return;
        }

        try {
            // ✅ Gọi qua Controller thay vì gọi API trực tiếp
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const response = await fetch('/DashboardTable/UndoConfirmOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    staffId: 0, // Backend sẽ tự resolve từ userId trong claims
                    reason: reason.trim()
                })
            });

            if (!response.ok) {
                const errorData = await response.json().catch(() => ({}));
                throw new Error(errorData.message || 'Không thể hoàn tác xác nhận đơn hàng');
            }

            const result = await response.json();
            
            // Hiển thị thông báo thành công
            showToast('✅ Đã hoàn tác xác nhận đơn hàng thành công! Bạn có thể chỉnh sửa đơn hàng.', 'success');
            
            // Reload trang để cập nhật trạng thái
            setTimeout(() => {
                window.location.reload();
            }, 1500);
        } catch (error) {
            console.error('Lỗi khi hoàn tác xác nhận đơn hàng:', error);
            alert('Lỗi: ' + (error.message || 'Không thể hoàn tác xác nhận đơn hàng. Vui lòng thử lại.'));
        }
    }

