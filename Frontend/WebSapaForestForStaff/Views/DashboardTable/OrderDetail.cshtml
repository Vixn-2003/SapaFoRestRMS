     * Waiter xác nhận đơn hàng và chuyển Order status sang "Confirmed"
     * Sau khi xác nhận, đơn hàng sẽ được khóa và không thể thêm món nữa
     */
    async function handleWaiterConfirmPayment() {
        // Check if there are any items in the cart
        const visibleItems = cartItems.filter(x => !x.isDeleted);
        
        if (visibleItems.length === 0) {
            alert('Chưa có món nào trong đơn hàng. Vui lòng thêm món trước khi xác nhận thanh toán.');
            return;
        }

        // Check if there are unsaved changes
        const hasUnsavedChanges = cartItems.some(x => x.isNew || x.isDirty);
        if (hasUnsavedChanges) {
            alert('Bạn có thay đổi chưa lưu. Vui lòng lưu đơn hàng trước khi tiếp tục.');
            return;
        }

        const activeOrderId = window.__ACTIVE_ORDER_ID__;
        if (activeOrderId <= 0) {
            alert('Không tìm thấy đơn hàng. Vui lòng thử lại.');
            return;
        }

        const tableNumber = '@Model.TableNumber';
        const customerName = '@(Model.CustomerName ?? "Khách vãng lai")';
        const totalAmount = visibleItems.reduce((sum, item) => sum + (item.price * item.quantity), 0);

        // ✅ Sử dụng dữ liệu từ backend (đã tính toán sẵn)
        const totalQty = @Model.TotalQuantity;
        const qtyServedAndCooking = @Model.QtyServedAndCooking;
        const qtyNotCooked = @Model.QtyNotCooked;
        const qtyCancelled = @Model.QtyCancelled;

        const confirmed = await showConfirmPopup(
            "✅ Xác nhận thanh toán",
            `<div class="text-center mb-3">
                <h5 class="mb-3">Xác nhận đơn hàng để chuyển sang bước thanh toán?</h5>
            </div>
            <div style="background: #f7fafc; padding: 16px; border-radius: 8px; text-align: left;">
