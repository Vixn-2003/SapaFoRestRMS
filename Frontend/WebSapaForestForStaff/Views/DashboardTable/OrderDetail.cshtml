                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted"><i class="fa-solid fa-utensils me-2"></i>Số lượng món đã gọi:</span>
                    <span class="fw-bold text-primary">${totalQty} món</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted"><i class="fa-solid fa-check-circle me-2"></i>Đã phục vụ & đang nấu:</span>
                    <span class="fw-bold text-success">${qtyServedAndCooking} món</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted"><i class="fa-solid fa-clock me-2"></i>Chưa nấu:</span>
                    <span class="fw-bold text-warning">${qtyNotCooked} món</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted"><i class="fa-solid fa-ban me-2"></i>Món đã hủy:</span>
                    <span class="fw-bold text-danger">${qtyCancelled} món</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted"><i class="fa-solid fa-money-bill me-2"></i>Tạm tính:</span>
                    <span class="fw-bold text-success" style="font-size: 18px;">${totalAmount.toLocaleString('vi-VN')} ₫</span>
                </div>
            </div>
            <div class="alert alert-warning d-flex align-items-start gap-2 mt-3 mb-0">
                <i class="fa-solid fa-triangle-exclamation mt-1"></i>
                <div class="small">
                    <strong>Lưu ý:</strong> Sau khi xác nhận, đơn hàng sẽ bị khóa và không thể thêm món nữa. 
                    Thu ngân sẽ xử lý thanh toán sau đó.
                </div>
            </div>`,
            "✅ Xác nhận",
            "❌ Hủy"
        );

        if (!confirmed) {
            return;
        }

        try {
            // Gọi API backend để chuyển trạng thái Order sang Confirmed
            const payload = {
                orderId: activeOrderId,
                items: visibleItems.map(item => ({
                    orderDetailId: item.id,
                    quantityUsed: item.quantity,
                    isRemoved: false
                })),
                notes: null
            };

            // ✅ Gọi qua Controller thay vì gọi API trực tiếp
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const response = await fetch('/DashboardTable/ConfirmOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const errorData = await response.json().catch(() => ({}));
                throw new Error(errorData.message || 'Không thể xác nhận đơn hàng');
            }

            const result = await response.json();
            
            // Hiển thị thông báo thành công
            showToast('✅ Đã xác nhận đơn hàng thành công! Đơn hàng đã được khóa và sẵn sàng cho thu ngân thanh toán.', 'success');
            
            // Reload trang để cập nhật trạng thái
            setTimeout(() => {
                window.location.reload();
            }, 1500);
        } catch (error) {
            console.error('Lỗi khi xác nhận đơn hàng:', error);
            alert('Lỗi: ' + (error.message || 'Không thể xác nhận đơn hàng. Vui lòng thử lại.'));
        }
    }

    /**
     * 💳 CASHIER CREATE PAYMENT ORDER
     * Cashier chuyển sang màn hình thanh toán
     * Đơn hàng phải đã được Waiter xác nhận (status = "Confirmed") trước đó
     */
    async function handleCreatePaymentOrder() {
        // ✅ VALIDATION: Kiểm tra đơn hàng đã được xác nhận chưa
        const orderStatus = window.__ORDER_STATUS__ || '';
        if (!orderStatus || orderStatus.toLowerCase() !== 'confirmed') {
            alert('⚠️ Đơn hàng chưa được xác nhận!\n\nVui lòng đợi waiter xác nhận đơn hàng (status = "Confirmed") trước khi thanh toán.');
            return;
        }

        // Check if there are any items in the cart
        const visibleItems = cartItems.filter(x => !x.isDeleted);
        
        if (visibleItems.length === 0) {
            alert('Chưa có món nào trong đơn hàng. Vui lòng thêm món trước khi thanh toán.');
            return;
        }

        const activeOrderId = window.__ACTIVE_ORDER_ID__;
        if (activeOrderId <= 0) {
            alert('Không tìm thấy đơn hàng. Vui lòng thử lại.');
            return;
        }

        const tableNumber = '@Model.TableNumber';
        const customerName = '@(Model.CustomerName ?? "Khách vãng lai")';
        const totalQty = visibleItems.reduce((sum, item) => sum + item.quantity, 0);
        const totalAmount = visibleItems.reduce((sum, item) => sum + (item.price * item.quantity), 0);

        // ✅ Double-check status trước khi hiển thị popup
        if (!orderStatus || orderStatus.toLowerCase() !== 'confirmed') {
            alert('⚠️ Đơn hàng chưa được xác nhận!\n\nVui lòng đợi waiter xác nhận đơn hàng (status = "Confirmed") trước khi thanh toán.');
            return;
        }

        const confirmed = await showConfirmPopup(
            "💳 Thanh toán bàn",
            `<div class="text-center mb-3">
                <h5 class="mb-3">Chuyển sang màn hình thanh toán?</h5>
            </div>
            <div style="background: #f7fafc; padding: 16px; border-radius: 8px; text-align: left;">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted"><i class="fa-solid fa-chair me-2"></i>Bàn:</span>
                    <span class="fw-bold">${tableNumber}</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted"><i class="fa-solid fa-user me-2"></i>Khách hàng:</span>
                    <span class="fw-bold">${customerName}</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted"><i class="fa-solid fa-check-circle me-2 text-success"></i>Trạng thái:</span>
                    <span class="fw-bold text-success">Đã xác nhận</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted"><i class="fa-solid fa-utensils me-2"></i>Số lượng món:</span>
                    <span class="fw-bold">${totalQty} món</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted"><i class="fa-solid fa-money-bill me-2"></i>Tạm tính:</span>
                    <span class="fw-bold text-success" style="font-size: 18px;">${totalAmount.toLocaleString('vi-VN')} ₫</span>
                </div>
            </div>
            <div class="alert alert-info d-flex align-items-start gap-2 mt-3 mb-0">
                <i class="fa-solid fa-info-circle mt-1"></i>
