@model WebSapaForestForStaff.DTOs.CustomerManagement.CustomerDetailDto

@{
    ViewData["Title"] = "Customer Detail";
    Layout = "~/Views/Shared/_LayoutStaff.cshtml";
}

<div class="container-fluid py-4">
    <!-- Back Button -->
    <div class="row mb-3">
        <div class="col-12">
            <a href="@Url.Action("Index", "CustomerManagement")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to Customer List
            </a>
        </div>
    </div>

    <!-- Customer Info Card -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-user me-2"></i>
                        @Model.FullName
                        @if (Model.IsVip)
                        {
                            <span class="badge bg-warning text-dark ms-2">
                                <i class="fas fa-crown"></i> VIP
                            </span>
                        }
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Customer ID:</strong> @Model.CustomerId</p>
                            <p><strong>Phone:</strong> @(Model.Phone ?? "N/A")</p>
                            <p><strong>Email:</strong> @(Model.Email ?? "N/A")</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Join Date:</strong> @(Model.JoinDate?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                            <p><strong>Last Visit:</strong> @(Model.LastVisit?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                            <p><strong>Loyalty Points:</strong> @(Model.LoyaltyPoints ?? 0)</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <hr />
                        <p><strong>Notes:</strong> @Model.Notes</p>
                    }
                </div>
            </div>
        </div>

        <!-- Statistics Card -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-3 border-primary">
                <div class="card-body text-center">
                    <h5 class="text-primary">Total Spending</h5>
                    <h2 class="mb-0">@Model.TotalSpending.ToString("N0") VND</h2>
                </div>
            </div>
            <div class="card shadow-sm mb-3 border-success">
                <div class="card-body text-center">
                    <h5 class="text-success">Total Visits</h5>
                    <h2 class="mb-0">@Model.TotalVisits</h2>
                </div>
            </div>
            <div class="card shadow-sm border-info">
                <div class="card-body text-center">
                    <h5 class="text-info">Avg. per Visit</h5>
                    <h2 class="mb-0">@Model.AverageSpendPerVisit.ToString("N0") VND</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- VIP Management Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">
                        <i class="fas fa-crown me-2"></i>
                        VIP Management
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1"><strong>Current Status:</strong> 
                                @if (Model.IsVip)
                                {
                                    <span class="badge bg-warning text-dark">VIP Customer</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Regular Customer</span>
                                }
                            </p>
                            <p class="mb-0 text-muted">Update customer VIP status based on spending criteria</p>
                        </div>
                        <button class="btn btn-primary" 
                                onclick="openVipUpdateModal(@Model.CustomerId, @Model.IsVip.ToString().ToLower(), '@Model.FullName')">
                            <i class="fas fa-edit me-1"></i> Update VIP Status
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Favorite Dishes -->
    @if (Model.FavoriteDishes != null && Model.FavoriteDishes.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-heart me-2"></i>
                            Favorite Dishes
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var dish in Model.FavoriteDishes.Take(3))
                            {
                                <div class="col-md-4">
                                    <div class="card border-info mb-3">
                                        <div class="card-body">
                                            <h6 class="card-title">@dish.DishName</h6>
                                            <p class="mb-1"><strong>Orders:</strong> @dish.OrderCount times</p>
                                            <p class="mb-0"><strong>Total:</strong> @dish.TotalSpent.ToString("N0") VND</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Order History -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-history me-2"></i>
                        Order History
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.OrderHistory != null && Model.OrderHistory.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th class="text-center">Items</th>
                                        <th class="text-end">Amount</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.OrderHistory.Take(20))
                                    {
                                        <tr>
                                            <td>#@order.OrderId</td>
                                            <td>@(order.OrderDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                            <td>@order.OrderType</td>
                                            <td class="text-center">@order.NumberOfItems</td>
                                            <td class="text-end">@order.TotalAmount.ToString("N0") VND</td>
                                            <td class="text-center">
                                                <span class="badge bg-success">@order.Status</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (Model.OrderHistory.Count > 20)
                        {
                            <p class="text-muted text-center">Showing 20 of @Model.OrderHistory.Count orders</p>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No order history found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- VIP Update Modal -->
@await Html.PartialAsync("_VipUpdateModal")

@section Scripts {
    <script src="~/js/customer-management.js"></script>
}

