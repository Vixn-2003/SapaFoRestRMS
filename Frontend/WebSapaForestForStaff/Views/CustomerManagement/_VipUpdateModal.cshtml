<!-- VIP Update Modal -->
<div class="modal fade" id="vipUpdateModal" tabindex="-1" aria-labelledby="vipUpdateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="vipUpdateModalLabel">
                    <i class="fas fa-crown me-2"></i>
                    Update VIP Status
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Customer Info -->
                <div class="alert alert-info mb-3">
                    <h6 class="mb-1"><strong>Customer:</strong> <span id="modalCustomerName"></span></h6>
                    <p class="mb-0 small">Customer ID: <span id="modalCustomerId"></span></p>
                </div>

                <!-- Current VIP Status -->
                <div class="mb-3">
                    <label class="form-label"><strong>Current VIP Status:</strong></label>
                    <div>
                        <span id="modalCurrentVipStatus" class="badge"></span>
                    </div>
                </div>

                <!-- VIP Criteria Check Result -->
                <div id="vipCriteriaResult" class="alert" style="display: none;">
                    <div id="vipCriteriaContent"></div>
                </div>

                <!-- New VIP Status Selection -->
                <div class="mb-3">
                    <label for="newVipStatus" class="form-label"><strong>New VIP Status:</strong></label>
                    <select id="newVipStatus" class="form-select">
                        <option value="false">Regular Customer</option>
                        <option value="true">VIP Customer</option>
                    </select>
                </div>

                <!-- Manual Override Checkbox -->
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="manualOverride">
                    <label class="form-check-label" for="manualOverride">
                        Manual Override (Skip VIP criteria validation)
                    </label>
                    <div class="form-text">
                        Check this box to override system VIP criteria and manually assign VIP status.
                    </div>
                </div>

                <!-- Reason for Change -->
                <div class="mb-3">
                    <label for="changeReason" class="form-label">Reason for Change (Optional):</label>
                    <textarea id="changeReason" 
                              class="form-control" 
                              rows="3" 
                              placeholder="Enter reason for VIP status change..."></textarea>
                </div>

                <!-- Warning Message -->
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Note:</strong> This action will be logged in the audit system for compliance tracking.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="btnCheckCriteria">
                    <i class="fas fa-check-circle me-1"></i> Check VIP Criteria
                </button>
                <button type="button" class="btn btn-success" id="btnConfirmUpdate">
                    <i class="fas fa-save me-1"></i> Confirm Update
                </button>
            </div>
        </div>
    </div>
</div>

