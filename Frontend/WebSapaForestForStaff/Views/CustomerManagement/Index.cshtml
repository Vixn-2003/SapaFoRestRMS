@{
    ViewData["Title"] = "Customer Management";
    Layout = "~/Views/Shared/_LayoutStaff.cshtml";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="mb-0">
                        <i class="fas fa-users me-2"></i>
                        Customer Management
                    </h2>
                    <p class="text-muted mb-0">View and manage customer list and VIP status</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Search Box -->
                        <div class="col-md-4">
                            <label class="form-label">Search Customer</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-search"></i></span>
                                <input type="text" 
                                       id="searchKeyword" 
                                       class="form-control" 
                                       placeholder="Name, phone, or email...">
                            </div>
                        </div>

                        <!-- VIP Filter -->
                        <div class="col-md-2">
                            <label class="form-label">VIP Status</label>
                            <select id="vipFilter" class="form-select">
                                <option value="">All Customers</option>
                                <option value="true">VIP Only</option>
                                <option value="false">Non-VIP Only</option>
                            </select>
                        </div>

                        <!-- Min Spending -->
                        <div class="col-md-2">
                            <label class="form-label">Min Spending</label>
                            <input type="number" 
                                   id="minSpending" 
                                   class="form-control" 
                                   placeholder="0"
                                   min="0">
                        </div>

                        <!-- Min Visits -->
                        <div class="col-md-2">
                            <label class="form-label">Min Visits</label>
                            <input type="number" 
                                   id="minVisits" 
                                   class="form-control" 
                                   placeholder="0"
                                   min="0">
                        </div>

                        <!-- Sort By -->
                        <div class="col-md-2">
                            <label class="form-label">Sort By</label>
                            <select id="sortBy" class="form-select">
                                <option value="TotalSpending">Total Spending</option>
                                <option value="FullName">Name</option>
                                <option value="TotalVisits">Total Visits</option>
                                <option value="LastVisit">Last Visit</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <button id="btnSearch" class="btn btn-primary me-2">
                                <i class="fas fa-search me-1"></i> Search
                            </button>
                            <button id="btnReset" class="btn btn-secondary">
                                <i class="fas fa-redo me-1"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer List -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <!-- Loading Spinner -->
                    <div id="loadingSpinner" class="text-center py-5" style="display: none;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading customers...</p>
                    </div>

                    <!-- Customer Table -->
                    <div id="customerTableContainer">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Customer Name</th>
                                        <th>Phone</th>
                                        <th>Email</th>
                                        <th class="text-end">Total Spending</th>
                                        <th class="text-center">Visits</th>
                                        <th class="text-center">VIP Status</th>
                                        <th class="text-center">Last Visit</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="customerTableBody">
                                    <!-- Data will be loaded via JavaScript -->
                                </tbody>
                            </table>
                        </div>

                        <!-- No Results Message -->
                        <div id="noResultsMessage" class="text-center py-5" style="display: none;">
                            <i class="fas fa-users-slash fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No customers found matching your search criteria.</p>
                        </div>
                    </div>

                    <!-- Pagination -->
                    <div id="paginationContainer" class="mt-4">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <p id="paginationInfo" class="mb-0 text-muted"></p>
                            </div>
                            <div class="col-md-6">
                                <nav aria-label="Customer pagination">
                                    <ul id="paginationList" class="pagination justify-content-end mb-0">
                                        <!-- Pagination buttons will be generated by JavaScript -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- VIP Update Modal -->
@await Html.PartialAsync("_VipUpdateModal")

@section Scripts {
    <script src="~/js/customer-management.js"></script>
}

