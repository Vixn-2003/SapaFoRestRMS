@model WebSapaForestForStaff.DTOs.Waiter.WaiterOrderTrackingDto
@using System.Text.Json
@{
    ViewData["Title"] = "Theo dõi tiến độ phục vụ";
    Layout = "~/Views/Shared/_counterstaffLayout.cshtml";
}

@functions {
    string GetStatusClass(string status)
    {
        var statusLower = (status ?? "").ToLower().Trim();
        if (statusLower.Contains("cooking") || statusLower.Contains("chế biến") || statusLower.Contains("đang nấu"))
            return "cooking";
        if (statusLower.Contains("ready") || statusLower.Contains("sẵn sàng"))
            return "ready";
        if (statusLower.Contains("cancelled") || statusLower.Contains("hủy") || statusLower.Contains("đã hủy"))
            return "cancelled";
        if (statusLower.Contains("pending") || statusLower.Contains("chờ") || statusLower.Contains("chờ bếp"))
            return "pending";
        if (statusLower.Contains("late") || statusLower.Contains("trễ"))
            return "late";
        if (statusLower.Contains("done") || statusLower.Contains("hoàn thành") || statusLower.Contains("xong"))
            return "done";
        return "";
    }

    string GetStatusText(string status)
    {
        var statusLower = (status ?? "").ToLower().Trim();
        // Format thống nhất theo yêu cầu
        if (statusLower.Contains("pending") || statusLower.Contains("chờ") || statusLower.Contains("chờ bếp"))
            return "CHỜ";
        if (statusLower.Contains("cooking") || statusLower.Contains("chế biến") || statusLower.Contains("đang nấu"))
            return "ĐANG NẤU";
        if (statusLower.Contains("ready") || statusLower.Contains("sẵn sàng"))
            return "SẴN SÀNG";
        if (statusLower.Contains("late") || statusLower.Contains("trễ"))
            return "TRỄ";
        if (statusLower.Contains("cancelled") || statusLower.Contains("hủy") || statusLower.Contains("đã hủy"))
            return "ĐÃ HỦY";
        if (statusLower.Contains("done") || statusLower.Contains("hoàn thành") || statusLower.Contains("xong"))
            return "HOÀN THÀNH";
        return "CHỜ";
    }
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --primary-orange: #ff7b00;
        --active-purple: #594a87;
        --bg-light: #f5f7fa;
        --text-dark: #2c3e50;
        --text-muted: #6c757d;
        --card-radius: 12px;
        --border-color: #e0e0e0;
    }

    body {
        background-color: #f5f5f5;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        overflow-x: hidden;
        color: var(--text-dark);
    }

    /* Table Filter Styles */
    #tableFilter {
        background: white;
        border: 1px solid rgba(255,255,255,0.3);
        color: #2d3748;
        font-size: 14px;
    }

    #tableFilter option {
        padding: 8px;
    }

    #tableFilter optgroup {
        font-weight: 600;
        color: #4a5568;
    }

    /* Header - Đơn giản, màu xám */
    .top-header {
        background: #2d3748;
        color: white;
        padding: 20px 25px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 0;
    }

    .avatar-circle {
        width: 48px;
        height: 48px;
        background: #4a5568;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: white;
        font-size: 18px;
    }

    /* Status Cards - Đơn giản, màu xám */
    .status-card {
        background: #4a5568;
        color: white;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
    }

    .status-card .count {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .status-card .label {
        font-size: 12px;
        opacity: 0.9;
        font-weight: 500;
    }

    .status-card .label .fa-bell {
        transition: transform 0.2s ease-in-out;
    }

    .status-card .label .fa-bell.ringing {
        animation: bell-ring 1s infinite;
        transform-origin: top center;
    }

    @@keyframes bell-ring {
        0% { transform: rotate(0deg); }
        15% { transform: rotate(15deg); }
        30% { transform: rotate(-15deg); }
        45% { transform: rotate(10deg); }
        60% { transform: rotate(-10deg); }
        75% { transform: rotate(5deg); }
        100% { transform: rotate(0deg); }
    }

    /* Filter Buttons - Đơn giản */
    .filter-btn {
        border: none;
        background: #4a5568;
        padding: 10px 20px;
        border-radius: 8px;
        margin-right: 10px;
        font-weight: 600;
        color: white;
        transition: all 0.3s;
        font-size: 14px;
    }

    .filter-btn:hover {
        background: #5a6578;
    }

    .filter-btn.active {
        background: white;
        color: #2d3748;
    }

    /* Order Group Card - Style đẹp hơn */
    /* Orders Container - 2 cột theo chiều ngang */
    .orders-grid {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 20px !important;
        width: 100% !important;
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 !important;
    }

    @@media (max-width: 1200px) {
        .orders-grid {
            grid-template-columns: 1fr !important;
        }
    }

    /* Order Card - Đơn giản */
    .order-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow: hidden;
        border: 1px solid #e5e7eb;
    }

    .order-card.has-ready {
        border-color: #22c55e;
        border-width: 2px;
    }

    .order-card.has-urgent {
        border-color: #ef4444;
        border-width: 2px;
    }

    .order-card-urgent {
        margin-top: 8px;
        color: #ef4444;
        font-weight: 700;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .order-card-header {
        padding: 16px;
        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
    }

    .order-card-header.has-ready {
        background: #f0fdf4;
    }

    .order-card-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .order-card-subtitle {
        font-size: 14px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 4px;
        font-weight: 500;
    }

    .table-badge {
        background: #4a5568;
        color: white;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 16px;
    }

    .table-badge.has-ready {
        background: #22c55e;
    }

    /* Timer Badges - Màu sắc dễ nhìn hơn */
    .timer-badge {
        font-size: 22px;
        font-weight: 700;
        padding: 10px 18px;
        border-radius: 10px;
        display: inline-block;
        min-width: 80px;
        text-align: center;
        letter-spacing: 0.5px;
    }

    .timer-normal { 
        background: #e8f4f8; 
        color: #2c3e50;
        border: 2px solid #b8d4e3;
    }

    .timer-warning { 
        background: #fff8e1; 
        color: #f57c00;
        border: 2px solid #ffc107;
        animation: pulse-warning 2s infinite;
    }

    .timer-critical { 
        background: #ffebee; 
        color: #c62828;
        border: 2px solid #ef5350;
        animation: pulse-critical 1.5s infinite;
        font-weight: 800;
    }

    @@keyframes pulse-warning {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.03); }
    }

    @@keyframes pulse-critical {
        0%, 100% { 
            transform: scale(1); 
            box-shadow: 0 0 0 0 rgba(239, 83, 80, 0.6);
        }
        50% { 
            transform: scale(1.05); 
            box-shadow: 0 0 0 6px rgba(239, 83, 80, 0);
        }
    }

    /* Progress Bar */
    .progress-container {
        margin: 16px 0;
        padding: 12px;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .progress {
        height: 10px;
        border-radius: 10px;
        background: #e9ecef;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        border-radius: 10px;
        transition: width 0.3s;
    }

    /* Item List - Style như React */
    .item-list {
        display: flex;
        flex-direction: column;
    }

    .item-row-wrapper {
        transition: all 0.2s;
    }
    
    .item-row-wrapper.filtered-out {
        display: none !important;
        visibility: hidden !important;
    }

    .item-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 14px 16px;
        margin-bottom: 8px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #ffffff;
        gap: 12px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.06);
        transition: all 0.2s;
    }

    .item-row:hover {
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        border-color: #d1d5db;
    }

    .item-row.ready {
        background: #f0fdf4;
        border-left: 4px solid #22c55e;
        border-color: #86efac;
    }

    .item-row.urgent {
        background: #fef2f2;
        border-left: 4px solid #ef4444;
        border-color: #fca5a5;
    }

    .item-info {
        flex: 1;
        min-width: 0;
    }

    .item-name {
        font-weight: 500;
        font-size: 16px;
        color: #1f2937;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .item-quantity {
        background: transparent;
        color: #374151;
        padding: 0;
        border-radius: 0;
        font-size: 15px;
        font-weight: 500;
    }

    .item-notes {
        font-size: 13px;
        color: #6b7280;
        margin: 6px 0;
        padding: 0;
        background: transparent;
        border: none;
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 400;
    }

    .item-notes i {
        color: #6b7280;
        font-size: 14px;
    }

    .item-notes strong {
        color: #374151;
        font-weight: 500;
    }

    .item-time {
        font-size: 13px;
        color: #6b7280;
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .item-time.waiting-long {
        /* Bỏ màu đỏ, chỉ nhấn nhẹ bằng font đậm nếu chờ lâu */
        font-weight: 700;
    }

    .item-time i {
        font-size: 14px;
    }

    .item-status-btn {
        padding: 8px 16px;
        border-radius: 6px;
        border: none;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 6px;
        background: #e5e7eb;
        color: #374151;
    }

    /* Màu sắc giống bếp */
    .item-status-btn.pending {
        background: #e3f2fd;
        color: #1976d2;
    }

    .item-status-btn.cooking {
        background: #fff3e0;
        color: #f57c00;
    }

    .item-status-btn.cooking.urgent {
        background: #ffebee;
        color: #c62828;
        animation: pulse-warning 2s infinite;
    }

    .item-status-btn.ready {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .item-status-btn.done {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .item-status-btn.served {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .order-complete-badge {
        background: #28a745;
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        font-size: 13px;
        white-space: nowrap;
    }

    /* Action Buttons - Thẳng hàng */
    .item-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-end;
        min-width: 200px;
    }

    .action-buttons-row {
        display: flex;
        flex-direction: row;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
    }

    .btn-action-item {
        padding: 8px 12px;
        font-size: 13px;
        border-radius: 6px;
        border: none;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        background: #e5e7eb;
        color: #374151;
        white-space: nowrap;
    }

    .btn-action-item:hover {
        background: #d1d5db;
    }

    .btn-urgent.active {
        background: #ef4444;
        color: white;
    }

    .btn-cancel {
        background: #fee2e2;
        color: #991b1b;
    }

    .btn-pickup {
        background: #22c55e;
        color: white;
        padding: 12px 32px;
        border-radius: 8px;
        font-size: 18px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        white-space: nowrap;
    }

    .btn-pickup:hover {
        background: #16a34a;
    }

    .badge-urgent {
        background: #ef4444;
        color: white;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        margin-left: 8px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .badge-urgent i {
        font-size: 12px;
    }

</style>

<div class="container-fluid p-0">
    @if (!string.IsNullOrEmpty(ViewData["ErrorMessage"] as string))
    {
        <div class="alert alert-danger m-3">@ViewData["ErrorMessage"]</div>
    }
    else
    {
        <!-- Header -->
        <header class="top-header">
            @{
                var currentUserName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Nhân viên";
                string avatarInitials = "NV";
                if (!string.IsNullOrWhiteSpace(currentUserName))
                {
                    var nameParts = currentUserName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    if (nameParts.Length > 0)
                    {
                        // Lấy 2 chữ cái đầu của từ cuối cùng (họ)
                        var lastName = nameParts[nameParts.Length - 1];
                        avatarInitials = lastName.Length >= 2 
                            ? lastName.Substring(0, 2).ToUpper() 
                            : lastName.Substring(0, 1).ToUpper();
                    }
                }
            }
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-circle me-2">@avatarInitials</div>
                    <div>
                        <h6 class="mb-0 text-white" style="font-size: 20px; font-weight: 700;">@currentUserName</h6>
                        <small style="font-size: 13px; color: rgba(255,255,255,0.8);">Màn hình phục vụ của bạn</small>
                    </div>
                </div>
                <div class="text-end text-white">
                    <div class="fw-bold" style="font-size: 36px;" id="currentTime"></div>
                    <small style="font-size: 12px; color: rgba(255,255,255,0.8);" id="currentDate"></small>
                </div>
            </div>

            <!-- Status Cards -->
            <div class="row g-3 mb-3">
                <div class="col-3">
                    <div class="status-card">
                        <div class="count" id="processingCount">@Model.ProcessingCount</div>
                        <div class="label">Đang xử lý</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="status-card">
                        <div class="count" id="waitingKitchenCount">@Model.WaitingKitchenCount</div>
                        <div class="label">Chờ bếp</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="status-card">
                        <div class="count" id="cookingCount">@Model.CookingCount</div>
                        <div class="label">Đang nấu</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="status-card">
                        <div class="count" id="readyCount">@Model.ReadyCount</div>
                        <div class="label">
                            Sẵn sàng lấy
                            <i class="fas fa-bell @(Model.ReadyCount > 0 ? "ringing" : "")" id="readyBellIcon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filter Buttons -->
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="d-flex gap-2">
                    <button class="filter-btn" data-filter="processing">Đang xử lý (<span id="filterProcessingCount">@Model.ProcessingCount</span>)</button>
                    <button class="filter-btn active" data-filter="all">Tất cả (<span id="filterTotalCount">@Model.TotalCount</span>)</button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-light" onclick="openTableFilterModal()" style="font-weight: 600;">
                        <i class="fas fa-filter"></i> Lọc theo bàn
                        <span id="selectedTablesCount" class="badge bg-primary ms-1" style="display: none;">0</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Main Content: Orders Grid (Card Layout giống màn hình bếp) -->
        <div class="p-4">
            <div class="orders-grid" id="ordersGrid">
                @if (Model.OrderGroups != null && Model.OrderGroups.Any())
                {
                    @foreach (var group in Model.OrderGroups)
                    {
                        var maxWaitingMinutes = group.Items.Any() ? group.Items.Max(i => i.WaitingMinutes) : 0;
                        var timerClass = maxWaitingMinutes > 15 ? "timer-critical" : (maxWaitingMinutes >= 10 ? "timer-warning" : "timer-normal");
                        var readyCount = group.Items.Count(i => 
                            (i.Status ?? "").ToLower().Contains("ready") || 
                            (i.Status ?? "").ToLower().Contains("sẵn sàng"));

                        // Món đã hoàn thành (Done / Hoàn thành / Xong)
                        var doneCount = group.Items.Count(i =>
                            (i.Status ?? "").ToLower().Contains("done") ||
                            (i.Status ?? "").ToLower().Contains("hoàn thành") ||
                            (i.Status ?? "").ToLower().Contains("xong"));

                        // Món đã hủy
                        var cancelledCount = group.Items.Count(i =>
                            (i.Status ?? "").ToLower().Contains("cancelled") ||
                            (i.Status ?? "").ToLower().Contains("hủy"));

                        var totalItems = group.Items.Count;

                        // Cho phép hoàn thành nếu KHÔNG còn món nào đang ở Pending/Cooking/Late...
                        // Tức là tất cả món đều nằm trong 3 nhóm: Ready, Done, Cancelled
                        var finishedCount = readyCount + doneCount + cancelledCount;
                        var canComplete = finishedCount == totalItems && totalItems > 0;
                        var hasUrgentItems = group.Items.Any(i => i.IsUrgent);
                        
                        <div class="order-card @(readyCount > 0 ? "has-ready" : "") @(hasUrgentItems ? "has-urgent" : "")" data-order-id="@group.OrderNumber">
                            <!-- Card Header -->
                            <div class="order-card-header @(readyCount > 0 ? "has-ready" : "")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="flex-grow-1">
                                        <div class="order-card-title">
                                            <span class="table-badge @(readyCount > 0 ? "has-ready" : "")">
                                                Bàn @group.TableNumber
                                            </span>
                                            <span style="font-size: 13px; color: #6b7280; font-weight: 500;">
                                                (#@group.OrderNumber)
                                            </span>
                                            <span>@group.AreaName</span>
                                        </div>
                                        <div class="order-card-subtitle">
                                            <i class="fas fa-users"></i> @group.NumberOfGuests khách
                                        </div>
                                        @if (hasUrgentItems)
                                        {
                                            <div class="order-card-urgent" style="margin-top: 8px; color: #ef4444; font-weight: 700; font-size: 14px;">
                                                <i class="fas fa-fire" style="margin-right: 4px;"></i> LÀM GẤP
                                            </div>
                                        }
                                    </div>
                                    @if (readyCount > 0)
                                    {
                                        <div class="d-flex align-items-center gap-2" style="background: #22c55e; color: white; padding: 8px 16px; border-radius: 6px;">
                                            <i class="fas fa-check-circle"></i>
                                            <span style="font-weight: 700; font-size: 14px;">CÓ MÓN XONG!</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Item List -->
                            <div class="item-list">
                                @foreach (var item in group.Items)
                                {
                                    var itemStatusLower = (item.Status ?? "").ToLower().Trim();
                                    var isDone = itemStatusLower.Contains("done") || itemStatusLower.Contains("hoàn thành") || itemStatusLower.Contains("xong");
                                    
                                    <div class="item-row-wrapper" data-item-status="@item.Status" data-is-done="@(isDone ? "true" : "false")">
                                    @{
                                        var statusClass = GetStatusClass(item.Status);
                                        var statusText = GetStatusText(item.Status);
                                        var isWaitingLong = item.WaitingMinutes > 60;
                                        var statusBtnClass = statusClass == "pending" ? "pending" : 
                                                            (statusClass == "cooking" ? "cooking" : 
                                                            (statusClass == "ready" ? "ready" : "served"));
                                        
                                        var isReady = itemStatusLower.Contains("ready") || itemStatusLower.Contains("sẵn sàng");
                                        var isPending = itemStatusLower.Contains("pending") || itemStatusLower.Contains("chờ") || itemStatusLower.Contains("chờ bếp");
                                        var isCooking = itemStatusLower.Contains("cooking") || itemStatusLower.Contains("chế biến") || itemStatusLower.Contains("đang nấu");
                                        var isReadyStatus = itemStatusLower.Contains("ready") || itemStatusLower.Contains("sẵn sàng");
                                        var isConsumptionBased = item.BillingType.HasValue && item.BillingType.Value == 1;
                                        // Chỉ hiển thị button xác nhận số lượng cho món ConsumptionBased (BillingType = 1) và chưa Done
                                        // Đảm bảo cả CanConfirmQuantity từ backend và isConsumptionBased đều phải true
                                        var canConfirmQuantity = isConsumptionBased && !isDone && item.CanConfirmQuantity;
                                        
                                        // Debug: Log để kiểm tra giá trị BillingType
                                        @* @if (item.MenuItemName.Contains("Rượu táo mèo"))
                                        {
                                            <script>
                                                console.log('Item: @item.MenuItemName', {
                                                    OrderDetailId: @item.OrderDetailId,
                                                    BillingType: @(item.BillingType.HasValue ? item.BillingType.Value.ToString() : "null"),
                                                    CanConfirmQuantity: @item.CanConfirmQuantity.ToString().ToLower(),
                                                    isConsumptionBased: @isConsumptionBased.ToString().ToLower(),
                                                    isDone: @isDone.ToString().ToLower(),
                                                    canConfirmQuantity: @canConfirmQuantity.ToString().ToLower()
                                                });
                                            </script>
                                        } *@
                                    }
                                    <div class="item-row @(isReady ? "ready" : "") @(item.IsUrgent ? "urgent" : "")"
                                         data-item-id="@item.OrderDetailId"
                                         data-combo-item-id="@(item.OrderComboItemId.HasValue ? item.OrderComboItemId.Value : 0)"
                                         data-billing-type="@(item.BillingType.HasValue ? item.BillingType.Value.ToString() : "")"
                                         data-quantity="@item.Quantity"
                                         data-quantity-used="@(item.QuantityUsed ?? item.Quantity)">
                                        <div class="item-info">
                                            <div class="item-name">
                                                <span class="item-quantity">x@(item.Quantity)</span>
                                                <span>@item.MenuItemName</span>
                                                @if (item.IsUrgent)
                                                {
                                                    <span class="badge-urgent"><i class="fas fa-fire"></i> LÀM GẤP</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(item.Notes))
                                            {
                                                <div class="item-notes">
                                                    <i class="fas fa-exclamation-triangle"></i> <strong>GHI CHÚ:</strong> @item.Notes
                                                </div>
                                            }
                                            <div class="item-time @(isWaitingLong ? "waiting-long" : "")">
                                                <i class="fas fa-clock"></i>
                                                <span>Thời gian order : @item.OrderTime.ToString("HH:mm")</span>                                         
                                            </div>
                                        </div>
                                        
                                        <div class="item-actions">
                                            <!-- Action Buttons + Status on same row for Pending/Cooking -->
                                            @if (isPending || isCooking)
                                            {
                                                <div class="action-buttons-row mb-2 d-flex align-items-center" style="gap: 8px;">
                                                    @if (item.CanRequestUrgent)
                                                    {
                                                        <button class="btn btn-urgent btn-action-item @(item.IsUrgent ? "active" : "")" 
                                                                onclick="event.stopPropagation(); requestUrgent(@item.OrderDetailId, @(item.OrderComboItemId.HasValue ? item.OrderComboItemId.Value : 0), @(item.IsUrgent.ToString().ToLower()))" 
                                                                title="@(item.IsUrgent ? "Hủy làm gấp" : "Làm gấp")">
                                                            <i class="fas fa-fire"></i>
                                                            @(item.IsUrgent ? "Hủy làm gấp" : "Làm gấp")
                                                        </button>
                                                    }
                                                    @if (item.CanCancel)
                                                    {
                                                        <button class="btn btn-cancel btn-action-item" 
                                                                onclick="event.stopPropagation(); cancelItem(@item.OrderDetailId, @(item.OrderComboItemId.HasValue ? item.OrderComboItemId.Value : 0))" 
                                                                title="Hủy món">
                                                            <i class="fas fa-times"></i>
                                                            Hủy món
                                                        </button>
                                                    }

                                                    @if (isPending)
                                                    {
                                                        <button class="item-status-btn pending">
                                                            <i class="fas fa-hourglass-half"></i>
                                                            <span>CHỜ</span>
                                                            <span style="font-size: 12px; color: #4b5563; margin-left: 4px;">
                                                                @item.WaitingMinutes phút
                                                            </span>
                                                        </button>
                                                    }
                                                    else if (isCooking)
                                                    {
                                                        <button class="item-status-btn cooking @(item.IsUrgent ? "urgent" : "")">
                                                            <i class="fas fa-utensils"></i> ĐANG NẤU
                                                            @if (item.IsUrgent)
                                                            {
                                                                <i class="fas fa-exclamation-circle"></i>
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            
                                            <!-- Món ConsumptionBased - Button XÁC NHẬN SỐ LƯỢNG (không cần chờ Ready) -->
                                            @if (canConfirmQuantity && !isDone)
                                            {
                                                var quantityInputId = $"quantity_{item.OrderDetailId}_{(item.OrderComboItemId ?? 0)}";
                                                var comboItemId = item.OrderComboItemId ?? 0;
                                                var menuItemNameEscaped = item.MenuItemName.Replace("'", "\\'");
                                                var currentQuantity = item.QuantityUsed ?? item.Quantity;
                                                var isInCombo = item.OrderComboItemId.HasValue && item.OrderComboItemId.Value > 0;
                                                
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (isInCombo)
                                                    {
                                                        <!-- Món trong combo: CHỈ hiển thị số lượng, KHÔNG cho phép chỉnh sửa -->
                                                        <span class="form-control" style="width: 80px; text-align: center; background-color: #f3f4f6; border-color: #d1d5db; color: #6b7280;">
                                                            @currentQuantity
                                                        </span>
                                                        <button class="btn-pickup" style="background: #10b981; border-color: #10b981; flex: 1;" 
                                                                onclick="event.stopPropagation(); openConfirmConsumptionQuantityModal(@item.OrderDetailId, @comboItemId, '@menuItemNameEscaped', @currentQuantity, @item.Quantity, @(item.QuantityUsed ?? 0))">
                                                            <i class="fas fa-check-circle"></i>
                                                            XÁC NHẬN
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <!-- Món lẻ: Cho phép tăng/giảm số lượng -->
                                                        <input type="number" 
                                                               id="@quantityInputId" 
                                                               class="form-control" 
                                                               style="width: 80px; text-align: center;" 
                                                               value="@currentQuantity" 
                                                               min="1" 
                                                               onchange="updateConsumptionQuantity(@item.OrderDetailId, @comboItemId, this.value)" />
                                                        <button class="btn-pickup" style="background: #10b981; border-color: #10b981; flex: 1;" 
                                                                onclick="event.stopPropagation(); openConfirmConsumptionQuantityModal(@item.OrderDetailId, @comboItemId, '@menuItemNameEscaped', @currentQuantity, @item.Quantity, @(item.QuantityUsed ?? 0))">
                                                            <i class="fas fa-check-circle"></i>
                                                            XÁC NHẬN
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            
                                            <!-- Ready Status - Button LẤY MÓN lớn (chỉ cho món KitchenPrepared) -->
                                            @if (isReadyStatus && !isConsumptionBased)
                                            {
                                                @if (item.IsSplit)
                                                {
                                                    <!-- Đã tách rồi: vẫn dùng popup để xác nhận giống món lẻ -->
                                                    <button class="btn-pickup" onclick="event.stopPropagation(); handleServed(@item.OrderDetailId, @(item.OrderComboItemId.HasValue ? item.OrderComboItemId.Value : 0), @item.Quantity)">
                                                        <i class="fas fa-check-circle"></i>
                                                        LẤY MÓN
                                                    </button>
                                                }
                                                else
                                                {
                                                    <!-- Chưa tách, cần popup để chọn số lượng -->
                                                        <button class="btn-pickup" onclick="event.stopPropagation(); handleServed(@item.OrderDetailId, @(item.OrderComboItemId.HasValue ? item.OrderComboItemId.Value : 0), @item.Quantity)">
                                                        <i class="fas fa-check-circle"></i>
                                                        LẤY MÓN
                                                    </button>
                                                }
                                            }
                                            
                                            <!-- Done Status -->
                                            @if (isDone)
                                            {
                                                <button class="item-status-btn done">
                                                    <i class="fas fa-check"></i> HOÀN THÀNH
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <div style="font-size: 80px; margin-bottom: 16px;">🎉</div>
                        <h3 style="font-size: 24px; font-weight: 700; color: #374151; margin-bottom: 8px;">Tuyệt vời!</h3>
                        <p style="color: #6b7280;">Bạn đã hoàn thành hết nhiệm vụ</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Modals -->
@await Html.PartialAsync("_UrgentModal")
@await Html.PartialAsync("_CancelModal")
@await Html.PartialAsync("_UrgentCancelModal")

<!-- Pickup Quantity Modal -->
<div class="modal fade" id="pickupQuantityModal" tabindex="-1" aria-labelledby="pickupQuantityModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pickupQuantityModalLabel">Xác nhận lấy món</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="pickupOrderDetailId" />
                <input type="hidden" id="pickupOrderComboItemId" />
                <div class="mb-3">
                    <label for="pickupMenuItemName" class="form-label">Món:</label>
                    <input type="text" class="form-control" id="pickupMenuItemName" readonly />
                </div>
                <div class="mb-3">
                    <label for="pickupQuantity" class="form-label">Số lượng lấy:</label>
                    <input type="number" class="form-control" id="pickupQuantity" min="1" value="1" />
                    <small class="form-text text-muted">Tối đa: <span id="pickupMaxQuantity">1</span> món</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="submitPickupRequest()">Xác nhận lấy món</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Consumption Quantity Modal -->
<div class="modal fade" id="confirmConsumptionQuantityModal" tabindex="-1" aria-labelledby="confirmConsumptionQuantityModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmConsumptionQuantityModalLabel">Xác nhận số lượng đã lấy</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="confirmConsumptionOrderDetailId" />
                <input type="hidden" id="confirmConsumptionOrderComboItemId" />
                <div class="mb-3">
                    <label for="confirmConsumptionMenuItemName" class="form-label">Món:</label>
                    <input type="text" class="form-control" id="confirmConsumptionMenuItemName" readonly />
                </div>
                <div class="mb-3">
                    <label for="confirmConsumptionQuantity" class="form-label">Số lượng đã lấy:</label>
                    <input type="number" class="form-control" id="confirmConsumptionQuantity" min="1" value="1" />
                    <small class="form-text text-muted">Số lượng đặt: <span id="confirmConsumptionOrderQuantity">1</span> | Đã lấy: <span id="confirmConsumptionQuantityUsed">0</span></small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" onclick="submitConfirmConsumptionQuantity()">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<!-- Table Filter Modal -->
<div class="modal fade" id="tableFilterModal" tabindex="-1" aria-labelledby="tableFilterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tableFilterModalLabel">Chọn bàn để lọc</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" id="tableSearchInput" class="form-control" placeholder="Tìm kiếm bàn..." onkeyup="filterTableOptions()">
                </div>
                <div id="tableFilterList" style="max-height: 400px; overflow-y: auto;">
                    <!-- Tables will be loaded here -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="clearTableFilter()">Xóa bộ lọc</button>
                <button type="button" class="btn btn-primary" onclick="applyTableFilter()">Áp dụng</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/waiterOrderTracking.js"></script>
<script>
    // Update time
    function updateTime() {
        const now = new Date();
        const timeEl = document.getElementById('currentTime');
        const dateEl = document.getElementById('currentDate');
        if (timeEl) {
            timeEl.textContent = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        }
        if (dateEl) {
            dateEl.textContent = now.toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        }
    }
    updateTime();
    setInterval(updateTime, 1000);

    // Filter buttons
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            const filter = this.getAttribute('data-filter');
            sessionStorage.setItem('waiterOrderFilter', filter);
            filterOrders(filter);
        });
    });
    
    // Khôi phục filter từ sessionStorage sau khi reload
    const savedFilter = sessionStorage.getItem('waiterOrderFilter') || 'all';
    document.querySelectorAll('.filter-btn').forEach(btn => {
        const filter = btn.getAttribute('data-filter');
        if (filter === savedFilter) {
            btn.classList.add('active');
        } else {
            btn.classList.remove('active');
        }
    });
    
    // Áp dụng filter đã lưu
    if (savedFilter) {
        filterOrders(savedFilter);
    }

    // Set API base URL
    window.API_BASE_URL = window.API_BASE_URL || '@ViewBag.ApiBaseUrl' || 'https://localhost:7096/api';
    // Base URL cho SignalR hub (tái sử dụng kitchenHub)
    window.SIGNALR_HUB_URL = window.SIGNALR_HUB_URL || (window.API_BASE_URL.replace('/api', '') + '/kitchenHub');

    // ===== SignalR cho WaiterOrderTracking =====
    let waiterSignalRConnection = null;

    async function initializeWaiterSignalR() {
        if (waiterSignalRConnection && waiterSignalRConnection.state !== signalR.HubConnectionState.Disconnected) {
            return;
        }

        try {
            waiterSignalRConnection = new signalR.HubConnectionBuilder()
                .withUrl(window.SIGNALR_HUB_URL, {
                    skipNegotiation: true,
                    transport: signalR.HttpTransportType.WebSockets
                })
                .withAutomaticReconnect()
                .build();

            // Khi món trong bếp đổi trạng thái -> reload lại dữ liệu waiter
            waiterSignalRConnection.on('ItemStatusChanged', async function () {
                try {
                    await reloadOrders();
                } catch (e) {
                    console.error('Error reloading orders from SignalR:', e);
                }
            });

            waiterSignalRConnection.on('OrderCompleted', async function () {
                try {
                    await reloadOrders();
                } catch (e) {
                    console.error('Error reloading orders from SignalR (OrderCompleted):', e);
                }
            });

            await waiterSignalRConnection.start();
            console.log('WaiterOrderTracking SignalR connected.');
        } catch (error) {
            console.error('Error initializing WaiterOrderTracking SignalR:', error);
        }
    }

    // Khởi tạo SignalR sau khi trang load xong
    document.addEventListener('DOMContentLoaded', function () {
        if (window.signalR && window.SIGNALR_HUB_URL) {
            initializeWaiterSignalR();
        }
    });

    // Store selected table IDs
    let selectedTableIds = [];
    let allTables = [];

    // Load danh sách bàn
    async function loadTables() {
        try {
            const response = await fetch(`${window.API_BASE_URL}/OrderTable`);
            if (response.ok) {
                allTables = await response.json();
                
                // Restore saved table filter
                const savedTableIds = sessionStorage.getItem('waiterTableFilter');
                if (savedTableIds) {
                    selectedTableIds = savedTableIds.split(',').filter(id => id).map(id => parseInt(id));
                    updateSelectedTablesCount();
                }
            }
        } catch (error) {
            console.error('Error loading tables:', error);
        }
    }

    // Open table filter modal
    function openTableFilterModal() {
        renderTableFilterList();
        const modal = new bootstrap.Modal(document.getElementById('tableFilterModal'));
        modal.show();
    }

    // Render table filter list
    function renderTableFilterList() {
        const container = document.getElementById('tableFilterList');
        if (!container || !allTables || allTables.length === 0) {
            container.innerHTML = '<p class="text-muted">Đang tải danh sách bàn...</p>';
            loadTables().then(() => renderTableFilterList());
            return;
        }

        // Group by area
        const groupedByArea = {};
        allTables.forEach(table => {
            const areaName = table.areaName || 'Khác';
            if (!groupedByArea[areaName]) {
                groupedByArea[areaName] = [];
            }
            groupedByArea[areaName].push(table);
        });

        let html = '';
        Object.keys(groupedByArea).sort().forEach(areaName => {
            html += `<div class="mb-3"><h6 class="fw-bold text-muted mb-2">${escapeHtml(areaName)}</h6>`;
            html += '<div class="d-flex flex-wrap gap-2">';
            groupedByArea[areaName].sort((a, b) => a.tableNumber.localeCompare(b.tableNumber)).forEach(table => {
                const isSelected = selectedTableIds.includes(table.tableId);
                html += `
                    <button type="button" 
                            class="btn ${isSelected ? 'btn-primary' : 'btn-outline-primary'} table-filter-btn" 
                            data-table-id="${table.tableId}"
                            onclick="toggleTableSelection(${table.tableId})">
                        Bàn ${escapeHtml(table.tableNumber)}
                    </button>
                `;
            });
            html += '</div></div>';
        });

        container.innerHTML = html;
    }

    // Toggle table selection
    function toggleTableSelection(tableId) {
        const index = selectedTableIds.indexOf(tableId);
        if (index > -1) {
            selectedTableIds.splice(index, 1);
        } else {
            selectedTableIds.push(tableId);
        }
        renderTableFilterList();
    }

    // Filter table options by search
    function filterTableOptions() {
        const searchTerm = document.getElementById('tableSearchInput').value.toLowerCase();
        const buttons = document.querySelectorAll('.table-filter-btn');
        buttons.forEach(btn => {
            const text = btn.textContent.toLowerCase();
            const areaSection = btn.closest('.mb-3');
            if (text.includes(searchTerm)) {
                btn.style.display = '';
                areaSection.style.display = '';
            } else {
                btn.style.display = 'none';
                // Hide area section if all buttons are hidden
                const visibleButtons = areaSection.querySelectorAll('.table-filter-btn[style=""]').length;
                if (visibleButtons === 0) {
                    areaSection.style.display = 'none';
                }
            }
        });
    }

    // Apply table filter
    async function applyTableFilter() {
        // Save to sessionStorage
        if (selectedTableIds.length > 0) {
            sessionStorage.setItem('waiterTableFilter', selectedTableIds.join(','));
        } else {
            sessionStorage.removeItem('waiterTableFilter');
        }
        
        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('tableFilterModal'));
        if (modal) {
            modal.hide();
        }
        
        // Reload orders via AJAX
        await reloadOrders(selectedTableIds);
        updateSelectedTablesCount();
    }

    // Clear table filter
    function clearTableFilter() {
        selectedTableIds = [];
        sessionStorage.removeItem('waiterTableFilter');
        renderTableFilterList();
        reloadOrders([]);
        updateSelectedTablesCount();
    }

    // Update selected tables count badge
    function updateSelectedTablesCount() {
        const badge = document.getElementById('selectedTablesCount');
        if (selectedTableIds.length > 0) {
            badge.textContent = selectedTableIds.length;
            badge.style.display = '';
        } else {
            badge.style.display = 'none';
        }
    }

    // Reload orders with table filter (AJAX, no page reload)
    async function reloadOrders(tableIds) {
        try {
            const tableIdsParam = tableIds.length > 0 ? tableIds.join(',') : '';
            const url = tableIdsParam 
                ? `${window.API_BASE_URL}/WaiterOrderTracking?tableIds=${tableIdsParam}`
                : `${window.API_BASE_URL}/WaiterOrderTracking`;
            
            const response = await fetch(url);
            const result = await response.json();
            
            if (result.success && result.data) {
                // Update counts
                document.getElementById('processingCount').textContent = result.data.processingCount || 0;
                document.getElementById('waitingKitchenCount').textContent = result.data.waitingKitchenCount || 0;
                document.getElementById('cookingCount').textContent = result.data.cookingCount || 0;
                document.getElementById('readyCount').textContent = result.data.readyCount || 0;
                document.getElementById('filterProcessingCount').textContent = result.data.processingCount || 0;
                document.getElementById('filterTotalCount').textContent = result.data.totalCount || 0;
                
                // Re-render orders
                renderOrders(result.data.orderGroups || []);
                
                // Re-initialize Bootstrap tooltips và các event handlers sau khi render lại
                // Đảm bảo CSS được áp dụng đúng
                requestAnimationFrame(() => {
                    // Apply status filter if active
                    const activeFilter = document.querySelector('.filter-btn.active')?.getAttribute('data-filter') || 'all';
                    filterOrders(activeFilter);
                    
                    // Force reflow để đảm bảo CSS được áp dụng
                    const grid = document.getElementById('ordersGrid');
                    if (grid) {
                        grid.offsetHeight; // Trigger reflow
                    }
                });
            }
        } catch (error) {
            console.error('Error reloading orders:', error);
            showToast('Lỗi khi tải lại đơn hàng: ' + error.message, 'error');
        }
    }

    // Render orders (client-side rendering)
    function renderOrders(orderGroups) {
        const grid = document.getElementById('ordersGrid');
        if (!orderGroups || orderGroups.length === 0) {
            grid.innerHTML = '<div class="empty-state"><p>Không có đơn hàng nào</p></div>';
            return;
        }
        
        let html = '';
        orderGroups.forEach(group => {
            const maxWaitingMinutes = group.items && group.items.length > 0 
                ? Math.max(...group.items.map(i => i.waitingMinutes || 0)) 
                : 0;
            const timerClass = maxWaitingMinutes > 15 ? "timer-critical" : (maxWaitingMinutes >= 10 ? "timer-warning" : "timer-normal");
            const readyCount = group.items ? group.items.filter(i => 
                (i.status || "").toLowerCase().includes("ready") || 
                (i.status || "").toLowerCase().includes("sẵn sàng")
            ).length : 0;

            const doneCount = group.items ? group.items.filter(i =>
                (i.status || "").toLowerCase().includes("done") ||
                (i.status || "").toLowerCase().includes("hoàn thành") ||
                (i.status || "").toLowerCase().includes("xong")
            ).length : 0;

            const cancelledCount = group.items ? group.items.filter(i =>
                (i.status || "").toLowerCase().includes("cancelled") ||
                (i.status || "").toLowerCase().includes("hủy")
            ).length : 0;

            const totalItems = group.items ? group.items.length : 0;
            // Cho phép hoàn thành nếu tất cả món đều ở trạng thái Ready/Sẵn sàng, Done/Hoàn thành hoặc Đã hủy
            const finishedCount = readyCount + doneCount + cancelledCount;
            const canComplete = finishedCount == totalItems && totalItems > 0;
            const hasUrgentItems = group.items ? group.items.some(i => i.isUrgent) : false;
            
            html += `
                <div class="order-card ${readyCount > 0 ? "has-ready" : ""} ${hasUrgentItems ? "has-urgent" : ""}" data-order-id="${group.orderNumber}">
                    <div class="order-card-header ${readyCount > 0 ? "has-ready" : ""}">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <div class="order-card-title">
                                    <span class="table-badge ${readyCount > 0 ? "has-ready" : ""}">Bàn ${escapeHtml(group.tableNumber || 'N/A')}</span>
                                    <span style="font-size: 13px; color: #6b7280; font-weight: 500;">(#${group.orderNumber})</span>
                                    <span>${escapeHtml(group.areaName || '')}</span>
                                </div>
                                <div class="order-card-subtitle">
                                    <i class="fas fa-users"></i> ${group.numberOfGuests || 0} khách
                                </div>
                                ${hasUrgentItems ? '<div class="order-card-urgent" style="margin-top: 8px; color: #ef4444; font-weight: 700; font-size: 14px;"><i class="fas fa-fire" style="margin-right: 4px;"></i> LÀM GẤP</div>' : ''}
                            </div>
                            ${readyCount > 0 ? '<div class="d-flex align-items-center gap-2" style="background: #22c55e; color: white; padding: 8px 16px; border-radius: 6px;"><i class="fas fa-check-circle"></i><span style="font-weight: 700; font-size: 14px;">CÓ MÓN XONG!</span></div>' : ''}
                        </div>
                    </div>
                    <div class="item-list">
            `;
            
            if (group.items && group.items.length > 0) {
                group.items.forEach(item => {
                    const itemStatusLower = (item.status || "").toLowerCase().trim();
                    const isDone = itemStatusLower.includes("done") || itemStatusLower.includes("hoàn thành") || itemStatusLower.includes("xong");
                    const statusClass = getStatusClassFromJS(item.status);
                    const statusText = getStatusTextFromJS(item.status);
                    const isWaitingLong = (item.waitingMinutes || 0) > 60;
                    const isConsumptionBased = item.billingType === 1 || item.billingType === "1";
                    // Chỉ hiển thị button xác nhận số lượng cho món ConsumptionBased (BillingType = 1)
                    const canConfirmQuantity = item.canConfirmQuantity && isConsumptionBased && !isDone;
                    
                    html += `
                        <div class="item-row-wrapper" data-item-status="${item.status || ''}" data-is-done="${isDone ? "true" : "false"}">
                            <div class="item-row" 
                                 data-item-id="${item.orderDetailId}"
                                 data-combo-item-id="${item.orderComboItemId || 0}"
                                 data-billing-type="${item.billingType || ''}"
                                 data-quantity="${item.quantity || 1}"
                                 data-quantity-used="${item.quantityUsed || item.quantity || 1}">
                                <div class="item-info">
                                    <div class="item-name">${escapeHtml(item.menuItemName || 'N/A')} x${item.quantity || 1}</div>
                                    ${item.notes ? `<div class="item-notes"><strong>Ghi chú:</strong> ${escapeHtml(item.notes)}</div>` : ''}
                                    <div class="item-time ${isWaitingLong ? "waiting-long" : ""}">
                                        <i class="fas fa-clock"></i>
                                        ${item.waitingMinutes || 0} phút
                                    </div>
                                </div>
                                <div class="item-status">
                                    <button class="item-status-btn ${statusClass} ${item.isUrgent ? "urgent" : ""}">
                                        ${statusText}
                                    </button>
                                </div>
                                <div class="item-actions">
                                    <div class="action-buttons-row">
                                        ${item.canCancel ? `<button class="btn-action-item btn-cancel" onclick="cancelItem(${item.orderDetailId}, ${item.orderComboItemId || 0})">Hủy</button>` : ''}
                                        ${item.canRequestUrgent ? `<button class="btn-action-item btn-urgent" onclick="requestUrgent(${item.orderDetailId}, ${item.orderComboItemId || 0}, ${item.isUrgent ? 'true' : 'false'})">${item.isUrgent ? 'Hủy gấp' : 'Làm gấp'}</button>` : ''}
                                        ${(item.canConfirmQuantity && isConsumptionBased && !isDone) ? `
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                ${(item.orderComboItemId && item.orderComboItemId > 0) ? `
                                                    <!-- Món trong combo: CHỈ hiển thị số lượng, KHÔNG cho phép chỉnh sửa -->
                                                    <span style="width: 80px; text-align: center; background-color: #f3f4f6; border: 1px solid #d1d5db; border-radius: 4px; padding: 6px 12px; color: #6b7280; font-weight: 500;">
                                                        ${item.quantityUsed || item.quantity || 1}
                                                    </span>
                                                ` : `
                                                    <!-- Món lẻ: Cho phép tăng/giảm số lượng -->
                                                    <input type="number" 
                                                           id="quantity_${item.orderDetailId}_${item.orderComboItemId || 0}" 
                                                           class="form-control" 
                                                           style="width: 80px; text-align: center; padding: 4px 8px;" 
                                                           value="${item.quantityUsed || item.quantity || 1}" 
                                                           min="1" 
                                                           onchange="updateConsumptionQuantity(${item.orderDetailId}, ${item.orderComboItemId || 0}, this.value)" />
                                                `}
                                                <button class="btn-action-item btn-pickup" style="background: #10b981; border-color: #10b981; flex: 1;" 
                                                        onclick="openConfirmConsumptionQuantityModal(${item.orderDetailId}, ${item.orderComboItemId || 0}, '${(item.menuItemName || '').replace(/'/g, "\\'")}', ${item.quantityUsed || item.quantity || 1}, ${item.quantity || 1}, ${item.quantityUsed || 0})">
                                                    Xác nhận
                                                </button>
                                            </div>
                                        ` : ''}
                                        ${item.status && (item.status.toLowerCase().includes("ready") || item.status.toLowerCase().includes("sẵn sàng")) && item.billingType !== 1 ? `<button class="btn-action-item btn-pickup" onclick="handleServed(${item.orderDetailId}, ${item.orderComboItemId || 0}, ${item.quantity || 1})">Lấy món</button>` : ''}
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                });
            }
            
            html += `
                    </div>
                    ${canComplete ? '<div class="order-complete-section"><button class="order-complete-badge" onclick="completeOrderItems(' + (group.orderNumber || '').replace('A', '') + ')">Hoàn thành đơn</button></div>' : ''}
                </div>
            `;
        });
        
        // Sử dụng requestAnimationFrame để đảm bảo CSS được áp dụng đúng sau khi render
        requestAnimationFrame(() => {
            grid.innerHTML = html;
            
            // Force reflow sau khi set innerHTML để đảm bảo CSS được áp dụng
            // Điều này giúp trình duyệt tính toán lại layout và áp dụng CSS
            void grid.offsetHeight;
        });
    }

    function getStatusClassFromJS(status) {
        const statusLower = (status || "").toLowerCase().trim();
        if (statusLower.includes("cooking") || statusLower.includes("chế biến") || statusLower.includes("đang nấu")) return "cooking";
        if (statusLower.includes("ready") || statusLower.includes("sẵn sàng")) return "ready";
        if (statusLower.includes("cancelled") || statusLower.includes("hủy") || statusLower.includes("đã hủy")) return "cancelled";
        if (statusLower.includes("pending") || statusLower.includes("chờ") || statusLower.includes("chờ bếp")) return "pending";
        if (statusLower.includes("late") || statusLower.includes("trễ")) return "late";
        if (statusLower.includes("done") || statusLower.includes("hoàn thành") || statusLower.includes("xong")) return "done";
        return "";
    }

    function getStatusTextFromJS(status) {
        const statusLower = (status || "").toLowerCase().trim();
        if (statusLower.includes("pending") || statusLower.includes("chờ") || statusLower.includes("chờ bếp")) return "CHỜ";
        if (statusLower.includes("cooking") || statusLower.includes("chế biến") || statusLower.includes("đang nấu")) return "ĐANG NẤU";
        if (statusLower.includes("ready") || statusLower.includes("sẵn sàng")) return "SẴN SÀNG";
        if (statusLower.includes("late") || statusLower.includes("trễ")) return "TRỄ";
        if (statusLower.includes("cancelled") || statusLower.includes("hủy") || statusLower.includes("đã hủy")) return "ĐÃ HỦY";
        if (statusLower.includes("done") || statusLower.includes("hoàn thành") || statusLower.includes("xong")) return "HOÀN THÀNH";
        return "CHỜ";
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Complete order items (mark all ready items as done)
    async function completeOrderItems(orderId) {
        if (!confirm('Xác nhận đã lấy tất cả món sẵn sàng và hoàn thành đơn này?')) {
            return;
        }

        try {
            // Get current orders to find ready items
            const savedTableIds = sessionStorage.getItem('waiterTableFilter');
            const tableIds = savedTableIds ? savedTableIds.split(',').filter(id => id).map(id => parseInt(id)) : [];
            const tableIdsParam = tableIds.length > 0 ? tableIds.join(',') : '';
            const url = tableIdsParam 
                ? `${window.API_BASE_URL}/WaiterOrderTracking?tableIds=${tableIdsParam}`
                : `${window.API_BASE_URL}/WaiterOrderTracking`;
            
            const response = await fetch(url);
            const result = await response.json();
            
            if (!result.success || !result.data) {
                showToast('Không thể tải dữ liệu đơn hàng', 'error');
                return;
            }

            // Find order and ready items
            const orderGroup = result.data.orderGroups?.find(g => g.orderNumber === `A${orderId.toString().padStart(2, '0')}`);
            if (!orderGroup || !orderGroup.items) {
                showToast('Không tìm thấy đơn hàng', 'error');
                return;
            }

            const readyItems = orderGroup.items.filter(item => 
                item.status && (item.status.toLowerCase().includes("ready") || item.status.toLowerCase().includes("sẵn sàng"))
            );

            if (readyItems.length === 0) {
                showToast('Không có món nào sẵn sàng để lấy', 'error');
                return;
            }

            // Mark all ready items as served
            let successCount = 0;
            for (const item of readyItems) {
                try {
                    const serveResponse = await fetch(`${window.API_BASE_URL}/WaiterOrderTracking/mark-as-served`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            orderDetailId: item.orderDetailId,
                            orderComboItemId: item.orderComboItemId || null,
                            quantity: item.quantity || 1
                        })
                    });
                    const serveResult = await serveResponse.json();
                    if (serveResult.success) {
                        successCount++;
                    }
                } catch (error) {
                    console.error('Error marking item as served:', error);
                }
            }

            if (successCount > 0) {
                showToast(`Đã đánh dấu ${successCount} món đã phục vụ`, 'success');
                // Reload orders
                await reloadOrders(tableIds);
            } else {
                showToast('Không thể đánh dấu món đã phục vụ', 'error');
            }
        } catch (error) {
            console.error('Error completing order:', error);
            showToast('Lỗi: ' + error.message, 'error');
        }
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', async () => {
        await loadTables();
        updateSelectedTablesCount();
        
        // Apply saved filter on initial load
        const savedTableIds = sessionStorage.getItem('waiterTableFilter');
        if (savedTableIds) {
            const tableIds = savedTableIds.split(',').filter(id => id).map(id => parseInt(id));
            if (tableIds.length > 0) {
                await reloadOrders(tableIds);
            }
        }
        
        // Auto-refresh every 30 seconds
        setInterval(() => {
            const savedTableIds = sessionStorage.getItem('waiterTableFilter');
            const tableIds = savedTableIds ? savedTableIds.split(',').filter(id => id).map(id => parseInt(id)) : [];
            reloadOrders(tableIds);
        }, 30000);
    });

    // Filter orders
    function filterOrders(filterType) {
        console.log('Filtering by:', filterType);
        
        const itemRows = document.querySelectorAll('.item-row-wrapper');
        console.log('Total items found:', itemRows.length);
        
        let doneCount = 0;
        let processingCount = 0;
        
        itemRows.forEach((itemRow, index) => {
            const isDoneAttr = itemRow.getAttribute('data-is-done');
            const isDone = isDoneAttr === 'true';
            
            if (index < 5) {
                console.log(`Item ${index}: data-is-done="${isDoneAttr}", isDone=${isDone}`);
            }
            
            if (filterType === 'all') {
                // Hiển thị tất cả items
                itemRow.style.display = '';
                itemRow.style.visibility = '';
                itemRow.classList.remove('filtered-out');
            } else if (filterType === 'processing') {
                // Ẩn các items có status "Done"
                if (isDone) {
                    itemRow.style.display = 'none';
                    itemRow.style.visibility = 'hidden';
                    itemRow.classList.add('filtered-out');
                    doneCount++;
                } else {
                    itemRow.style.display = '';
                    itemRow.style.visibility = '';
                    itemRow.classList.remove('filtered-out');
                    processingCount++;
                }
            }
        });
        
        console.log(`Done items: ${doneCount}, Processing items: ${processingCount}`);
        
        // Không ẩn order cards, chỉ ẩn items Done bên trong
        // Order cards luôn hiển thị, chỉ items bên trong bị ẩn
        const orderCards = document.querySelectorAll('.order-card');
        orderCards.forEach(card => {
            // Luôn hiển thị card
            card.style.display = '';
        });
        
        console.log('Filter applied - Only items are filtered, cards remain visible');
    }

    // Search orders
    const searchInput = document.getElementById('searchOrders');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            const cards = document.querySelectorAll('.order-group-card');
            cards.forEach(card => {
                const text = card.textContent.toLowerCase();
                card.style.display = text.includes(searchTerm) ? 'block' : 'none';
            });
        });
    }
</script>

