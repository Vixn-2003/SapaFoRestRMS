    function getIngredientStatusBadge(status) {
        const statusMap = {
            'expired': '<span class="audit-ingredient-status-badge audit-ingredient-status-expired">Hết hạn</span>',
            'expiring': '<span class="audit-ingredient-status-badge audit-ingredient-status-expiring">Sắp hết hạn</span>',
            'normal': '<span class="audit-ingredient-status-badge audit-ingredient-status-normal">Bình thường</span>'
        };
        return statusMap[status] || statusMap['normal'];
    }

    function formatNumber(value) {
        if (value === null || value === undefined) return '0,00';
        return parseFloat(value).toLocaleString('de-DE', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    async function confirmAudit(auditId) {
        const confirmBtn = document.getElementById('confirmBtn');
        const checkbox = document.getElementById('confirmCheckbox');

        if (!checkbox.checked) {
            alert('Vui lòng xác nhận bằng cách check vào ô checkbox!');
            return;
        }

        // Hiển thị popup xác nhận tùy chỉnh
        const isConfirmed = await showConfirmModal({
            type: 'success',
            icon: '✅',
            title: 'Xác nhận đơn kiểm kê',
            message: 'Bạn có chắc chắn muốn XÁC NHẬN đơn kiểm kê này?',
            warning: null,
            buttonText: 'Xác nhận',
            buttonClass: 'confirm-modal-btn-confirm'
        });

        if (!isConfirmed) return;

        // Disable button để tránh click nhiều lần
        confirmBtn.disabled = true;
        confirmBtn.textContent = '⏳ Đang xử lý...';

        try {
            // Lấy thông tin người xác nhận từ session
            const currentUser = await getCurrentUserFromSession();

            const requestData = {
                auditId: auditId,
                auditStatus: 'completed',
                confirmerId: currentUser.userId,
                confirmerName: currentUser.fullName,
                confirmerPhone: currentUser.phone,
                confirmerPosition: currentUser.position,
                confirmedAt: new Date().toLocaleString('vi-VN')
            };

            console.log('Sending confirm request:', requestData);

            const response = await fetch(`/AuditInventory/ConfirmAudit/${auditId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(requestData)
            });

            const result = await response.json();

            if (result.success) {
                // Show success modal
                await showConfirmModal({
                    type: 'success',
                    icon: '🎉',
                    title: 'Thành công!',
                    message: 'Xác nhận đơn kiểm kê thành công!',
                    warning: null,
                    buttonText: '✅ Đóng',
                    buttonClass: 'confirm-modal-btn-confirm'
                });
                closeAuditModal();
                location.reload();
            } else {
                // Show error modal
                await showConfirmModal({
                    type: 'danger',
                    icon: '❌',
                    title: 'Lỗi',
                    message: result.message || 'Không thể xác nhận đơn kiểm kê',
                    warning: null,
                    buttonText: '❌ Đóng',
                    buttonClass: 'confirm-modal-btn-reject'
                });
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '✅ Xác nhận';
            }
        } catch (error) {
            console.error('Error confirming audit:', error);
            await showConfirmModal({
                type: 'danger',
                icon: '❌',
                title: 'Lỗi',
                message: 'Có lỗi xảy ra khi xác nhận: ' + error.message,
                warning: null,
                buttonText: '❌ Đóng',
                buttonClass: 'confirm-modal-btn-reject'
            });
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = '✅ Xác nhận';
        }
    }

    async function rejectAudit(auditId) {
        const rejectBtn = document.getElementById('rejectBtn');
        const checkbox = document.getElementById('confirmCheckbox');

        if (!checkbox.checked) {
            alert('Vui lòng xác nhận bằng cách check vào ô checkbox!');
            return;
        }

        // Hiển thị popup xác nhận tùy chỉnh
        const isConfirmed = await showConfirmModal({
            type: 'danger',
            icon: '⚠️',
            title: 'Từ chối đơn kiểm kê',
            message: 'Bạn có chắc chắn muốn TỪ CHỐI đơn kiểm kê này?',
            warning: '⚠️ Hành động này không thể hoàn tác!',
            buttonText: '❌ Từ chối',
            buttonClass: 'confirm-modal-btn-reject'
        });

        if (!isConfirmed) return;

        // Disable button để tránh click nhiều lần
        rejectBtn.disabled = true;
        rejectBtn.textContent = '⏳ Đang xử lý...';

        try {
            // Lấy thông tin người xử lý từ session
            const currentUser = await getCurrentUserFromSession();

            const requestData = {
                auditId: auditId,
                auditStatus: 'cancelled',
                confirmerId: currentUser.userId,
                confirmerName: currentUser.fullName,
                confirmerPhone: currentUser.phone,
                confirmerPosition: currentUser.position,
                confirmedAt: new Date().toISOString()
            };

            console.log('Sending reject request:', requestData);

            const response = await fetch(`/AuditInventory/ConfirmAudit/${auditId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(requestData)
            });

            const result = await response.json();

            if (result.success) {
                // Show success modal
                await showConfirmModal({
                    type: 'success',
                    icon: '✅',
                    title: 'Thành công!',
                    message: 'Từ chối đơn kiểm kê thành công!',
                    warning: null,
                    buttonText: '✅ Đóng',
                    buttonClass: 'confirm-modal-btn-confirm'
                });
                closeAuditModal();
                location.reload();
            } else {
                // Show error modal
                await showConfirmModal({
                    type: 'danger',
                    icon: '❌',
                    title: 'Lỗi',
                    message: result.message || 'Không thể từ chối đơn kiểm kê',
                    warning: null,
                    buttonText: '❌ Đóng',
                    buttonClass: 'confirm-modal-btn-reject'
                });
                rejectBtn.disabled = false;
                rejectBtn.innerHTML = '❌ Từ chối';
            }
        } catch (error) {
            console.error('Error rejecting audit:', error);
            await showConfirmModal({
                type: 'danger',
                icon: '❌',
                title: 'Lỗi',
                message: 'Có lỗi xảy ra khi từ chối: ' + error.message,
                warning: null,
                buttonText: '❌ Đóng',
                buttonClass: 'confirm-modal-btn-reject'
            });
            rejectBtn.disabled = false;
            rejectBtn.innerHTML = '❌ Từ chối';
        }
    }

