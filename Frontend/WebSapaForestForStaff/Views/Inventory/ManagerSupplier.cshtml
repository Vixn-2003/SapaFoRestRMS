                    <h3 class="sm-modal-title">Thêm nhà cung cấp mới</h3>
                    <div class="sm-modal-body-group">
                        <div class="sm-modal-form-grid">
                            <div>
                                <label class="sm-form-label" for="add-code">Mã nhà cung cấp</label>
                                <input type="text" id="add-code" class="sm-form-input" placeholder="NCC001" />
