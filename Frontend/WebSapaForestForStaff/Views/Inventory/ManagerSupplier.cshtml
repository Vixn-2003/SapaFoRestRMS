    <script>
        document.addEventListener('DOMContentLoaded', () => {

            // ====================================================================
            // ===== I. CONFIGURATION & UTILITY FUNCTIONS (Hàm tiện ích) =====
            // ====================================================================

            const $ = selector => document.querySelector(selector);
            const $$ = selector => document.querySelectorAll(selector);

            // --- CẤU HÌNH API ENDPOINTS (Trỏ tới Controller Proxy C#) ---
            const ENDPOINTS = {
                // Trỏ tới GET /ManagerSupplier/Summary
                SUMMARY_LIST: '/ManagerSupplier/Summary',
                // Trỏ tới GET /ManagerSupplier/OrdersHistory/{id}
                ORDERS_HISTORY: (id) => `/ManagerSupplier/OrdersHistory/${id}`,
                // Trỏ tới GET /ManagerSupplier/ProductsSupplied/{id}
                PRODUCTS_SUPPLIED: (id) => `/ManagerSupplier/ProductsSupplied/${id}`,
                // Top Suppliers (Cần thêm proxy này nếu muốn dùng)
                TOP_BY_VALUE: (start, end) => `/ManagerSupplier/TopByValue?startDate=${start}&endDate=${end}`
            };

            // --- Fetch Utility ---
            async function fetchData(url) {
                try {
                    // Thêm một lớp loading UI ở đây nếu cần
                    const response = await fetch(url);
                    if (!response.ok) {
                        throw new Error(`Lỗi HTTP ${response.status}: Không thể tải dữ liệu.`);
                    }
                    return await response.json();
                } catch (error) {
                    console.error("Fetch API failed:", url, error);
                    alert(`Lỗi tải dữ liệu (${url.split('?')[0].split('/').pop()}): ${error.message}`);
                    return null;
                }
            }

            // --- Formatting Utils ---
            function formatCurrency(num) { return num.toLocaleString('vi-VN'); }
            function formatMillion(num) { return (num / 1000000).toFixed(1) + 'M'; }


            // ====================================================================
            // ===== II. STATE MANAGEMENT & RENDER FLOW =====
            // ====================================================================

            // Dữ liệu gốc và trạng thái
            let SUPPLIERS_DATA = [];
            let state = {
                activeTab: 'list',
                detailSubTab: 'orders',
                selectedSupplier: null,
                searchTerm: '',
                filterStatus: 'all',
                showAddModal: false,
                topPeriod: 'month',
                orderHistory: [],
                ingredients: [],
                topSuppliers: [] // Dữ liệu Top Suppliers (cần API Proxy)
            };

            function setState(newState) {
                state = { ...state, ...newState };
                render();
            }

            // Hàm render chính (Giữ nguyên)
            function render() {
                const listTab = $('#sm-tab-list');
                const detailTab = $('#sm-tab-detail');
                const modal = $('#sm-add-modal');

                listTab.style.display = state.activeTab === 'list' ? 'block' : 'none';
                detailTab.style.display = state.activeTab === 'detail' ? 'block' : 'none';
                modal.style.display = state.showAddModal ? 'flex' : 'none';

                if (state.activeTab === 'list') {
                    renderSupplierListContent();
                } else if (state.activeTab === 'detail' && state.selectedSupplier) {
                    renderSupplierDetailContent();
                    // Logic render SubContent sẽ nằm trong renderSupplierDetailContent
                }
            }

            // ====================================================================
            // ===== III. DATA FETCHING & UI UPDATES (Logic Tích hợp API) =====
            // ====================================================================

            // --- A. Fetch và Render Danh sách Tổng hợp (Thay thế khởi tạo) ---
            async function fetchAndInitializeData() {
                // Lấy danh sách tổng hợp
                const summaryData = await fetchData(ENDPOINTS.SUMMARY_LIST);
                if (summaryData) {
                    // Ghi đè SUPPLIERS_DATA với dữ liệu thật
                    window.SUPPLIERS_DATA = summaryData;
                } else {
                    // Nếu fetch lỗi, đặt dữ liệu rỗng để UI hiển thị "Không tìm thấy"
                    window.SUPPLIERS_DATA = [];
                }

                // Lấy Top Suppliers (Khó khăn khi thiếu logic tính ngày trong JS)
                // Tạm thời bỏ qua fetch Top Suppliers thực tế nếu chưa có API Proxy tính ngày
                // Để tránh lỗi Reference, ta có thể gọi render() luôn
                render();
            }

            // --- B. Fetch Dữ liệu Chi tiết khi chuyển View ---
            async function fetchDetailData(supplierId, subTab) {
                // Đặt nội dung Loading
                renderSubContent(); // Hiển thị loading

                let data = null;
                if (subTab === 'orders') {
                    data = await fetchData(ENDPOINTS.ORDERS_HISTORY(supplierId));
                    if (data) {
                        // Cập nhật state KHÔNG gọi render toàn bộ
                        state.orderHistory = data;
                        renderSubContent(); // Chỉ render lại sub-content
                    }
                } else if (subTab === 'products') {
                    data = await fetchData(ENDPOINTS.PRODUCTS_SUPPLIED(supplierId));
                    if (data) {
                        state.ingredients = data;
                        renderSubContent(); // Chỉ render lại sub-content
                    }
                }
                // Stats tab là static, không cần fetch
            }


            // ====================================================================
            // ===== IV. RENDER FUNCTIONS (Đã Cập Nhật Logic) =====
            // ====================================================================

            /** Lọc danh sách nhà cung cấp dựa trên state */
            function filterSuppliers() {
                // Dùng SUPPLIERS_DATA toàn cục
                return window.SUPPLIERS_DATA.filter(s => {
                    const matchSearch = s.name.toLowerCase().includes(state.searchTerm.toLowerCase()) ||
                        s.code.toLowerCase().includes(state.searchTerm.toLowerCase());
                    // Giả định isActive được trả về từ API
                    const matchFilter = state.filterStatus === 'all' ||
                        (state.filterStatus === 'active' && s.isActive) ||
                        (state.filterStatus === 'inactive' && !s.isActive);
                    return matchSearch && matchFilter;
                });
            }

            /** Render nội dung cho Tab Danh sách (Sử dụng dữ liệu thực) */
            function renderSupplierListContent() {
                // Cập nhật Stats Cards
                const total = SUPPLIERS_DATA.length;
                const activeCount = SUPPLIERS_DATA.filter(s => s.isActive).length;
                const inactiveCount = total - activeCount;
                const activePercent = total > 0 ? ((activeCount / total) * 100).toFixed(0) : 0;

                $('#stat-total-suppliers').textContent = total;
                $('#stat-active-suppliers').textContent = activeCount;
                $('#stat-inactive-suppliers').textContent = inactiveCount;
                $('#stat-active-percent').textContent = activePercent + '% tổng số';

                // Cập nhật Top Suppliers
                renderTopSuppliers(state.topPeriod);

                const filteredSuppliers = filterSuppliers();
                const container = $('#sm-supplier-cards-container');
                let html = '';

                if (filteredSuppliers.length === 0) {
                    html = `<div style="text-align: center; color: #6b7280; padding: 40px; background: white; border-radius: 8px;">Không tìm thấy nhà cung cấp phù hợp.</div>`;
                } else {
                    html = filteredSuppliers.map(supplier => `
                    <div class="sm-supplier-card" data-supplier-id="${supplier.id}">
                        <div class="sm-card-content-wrapper">
                            <div class="sm-card-main-info">
                                <div class="sm-card-title-group">
                                    <h3 class="sm-card-title-h3">${supplier.name}</h3>
                                    <span class="sm-card-code">(${supplier.code})</span>
                                    <span class="sm-status-tag ${supplier.isActive ? 'sm-tag-active' : 'sm-tag-inactive'}">
                                        ${supplier.isActive ? 'Hoạt động' : 'Tạm ngưng'}
                                    </span>
                                </div>
                                <div class="sm-contact-grid">
                                    <div>
                                        <p><span>Người liên hệ:</span> ${supplier.contact || 'N/A'}</p>
                                        <p><span>Điện thoại:</span> ${supplier.phone || 'N/A'}</p>
                                        <p><span>Email:</span> ${supplier.email || 'N/A'}</p>
                                    </div>
                                    <div>
                                        <p><span>Địa chỉ:</span> ${supplier.address || 'N/A'}</p>
                                        <p><span>Đơn hàng cuối:</span> ${supplier.lastOrder ? new Date(supplier.lastOrder).toLocaleDateString() : 'N/A'}</p>
                                    </div>
                                </div>
                                <div class="sm-stats-footer">
                                    <div class="sm-stat-item sm-blue">
                                        <svg class="sm-card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z"/></svg>
                                        <span><strong>${supplier.totalOrders}</strong> đơn hàng</span>
                                    </div>
                                    <div class="sm-stat-item sm-green">
                                        <svg class="sm-card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M7 15h10v2H7zM19 19H5V5h14v14zm-9-9h4v2h-4v-2zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg>
                                        <span><strong>${formatMillion(supplier.totalValue)}</strong> VNĐ</span>
                                    </div>
                                </div>
                            </div>
                            <div class="sm-action-buttons">
                                <button class="sm-action-btn sm-btn-view" title="Xem chi tiết" onclick="viewSupplierDetail(${supplier.id})">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                </button>
                                <button class="sm-action-btn sm-btn-edit" title="Chỉnh sửa"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>
                                <button class="sm-action-btn sm-btn-power ${supplier.isActive ? 'active' : 'inactive'}" title="${supplier.isActive ? 'Tạm ngưng' : 'Kích hoạt'}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.36 6.64a9 9 0 1 1-12.73 0M12 2v10"/></svg></button>
                                <button class="sm-action-btn sm-btn-delete" title="Xóa"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 11v6M14 11v6M2 6h20M5 6l1.5 14h11L19 6M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg></button>
                            </div>
                        </div>
                    </div>
                `).join('');
                }
                container.innerHTML = html;
            }


            /** Render Top Suppliers List (Vẫn dùng mock data tạm thời) */
            function renderTopSuppliers(period) {
                // Cần API Proxy /ManagerSupplier/TopByValue để fetch dữ liệu thật
                // Tạm thời, giữ nguyên logic render với mock data cấu trúc
                const TOP_SUPPLIERS_DATA_MOCK = {
                    month: [
                        { name: 'Công ty Thực phẩm Tươi Sống', value: 125000000, orders: 45, code: 'NCC253' },
                        { name: 'Nhà cung cấp Rau Củ Đà Lạt', value: 89000000, orders: 38, code: 'NCC256' },
                        { name: 'Công ty Thủy sản Biển Đông', value: 67000000, orders: 22, code: 'NCC250' }
                    ]
                };
                const suppliers = TOP_SUPPLIERS_DATA_MOCK[period] || [];
                const container = $('#sm-top-suppliers-list');

                $('#sm-top-period-select').value = period;

                let html = suppliers.map((supplier, index) => {
                    const rankClass = index === 0 ? 'rank-1' : index === 1 ? 'rank-2' : 'rank-3';
                    const value = formatMillion(supplier.value);

                    return `
                            <div class="sm-list-item">
                                <div class="sm-rank-content">
                                    <div class="sm-rank-badge ${rankClass}">${index + 1}</div>
                                    <div class="sm-rank-info">
                                                <p class="sm-rank-name">${supplier.name} (${supplier.code})</p >
                                        <p class="sm-rank-orders">${supplier.orders} đơn hàng</p>
                                    </div>
                                    <span class="sm-rank-value">${value}</span>
                                </div>
                            </div>
                        `;
                }).join('');

                container.innerHTML = html;
            }

            /** Render cấu trúc Detail và gọi fetch dữ liệu chi tiết */
            function renderSupplierDetailContent() {
                const supplier = state.selectedSupplier;
                const detailTab = $('#sm-tab-detail');

                if (!supplier) return;

                // HTML cấu trúc Detail View: Header, Stats Cards mock, Tabs
                let html = `
                        <div class="sm-list-controls">
                            <div>
                                <button class="sm-back-btn" onclick="goToSupplierList()">&larr; Quay lại danh sách</button>
                                <h2 class="sm-detail-title">${supplier.name}</h2>
                                <p class="sm-detail-code">${supplier.code}</p>
                            </div>
                            <div class="sm-detail-header-actions">
                                <button class="sm-detail-action-btn">Chỉnh sửa</button>
                                <button class="sm-detail-action-btn sm-primary">Tạo đơn hàng</button>
                            </div>
                        </div>

                        <div class="sm-stats-grid">
                            <div class="sm-stat-card sm-detail-stat-card sm-detail-card-blue">
                                 <div class="sm-card-header"><span class="sm-card-label">Tổng đơn hàng</span><svg class="sm-card-icon sm-icon-blue" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2z"/></svg></div>
                                 <p class="sm-detail-stat-value sm-detail-value-blue">${supplier.totalOrders}</p>
                                 <p class="sm-stat-subtext">Đã thống kê</p>
                            </div>
                             <div class="sm-stat-card sm-detail-stat-card sm-detail-card-green">
                                 <div class="sm-card-header"><span class="sm-card-label">Tổng giá trị</span><svg class="sm-card-icon sm-icon-green" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79h6.79v-2h-8.89c.73-3.08 3.51-5.3 6.89-5.3s6.16 2.22 6.89 5.3H11v2h8.8c.13.58.2 1.17.2 1.79 0 4.08-3.05 7.44-7 7.93z"/></svg></div>
                                 <p class="sm-detail-stat-value sm-detail-value-green">${formatMillion(supplier.totalValue)}</p>
                                 <p class="sm-stat-subtext">VNĐ năm nay</p>
                            </div>
                            <div class="sm-stat-card sm-detail-stat-card sm-detail-card-orange">
                                 <div class="sm-card-header"><span class="sm-card-label">Đúng hạn</span><svg class="sm-card-icon sm-icon-orange" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg></div>
                                 <p class="sm-detail-stat-value sm-detail-value-orange">N/A</p>
                                 <p class="sm-stat-subtext">Chưa thống kê</p>
                            </div>
                            <div class="sm-stat-card sm-detail-stat-card sm-detail-card-purple">
                                 <div class="sm-card-header"><span class="sm-card-label">Tần suất</span><svg class="sm-card-icon sm-icon-purple" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/></svg></div>
                                 <p class="sm-detail-stat-value sm-detail-value-purple">N/A</p>
                                 <p class="sm-stat-subtext">Đơn/tháng</p>
                            </div>
                        </div>

                        <div class="sm-tabs-bar">
                            <div class="sm-tabs-group">
                                <button class="sm-tab-btn ${state.detailSubTab === 'orders' ? 'sm-active-tab' : ''}" data-sub-tab="orders">Lịch sử đơn hàng</button>
                                <button class="sm-tab-btn ${state.detailSubTab === 'products' ? 'sm-active-tab' : ''}" data-sub-tab="products">Danh mục sản phẩm</button>
                                <button class="sm-tab-btn ${state.detailSubTab === 'stats' ? 'sm-active-tab' : ''}" data-sub-tab="stats">Thống kê & Báo cáo</button>
                            </div>
                        </div>

                        <div id="sm-detail-sub-content"></div>
                    `;
                detailTab.innerHTML = html;

                // Gắn sự kiện tab
                detailTab.querySelectorAll('.sm-tab-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const newSubTab = e.target.dataset.subTab;
                        // Chỉ gọi setState và fetch nếu tab thay đổi
                        if (newSubTab !== state.detailSubTab) {
                            setState({ detailSubTab: newSubTab });
                            fetchDetailData(supplier.id, newSubTab);
                        }
                    });
                });

                // Gọi fetch cho tab mặc định (orders)
                renderSubContent(); // Render loading state
                fetchDetailData(supplier.id, state.detailSubTab);
            }

            /** Render nội dung cho Sub Tabs (Sử dụng state.orderHistory và state.ingredients) */
            function renderSubContent() {
                const subContentContainer = $('#sm-detail-sub-content');
                if (!subContentContainer) return;

                const tab = state.detailSubTab;
                let content = '';

                // Hiển thị loading nếu chưa có dữ liệu
                if (tab === 'orders' && state.orderHistory === null) {
                    content = `<div class="sm-panel p-8 text-center text-gray-500">Đang tải lịch sử đơn hàng...</div>`;
                } else if (tab === 'products' && state.ingredients === null) {
                    content = `<div class="sm-panel p-8 text-center text-gray-500">Đang tải danh mục sản phẩm...</div>`;
                }
                // Render dựa trên dữ liệu đã được fetch và lưu trong state
                else if (tab === 'orders') {
                    const history = state.orderHistory;
                    if (history && history.length > 0) {
                        content = `
                        <div class="sm-panel">
                            <table class="sm-table">
                                <thead class="sm-table-thead">
                                    <tr>
                                        <th class="sm-table-th">Mã đơn</th>
                                        <th class="sm-table-th">Ngày đặt</th>
                                        <th class="sm-table-th">Số mặt hàng</th>
                                        <th class="sm-table-th">Tổng tiền</th>
                                        <th class="sm-table-th">Trạng thái</th>
                                        <th class="sm-table-th sm-text-right">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody class="sm-table-tbody">
                                    ${history.map(order => `
                                        <tr class="sm-table-tr">
                                            <td class="sm-table-td sm-font-medium sm-blue-link">${order.id}</td>
                                            <td class="sm-table-td">${new Date(order.date).toLocaleDateString()}</td>
                                            <td class="sm-table-td">${order.items} mặt hàng</td>
                                            <td class="sm-table-td sm-font-medium">${formatMillion(order.total)} VNĐ</td>
                                            <td class="sm-table-td">
                                                <span class="sm-table-status-tag">${order.status}</span>
                                            </td>
                                            <td class="sm-table-td sm-text-right">
                                                <button class="sm-table-action-btn">Xem chi tiết</button>
                                            </td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;
                    } else if (history) { // History rỗng sau khi fetch
                        content = `<div class="sm-panel p-4 text-center text-gray-500">Nhà cung cấp này chưa có lịch sử đơn hàng nào.</div>`;
                    }
                } else if (tab === 'products') {
                    const ingredients = state.ingredients;
                    if (ingredients && ingredients.length > 0) {
                        content = `
                        <div class="sm-panel">
                            <div class="sm-products-panel-header">
                                <h3 class="sm-panel-title">Danh mục nguyên liệu cung cấp</h3>
                                <button class="sm-table-action-btn">+ Thêm nguyên liệu</button>
                            </div>
                            <table class="sm-table">
                                <thead class="sm-table-thead">
                                    <tr>
                                        <th class="sm-table-th">Tên nguyên liệu</th>
                                        <th class="sm-table-th">Đơn vị</th>
                                        <th class="sm-table-th">Giá gần nhất</th>
                                        <th class="sm-table-th">Giá TB</th>
                                        <th class="sm-table-th">Tần suất mua</th>
                                        <th class="sm-table-th sm-text-right">So sánh</th>
                                    </tr>
                                </thead>
                                <tbody class="sm-table-tbody">
                                    ${ingredients.map(ing => `
                                        <tr class="sm-table-tr">
                                            <td class="sm-table-td sm-font-medium">${ing.name}</td>
                                            <td class="sm-table-td">${ing.unit}</td>
                                            <td class="sm-table-td">${formatCurrency(ing.lastPrice)} VNĐ</td>
                                            <td class="sm-table-td sm-gray">${formatCurrency(ing.avgPrice)} VNĐ</td>
                                            <td class="sm-table-td">${ing.frequency} lần/năm</td>
                                            <td class="sm-table-td sm-text-right">
                                                <button class="sm-table-action-btn">So sánh giá</button>
                                            </td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;
                    } else if (ingredients) { // Ingredients rỗng sau khi fetch
                        content = `<div class="sm-panel p-4 text-center text-gray-500">Nhà cung cấp này chưa cung cấp nguyên liệu nào.</div>`;
                    }
                } else if (tab === 'stats') {
                    // UI tĩnh cho tab Thống kê
                    content = `<div class="sm-panel p-4 text-center text-gray-500">Mục Thống kê đang được phát triển.</div>`;
                }

                subContentContainer.innerHTML = content;
            }

            // ===== EVENT HANDLERS (Giữ nguyên) =====

            /** Chuyển sang chế độ xem chi tiết nhà cung cấp */
            window.viewSupplierDetail = function (id) {
                const supplier = window.SUPPLIERS_DATA.find(s => s.id === id);
                if (supplier) {
                    // Xóa dữ liệu chi tiết cũ, chuyển tab, và gọi render
                    setState({
                        activeTab: 'detail',
                        selectedSupplier: supplier,
                        detailSubTab: 'orders', // Mặc định là tab orders
                        orderHistory: null, // Đặt là null để kích hoạt Loading UI
                        ingredients: null // Đặt là null để kích hoạt Loading UI
                    });
                }
            }

            /** Quay lại danh sách nhà cung cấp */
            window.goToSupplierList = function () {
                setState({ activeTab: 'list', selectedSupplier: null });
            }

            // Sự kiện Tìm kiếm (Search)
            $('#sm-supplier-search-input').addEventListener('input', (e) => {
                setState({ searchTerm: e.target.value });
            });

            // Sự kiện Lọc (Filter)
            $('#sm-supplier-filter-select').addEventListener('change', (e) => {
                setState({ filterStatus: e.target.value });
            });

            // Sự kiện Top Suppliers Period
            $('#sm-top-period-select').addEventListener('change', (e) => {
                // Cần thêm logic fetch API Top Suppliers tại đây
                setState({ topPeriod: e.target.value });
            });

            // Sự kiện Modal (Thêm nhà cung cấp)
            $('#sm-add-supplier-btn').addEventListener('click', () => {
                setState({ showAddModal: true });
            });

            $('#sm-modal-cancel-btn').addEventListener('click', () => {
                setState({ showAddModal: false });
            });

            // Giả lập lưu
            $('#sm-modal-save-btn').addEventListener('click', () => {
                alert('Đã lưu nhà cung cấp mới! (Chức năng giả lập)');
                setState({ showAddModal: false });
            });

            // Đóng modal khi click ra ngoài overlay
            $('#sm-add-modal').addEventListener('click', (e) => {
                if (e.target.id === 'sm-add-modal') {
                    setState({ showAddModal: false });
                }
            });

            // ===== INITIALIZATION (Khởi tạo) =====
            fetchAndInitializeData();
        });
    </script>
</body>
</html>