                        </div>

                        <div class="sm-stat-card">
                            <div class="sm-card-header">
                                <span class="sm-card-label">Giao dịch tháng này</span>
                                <svg class="sm-card-icon sm-icon-purple" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z" /></svg>
                            </div>
                            <p class="sm-stat-value sm-purple">105</p>
                            <p class="sm-stat-subtext sm-green">↑ 15% so với tháng trước</p>
                        </div>
                    </div>

                    <div class="sm-two-col-grid">
                        <div class="sm-panel">
                            <div class="sm-panel-header">
                                <h3 class="sm-panel-title">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" /></svg>
                                    Giao dịch gần đây
                                </h3>
                            </div>
                            <div class="sm-divide-y" id="sm-recent-transactions">
                                <div class="sm-list-item">
                                    <div class="sm-flex-start-between">
                                        <p class="sm-item-name">Công ty Thực phẩm Tươi Sống</p>
                                        <span class="sm-item-value">8.5M</span>
                                    </div>
                                    <p class="sm-item-subtext">2024-12-03 09:30</p>
                                </div>
                                <div class="sm-list-item">
                                    <div class="sm-flex-start-between">
                                        <p class="sm-item-name">Nhà cung cấp Rau Củ Đà Lạt</p>
                                        <span class="sm-item-value">5.2M</span>
                                    </div>
                                    <p class="sm-item-subtext">2024-12-02 14:20</p>
                                </div>
                                <div class="sm-list-item">
                                    <div class="sm-flex-start-between">
                                        <p class="sm-item-name">Công ty Thủy sản Biển Đông</p>
                                        <span class="sm-item-value">12.0M</span>
                                    </div>
                                    <p class="sm-item-subtext">2024-12-01 11:15</p>
                                </div>
                                <div class="sm-list-item">
                                    <div class="sm-flex-start-between">
                                        <p class="sm-item-name">Nhà phân phối Gia vị Việt</p>
                                        <span class="sm-item-value">3.8M</span>
                                    </div>
                                    <p class="sm-item-subtext">2024-11-30 16:45</p>
                                </div>
                            </div>
                            <div class="sm-panel-footer">
                                <button class="sm-footer-btn">Xem tất cả →</button>
                            </div>
                        </div>

                        <div class="sm-panel">
                            <div class="sm-panel-header sm-flex-between">
                                <h3 class="sm-panel-title">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z" /></svg>
                                    Top nhà cung cấp
                                </h3>
                                <select class="sm-select" id="sm-top-period-select">
                                    <option value="today">Hôm nay</option>
                                    <option value="yesterday">Hôm qua</option>
                                    <option value="week">7 ngày qua</option>
                                    <option value="month" selected>1 tháng qua</option>
                                    <option value="quarter">3 tháng qua</option>
