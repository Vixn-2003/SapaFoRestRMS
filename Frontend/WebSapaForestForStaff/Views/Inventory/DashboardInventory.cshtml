    }

    .wd-mt-2 {
        margin-top: 8px;
    }

    .wd-mb-1 {
        margin-bottom: 4px;
    }

    .wd-mb-2 {
        margin-bottom: 8px;
    }

    .wd-mb-4 {
        margin-bottom: 16px;
    }

    .wd-mb-8 {
        margin-bottom: 32px;
    }

    .wd-mr-2 {
        margin-right: 8px;
    }

    .wd-pb-4 {
