<style>
    /* Reset & Base */
    .wd-container * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .wd-page-wrapper {
        min-height: 100vh;
        background: linear-gradient(to bottom right, #f9fafb, #f3f4f6);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: #1f2937;
    }

    /* Layout & Spacing */
    .wd-padding-8 {
        padding: 32px;
    }

    .wd-padding-6 {
        padding: 24px;
    }

    .wd-padding-4 {
        padding: 16px;
    }

    .wd-space-y-6 > * + * {
        margin-top: 24px;
    }

    .wd-space-y-3 > * + * {
        margin-top: 12px;
    }

    .wd-space-y-1 > * + * {
        margin-top: 4px;
    }

    .wd-mt-1 {
        margin-top: 4px;
    }

    .wd-mt-0-5 {
