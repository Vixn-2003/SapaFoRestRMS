    .wd-flex {
        display: flex;
    }

    .wd-flex-1 {
        flex: 1 1 0%;
    }

    .wd-items-center {
        align-items: center;
    }

    .wd-items-start {
        align-items: flex-start;
    }

    .wd-justify-between {
        justify-content: space-between;
    }

    .wd-justify-center {
        justify-content: center;
    }

    .wd-gap-2 {
        gap: 8px;
    }

    .wd-gap-3 {
        gap: 12px;
    }

    .wd-gap-6 {
        gap: 24px;
    }

    .wd-grid-4-col {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .wd-grid-2-col {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }

    .wd-two-col-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
