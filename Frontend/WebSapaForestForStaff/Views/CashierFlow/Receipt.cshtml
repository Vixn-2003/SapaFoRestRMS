@model dynamic

@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@using WebSapaForestForStaff.Controllers
@using WebSapaForestForStaff.DTOs.Payment

@{
    ViewData["Title"] = "Hóa đơn thanh toán";
    Layout = "~/Views/Shared/_counterstaffLayout.cshtml";
    
    // ✅ Kiểm tra xem Model là OrderDetailDto hay ReservationPaymentDto
    var isReservationPayment = Model is ReservationPaymentDto;
    var reservationPayment = Model as ReservationPaymentDto;
    var orderDetail = Model as OrderDetailDto;
    
    // ✅ Lấy thông tin từ Model (hỗ trợ cả 2 loại)
    var orderId = isReservationPayment ? reservationPayment!.OrderId : orderDetail!.OrderId;
    var orderCode = isReservationPayment ? reservationPayment!.OrderCode : orderDetail!.OrderCode;
    var subtotal = isReservationPayment ? reservationPayment!.Subtotal : orderDetail!.Subtotal;
    var vatAmount = isReservationPayment ? reservationPayment!.VatAmount : orderDetail!.VatAmount;
    var serviceFee = isReservationPayment ? reservationPayment!.ServiceFee : orderDetail!.ServiceFee;
    var discountAmount = isReservationPayment ? reservationPayment!.DiscountAmount : orderDetail!.DiscountAmount;
    var totalAmount = isReservationPayment ? reservationPayment!.TotalAmount : orderDetail!.TotalAmount;
    var depositAmount = isReservationPayment ? reservationPayment!.DepositAmount : orderDetail!.DepositAmount;
    var depositPaid = isReservationPayment ? reservationPayment!.DepositPaid : orderDetail!.DepositPaid;
    var depositRefundAmount = isReservationPayment ? reservationPayment!.DepositRefundAmount : orderDetail!.DepositRefundAmount;
    var customerName = isReservationPayment ? reservationPayment!.CustomerName : orderDetail!.CustomerName;
    var customerPhone = isReservationPayment ? reservationPayment!.CustomerPhone : orderDetail!.CustomerPhone;
    
    // ✅ Lấy ReservationId nếu có
    var reservationId = isReservationPayment ? reservationPayment!.ReservationId : (int?)null;
    
    // ✅ Lấy danh sách items
    var items = isReservationPayment 
        ? (reservationPayment!.AllOrderItems ?? new List<OrderItemDto>())
        : (orderDetail!.Items ?? new List<OrderItemDto>());
    
    // ✅ Lấy thông tin bàn
    var tables = isReservationPayment
        ? (reservationPayment!.TableNumbers != null && reservationPayment.TableNumbers.Any()
            ? string.Join(", ", reservationPayment.TableNumbers)
            : reservationPayment.TableNumber ?? "—")
        : (orderDetail!.TableNumbers != null && orderDetail.TableNumbers.Any()
            ? string.Join(", ", orderDetail.TableNumbers)
            : orderDetail.TableNumber ?? "—");
    
    // ✅ Lấy transactions từ reservation payment hoặc order detail (PHẢI khai báo TRƯỚC khi sử dụng)
    var paidTransactions = new List<TransactionDto>();
    if (isReservationPayment && reservationPayment != null)
    {
        // Lấy transactions từ reservation payment
        paidTransactions = (reservationPayment.Transactions ?? new List<TransactionDto>())
            .Where(t =>
                string.Equals(t.Status, "Paid", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(t.Status, "Completed", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(t.Status, "Success", StringComparison.OrdinalIgnoreCase) ||
                string.IsNullOrEmpty(t.Status))
            .ToList();
    }
    else if (orderDetail != null)
    {
        // Lấy transactions từ order detail
        paidTransactions = (orderDetail.Transactions ?? new List<TransactionDto>())
            .Where(t =>
                string.Equals(t.Status, "Paid", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(t.Status, "Completed", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(t.Status, "Success", StringComparison.OrdinalIgnoreCase) ||
                string.IsNullOrEmpty(t.Status))
            .ToList();
    }
    
    // ✅ FIX: Thu ngân xử lý (StaffName) lấy từ Transaction.ConfirmedByUser (không phải từ Reservation.Staff)
    var staffName = "—";
    if (isReservationPayment && reservationPayment != null && paidTransactions.Any())
    {
        // Note: TransactionDto không có ConfirmedByUser property, cần lấy từ backend
        // Lấy từ ReservationPaymentDto.StaffName (sẽ được populate từ Transaction.ConfirmedByUser ở backend)
        staffName = reservationPayment.StaffName ?? "—";
    }
    else if (orderDetail != null)
    {
        staffName = orderDetail.StaffName ?? "—";
    }
    
    // ✅ FIX: Nhân viên phục vụ (WaiterName) lấy từ Order.ConfirmedByStaffId
    var waiterName = isReservationPayment ? reservationPayment!.WaiterName : orderDetail!.WaiterName;
    var paymentMethod = isReservationPayment ? "Kết hợp" : (orderDetail!.PaymentMethod ?? "—");
    var createdAt = isReservationPayment ? reservationPayment!.CreatedAt : orderDetail!.CreatedAt;
    
    // ✅ Lấy PaidAt: từ transaction đầu tiên (nếu có) hoặc từ order đầu tiên
    var paidAt = isReservationPayment 
        ? (paidTransactions.Any() 
            ? paidTransactions.OrderByDescending(t => t.CompletedAt ?? t.CreatedAt).FirstOrDefault()?.CompletedAt 
            : reservationPayment!.Orders?.FirstOrDefault()?.PaidAt)
        : orderDetail!.PaidAt;

    // ✅ Filter logic giống Payment.cshtml:
    // 1. Bỏ qua các món đã bị hủy (cancelled/removed)
    // 2. Bỏ qua các món có trạng thái "Pending" (áp dụng cho cả món lẻ và combo)
    // 3. Chỉ lấy các món có trạng thái khác "Pending" và không bị hủy
    var billableItems = items.Where(i =>
    {
        var status = (i.KitchenStatus ?? "").Trim().ToLower();
        
        // Bỏ qua các món đã bị hủy
        if (status == "cancelled" || status == "đã hủy" || status == "removed")
        {
            return false;
        }
        
        // ✅ Bỏ qua các món có trạng thái "Pending" (áp dụng cho cả món lẻ và combo)
        if (status == "pending" || status == "chờ xác nhận" || string.IsNullOrEmpty(status))
        {
            return false;
        }
        
        // ✅ Các món có trạng thái khác "Pending" và không bị hủy → lấy
        return true;
    }).ToList();

    // ✅ Build receipt JSON
    var receiptJson = JsonSerializer.Serialize(new
    {
        OrderId = orderId,
        OrderCode = orderCode,
        ReservationId = reservationId,
        IsReservationPayment = isReservationPayment,
        OrderCount = isReservationPayment && reservationPayment != null ? reservationPayment.OrderCount : 1,
        OrderCodes = isReservationPayment && reservationPayment != null && reservationPayment.Orders != null
            ? reservationPayment.Orders.Select(o => o.OrderCode ?? $"#{o.OrderId}").ToList()
            : new List<string> { orderCode ?? $"#{orderId}" },
        Tables = tables,
        CustomerName = customerName ?? "Khách lẻ",
        CustomerPhone = customerPhone ?? "—",
        CreatedAt = createdAt?.ToString("dd/MM/yyyy HH:mm") ?? "--",
        PaidAt = paidAt?.ToString("dd/MM/yyyy HH:mm") ?? "--",
        StaffName = staffName ?? waiterName ?? "—",
        PaymentMethod = paymentMethod,
        Subtotal = subtotal,
        VatAmount = vatAmount,
        ServiceFee = serviceFee,
        DiscountAmount = discountAmount,
        DepositAmount = depositAmount,
        DepositPaid = depositPaid,
        DepositRefundAmount = depositRefundAmount,
        TotalAmount = totalAmount,
        Transactions = paidTransactions.Select(t => new {
            t.PaymentMethod,
            t.Amount,
            t.AmountReceived,
            t.RefundAmount,
            t.Status
        }),
        Items = billableItems.Select(i => new
        {
            Name = !string.IsNullOrEmpty(i.ComboName) ? i.ComboName : i.MenuItemName,
            IsCombo = !string.IsNullOrEmpty(i.ComboName),
            QuantityUsed = i.QuantityUsed > 0 ? i.QuantityUsed : i.Quantity,
            UnitPrice = i.UnitPrice,
            TotalPrice = i.TotalPrice
        })
    });
}

<style>
    body {
        background-color: #f5f7fa;
    }

    /* Layout tổng thể giống Payment.cshtml */
    .cashier-shell {
        padding: 24px 32px;
        min-height: calc(100vh - 80px);
    }

    /* Header full-width trên cùng */
    .receipt-page-header {
        margin-bottom: 24px;
    }

    .receipt-header-card {
        background-color: #ffffff;
        border-radius: 18px;
        padding: 16px 20px;
        box-shadow: 0 14px 35px rgba(15, 139, 131, 0.12);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        border: 2px solid #16a34a; /* xanh lá viền */
    }

    .receipt-header-main {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .receipt-header-icon {
        width: 40px;
        height: 40px;
        border-radius: 999px;
        background: rgba(22, 163, 74, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #16a34a;
    }

    .receipt-header-text .page-title {
        color: #111827;
        margin-bottom: 2px;
    }

    .receipt-header-sub {
        font-size: 13px;
        opacity: 0.95;
    }

    .receipt-header-sub span + span::before {
        content: "•";
        margin: 0 6px;
        opacity: 0.8;
    }

    .cashier-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 18px 40px rgba(15, 139, 131, 0.08);
    }

    .btn-print-receipt {
        width: auto;
    }
</style>

<div class="cashier-shell">
    <!-- HEADER FULL-WIDTH: Thông tin đơn + khách + trạng thái -->

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger d-flex align-items-start gap-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle fs-4 mt-1"></i>
            <div class="flex-grow-1">
                <h6 class="alert-heading mb-2">Lỗi khi tải hóa đơn</h6>
                <p class="mb-0">@errorMessage</p>
                <hr class="my-2">
                <small class="text-muted">
                    <strong>Gợi ý:</strong>
                    <ul class="mb-0 mt-1" style="padding-left: 20px;">
                        <li>Kiểm tra đơn hàng đã được thanh toán chưa</li>
                        <li>Thử tải lại hóa đơn sau vài giây</li>
                        <li>Liên hệ quản trị viên nếu vấn đề vẫn tiếp tục</li>
                    </ul>
                </small>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-check-circle fs-4"></i>
            <span>@successMessage</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card mb-3 cashier-card">
                <div class="card-header fw-bold bg-white">
                    Thông tin khách hàng
                </div>
                <div class="card-body">
                    <div class="row gy-3">
                        <div class="col-sm-6">
                            <div class="text-muted small">Khách hàng</div>
                            <div class="fw-bold fs-5">@(customerName ?? "Khách lẻ")</div>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <div class="text-muted small">Điện thoại</div>
                            <div class="fw-bold">@(customerPhone ?? "—")</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Thời gian tạo</div>
                            <div class="fw-semibold">@(createdAt?.ToString("dd/MM/yyyy HH:mm") ?? "--")</div>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <div class="text-muted small">Thời gian thanh toán</div>
                            <div class="fw-semibold">@(paidAt?.ToString("dd/MM/yyyy HH:mm") ?? "--")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card cashier-card">
                <div class="card-header fw-bold bg-white">
                    Danh sách món ăn / đồ uống
                    @{
                        var billableCount = billableItems.Count;
                    }
                    <span class="badge bg-primary ms-2">@billableCount món</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0">
                            <thead class="table-light text-center">
                                <tr>
                                    <th>STT</th>
                                    <th>Tên món</th>
                                    <th>SL dùng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var index = 1;
                                    if (!billableItems.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">Không có món nào cần thanh toán.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var item in billableItems)
                                        {
                                            var usedQuantity = item.QuantityUsed > 0 ? item.QuantityUsed : item.Quantity;
                                            <tr>
                                                <td class="text-center">@index</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.ComboName))
                                                    {
                                                        <div>@item.ComboName</div>
                                                        <div class="text-muted small fst-italic">Combo</div>
                                                    }
                                                    else
                                                    {
                                                        @item.MenuItemName
                                                    }
                                                </td>
                                                <td class="text-center">@usedQuantity</td>
                                                <td class="text-end">@item.UnitPrice.ToString("N0") ₫</td>
                                                <td class="text-end">@item.TotalPrice.ToString("N0") ₫</td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="fw-semibold ps-3 align-middle">
                                        <i class="bi bi-receipt-cutoff me-2 text-secondary"></i>
                                        Tạm tính
                                        <small class="text-muted d-block">
                                            Giá món trước thuế và phí
                                        </small>
                                    </td>
                                    <td class="text-end fw-bold align-middle">@subtotal.ToString("N0") ₫</td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="fw-semibold ps-3 align-middle">
                                        <i class="bi bi-percent me-2 text-secondary"></i>
                                        VAT (10%)
                                        <i class="bi bi-info-circle ms-1 text-primary"
                                           data-bs-toggle="tooltip"
                                           title="Thuế Giá Trị Gia Tăng 10% theo quy định nhà nước."></i>
                                        <small class="text-muted d-block">
                                            Thuế VAT (10%): Thuế giá trị gia tăng theo quy định
                                        </small>
                                    </td>
                                    <td class="text-end fw-bold align-middle">@vatAmount.ToString("N0") ₫</td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="fw-semibold ps-3 align-middle">
                                        <i class="bi bi-hand-index-thumb me-2 text-secondary"></i>
                                        Phí phục vụ (5%)
                                        <i class="bi bi-info-circle ms-1 text-primary"
                                           data-bs-toggle="tooltip"
                                           title="Phụ thu 5% khi khách sử dụng dịch vụ phục vụ tại bàn."></i>
                                        <small class="text-muted d-block">
                                            Phí phục vụ (5%): Phụ thu phục vụ tại bàn
                                        </small>
                                    </td>
                                    <td class="text-end fw-bold align-middle">@serviceFee.ToString("N0") ₫</td>
                                </tr>
                                @if (discountAmount > 0)
                                {
                                    <tr>
                                        <td colspan="4" class="fw-semibold ps-3 align-middle">
                                            <i class="bi bi-tags me-2 text-secondary"></i>
                                            Giảm giá
                                            <i class="bi bi-info-circle ms-1 text-primary"
                                               data-bs-toggle="tooltip"
                                               title="Giảm giá theo chương trình khuyến mãi hoặc mã ưu đãi áp dụng."></i>
                                            <small class="text-muted d-block">
                                                Giảm giá – theo chương trình khuyến mãi / mã giảm giá đã áp dụng
                                            </small>
                                        </td>
                                        <td class="text-end fw-bold text-danger align-middle">-@discountAmount.ToString("N0") ₫</td>
                                    </tr>
                                }
                                @if (depositPaid == true && depositAmount.HasValue && depositAmount.Value > 0)
                                {
                                    <tr class="table-info">
                                        <td colspan="4" class="fw-semibold ps-3 align-middle">
                                            <i class="fa-solid fa-hand-holding-dollar me-1"></i>
                                            Đã đặt cọc
                                            <small class="text-muted d-block">
                                                Số tiền khách đã thanh toán trước sẽ được trừ vào hóa đơn
                                            </small>
                                        </td>
                                        <td class="text-end fw-bold text-success align-middle">-@depositAmount.Value.ToString("N0") ₫</td>
                                    </tr>
                                }
                                @if (depositRefundAmount.HasValue && depositRefundAmount.Value > 0)
                                {
                                    <tr class="table-warning">
                                        <td colspan="4" class="fw-semibold ps-3 align-middle">
                                            <i class="fa-solid fa-money-bill-wave me-1 text-warning"></i>
                                            Tiền cần trả lại cho khách
                                            <small class="text-muted d-block">
                                                Tiền cọc lớn hơn tổng tiền thanh toán, cần trả lại tiền thừa
                                            </small>
                                        </td>
                                        <td class="text-end fw-bold text-warning align-middle" style="font-size:1.3rem;">
                                            +@depositRefundAmount.Value.ToString("N0") ₫
                                        </td>
                                    </tr>
                                }
                                @{
                                    var totalBeforeDeposit = subtotal + vatAmount + serviceFee - discountAmount;
                                }
                                <tr class="table-info">
                                    <td colspan="4" class="fw-bold ps-3 align-middle" style="background:#e7f3ff;">
                                        <span class="d-flex align-items-center gap-2">
                                            <i class="bi bi-calculator text-info fs-4"></i>
                                            <span class="fs-5">Tổng cộng thanh toán</span>
                                        </span>
                                        <small class="text-muted d-block mt-1">
                                            Tạm tính + VAT + Phí phục vụ - Giảm giá
                                        </small>
                                    </td>
                                    <td class="text-end fw-bold text-info align-middle" style="background:#e7f3ff; font-size:1.6rem;">
                                        @totalBeforeDeposit.ToString("N0") ₫
                                    </td>
                                </tr>
                                @{
                                    // Build payment breakdown
                                    var payments = paidTransactions.Any()
                                        ? paidTransactions
                                        : new List<WebSapaForestForStaff.DTOs.Payment.TransactionDto>();

                                    // Fallback: nếu không có transactions, tạo 1 dòng từ PaymentMethod/TotalAmount
                                    if (!payments.Any())
                                    {
                                        payments.Add(new WebSapaForestForStaff.DTOs.Payment.TransactionDto
                                        {
                                            PaymentMethod = string.IsNullOrWhiteSpace(Model.PaymentMethod) ? "Unknown" : Model.PaymentMethod,
                                            Amount = Model.TotalAmount,
                                            AmountReceived = Model.AmountReceived,
                                            RefundAmount = Model.ChangeAmount,
                                            Status = "Paid"
                                        });
                                    }

                                    string RenderMethodLabel(string? method)
                                    {
                                        var m = method?.Trim() ?? "";
                                        return m.ToLower() switch
                                        {
                                            "cash" => "Tiền mặt",
                                            "qrbanktransfer" => "QR",
                                            "vietqr" => "QR",
                                            "qr" => "QR",
                                            "card" => "Thẻ",
                                            "ewallet" => "Ví điện tử",
                                            "split" => "Chia hóa đơn",
                                            "combined" => "Tiền mặt + QR", // ✅ FIX: Hiển thị Combined payment
                                            _ => string.IsNullOrWhiteSpace(m) ? "Khác" : m
                                        };
                                    }
                                }
                                <tr class="table-success">
                                    <td colspan="4" class="fw-bold ps-3 align-middle" style="background:#f0faf9;">
                                        <span class="d-flex align-items-center gap-2">
                                            <i class="bi bi-cash-coin text-primary fs-4"></i>
                                            <span class="fs-5">Số tiền khách hàng phải trả</span>
                                        </span>
                                        <small class="text-muted d-block mt-1">
                                            @if (depositPaid == true && depositAmount.HasValue && depositAmount.Value > 0)
                                            {
                                                <text>Tổng cộng (@totalBeforeDeposit.ToString("N0") ₫) - Đã cọc (@depositAmount.Value.ToString("N0") ₫)</text>
                                            }
                                            else
                                            {
                                                <text>Tổng cộng thanh toán</text>
                                            }
                                        </small>
                                    </td>
                                    <td class="text-end fw-bold text-primary align-middle" style="background:#f0faf9; font-size:1.8rem;">
                                        @totalAmount.ToString("N0") ₫
                                    </td>
                                </tr>
                                @if (payments.Any())
                                {
                                    <tr class="table-light">
                                        <td colspan="5" class="ps-3 pt-3">
                                            <div class="text-muted small fw-semibold mb-2">
                                                <i class="bi bi-credit-card me-1"></i>
                                                Chi tiết thanh toán:
                                            </div>
                                            @foreach (var pay in payments)
                                            {
                                                <div class="d-flex justify-content-between align-items-center mb-2 ps-3">
                                                    <span>
                                                        <i class="bi bi-arrow-right-short text-primary"></i>
                                                        @RenderMethodLabel(pay.PaymentMethod)
                                                    </span>
                                                    <span class="fw-bold">@pay.Amount.ToString("N0") ₫</span>
                                                </div>
                                                if (pay.PaymentMethod != null &&
                                                    pay.PaymentMethod.Equals("Cash", StringComparison.OrdinalIgnoreCase) &&
                                                    pay.RefundAmount.HasValue &&
                                                    pay.RefundAmount.Value > 0)
                                                {
                                                    <div class="d-flex justify-content-between align-items-center mb-2 ps-4 text-warning">
                                                        <span class="small">
                                                            <i class="bi bi-arrow-return-right"></i>
                                                            Tiền thối lại
                                                        </span>
                                                        <span class="fw-bold small">+@pay.RefundAmount.Value.ToString("N0") ₫</span>
                                                    </div>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card cashier-card">
                <div class="card-header fw-bold bg-white">
                    Thông tin đơn hàng
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        @if (isReservationPayment && reservationId.HasValue)
                        {
                            <dt class="col-6 text-muted small">Reservation ID</dt>
                            <dd class="col-6 fw-semibold text-end">#@reservationId</dd>
                            
                            <dt class="col-6 text-muted small">Mã đơn</dt>
                            <dd class="col-6 fw-semibold text-end">
                                @if (reservationPayment!.Orders != null && reservationPayment.Orders.Any())
                                {
                                    @string.Join(", ", reservationPayment.Orders.Select(o => o.OrderCode ?? $"#{o.OrderId}"))
                                }
                                else
                                {
                                    @(orderCode ?? $"#{orderId}")
                                }
                            </dd>
                            
                            <dt class="col-6 text-muted small">Số lượng đơn</dt>
                            <dd class="col-6 fw-semibold text-end">@reservationPayment.OrderCount đơn</dd>
                        }
                        else
                        {
                            <dt class="col-6 text-muted small">Mã đơn</dt>
                            <dd class="col-6 fw-semibold text-end">@(orderCode ?? $"#{orderId}")</dd>
                        }

                        <dt class="col-6 text-muted small">Thu ngân xử lý</dt>
                        <dd class="col-6 fw-semibold text-end">@(staffName ?? waiterName ?? "—")</dd>

                        <dt class="col-6 text-muted small">Phương thức thanh toán</dt>
                        <dd class="col-6 fw-semibold text-end">@paymentMethod</dd>
                    </dl>
                </div>
                <div class="card-footer bg-white d-flex flex-wrap gap-2 justify-content-end">
                    <button class="btn btn-outline-success btn-sm btn-print-receipt"
                            data-order-id="@orderId"
                            data-order-code="@(orderCode ?? $"#{orderId}")"
                            data-reservation-id="@(reservationId?.ToString() ?? "")"
                            data-is-reservation="@(isReservationPayment ? "true" : "false")"
                            data-customer-name="@(customerName ?? "Khách lẻ")"
                            data-customer-phone="@(customerPhone ?? "—")"
                            data-created-at="@(createdAt?.ToString("dd/MM/yyyy HH:mm") ?? "--")"
                            data-paid-at="@(paidAt?.ToString("dd/MM/yyyy HH:mm") ?? "--")"
                            data-staff-name="@(staffName ?? waiterName ?? "—")"
                            data-payment-method="@paymentMethod"
                            data-subtotal="@subtotal"
                            data-vat="@vatAmount"
                            data-service-fee="@serviceFee"
                            data-discount="@discountAmount"
                            data-total="@totalAmount">
                        <i class="bi bi-printer me-1"></i> In
                    </button>
                @*     @if (isReservationPayment && reservationId.HasValue)
                    {
                        <a href="@Url.Action(nameof(CashierPaymentFlowController.DownloadReceiptByReservation), "CashierPaymentFlow", new { reservationId })"
                           class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-download me-1"></i> Tải PDF
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action(nameof(CashierPaymentFlowController.DownloadReceipt), "CashierPaymentFlow", new { orderId })"
                           class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-download me-1"></i> Tải PDF
                        </a>
                    } *@
                    <a href="@Url.Action(nameof(CashierPaymentFlowController.OrderSelection), "CashierPaymentFlow")"
                       class="btn btn-outline-secondary">
                        Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Định nghĩa biến global chứa dữ liệu receipt (sử dụng Razor syntax)
        window.receiptData = @Html.Raw(receiptJson);
    </script>
    <script src="~/js/cashier/receipt.js"></script>
}
