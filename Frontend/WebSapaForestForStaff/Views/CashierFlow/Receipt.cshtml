@model WebSapaForestForStaff.DTOs.Payment.OrderDetailDto

@using WebSapaForestForStaff.Controllers

@{
    ViewData["Title"] = "Hóa đơn thanh toán";
    Layout = "~/Views/Shared/_LayoutManager.cshtml";
    var tables = Model.TableNumbers != null && Model.TableNumbers.Any()
        ? string.Join(", ", Model.TableNumbers)
        : Model.TableNumber ?? "—";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h2 class="mb-1">Hóa đơn thanh toán</h2>
        <div class="text-muted">Đơn #@(Model.OrderCode ?? $"#{Model.OrderId}") &nbsp; | &nbsp; Bàn: @tables</div>
        @if (!string.IsNullOrEmpty(Model.StaffName) || !string.IsNullOrEmpty(Model.PaymentMethod))
        {
            <div class="text-muted small mt-1">
                @if (!string.IsNullOrEmpty(Model.StaffName))
                {
                    <span>Thu ngân: @Model.StaffName</span>
                }
                @if (!string.IsNullOrEmpty(Model.StaffName) && !string.IsNullOrEmpty(Model.PaymentMethod))
                {
                    <span> &nbsp; | &nbsp; </span>
                }
                @if (!string.IsNullOrEmpty(Model.PaymentMethod))
                {
                    <span>Phương thức: @Model.PaymentMethod</span>
                }
            </div>
        }
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action(nameof(CashierPaymentFlowController.OrderSelection), "CashierPaymentFlow")" 
           class="btn btn-outline-secondary">
            ← Quay lại danh sách
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger mb-3">@errorMessage</div>
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success mb-3">@successMessage</div>
}

<div class="page-content">
    <!-- Customer Information -->
    <div class="card mb-3">
        <div class="card-header fw-bold bg-white">
            Thông tin khách hàng
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-2">
                        <span class="text-muted">Khách hàng:</span>
                        <span class="fw-bold ms-2">@(Model.CustomerName ?? "Khách lẻ")</span>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted">Điện thoại:</span>
                        <span class="ms-2">@(Model.CustomerPhone ?? "—")</span>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <div class="text-muted mb-1">Thời gian thanh toán</div>
                    <div class="fw-bold">@(Model.PaidAt?.ToString("dd/MM/yyyy HH:mm") ?? Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "--")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 1: Danh sách món ăn / đồ uống -->
    <div class="card mb-3">
        <div class="card-header fw-bold bg-white">
            Danh sách món ăn / đồ uống
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light text-center">
                        <tr>
                            <th>STT</th>
                            <th>Tên món</th>
                            <th>SL</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 1;
                            if (Model.Items == null || !Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">Không có món nào trong đơn hàng.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="text-center">@index</td>
                                        <td>@item.MenuItemName</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@item.TotalPrice.ToString("N0") ₫</td>
                                    </tr>
                                    index++;
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Card 2: Tổng tạm tính -->
    <div class="card mb-3">
        <div class="card-header fw-bold bg-white">
            Tổng tạm tính
        </div>
        <div class="card-body">
            <div class="fs-5 fw-bold">@Model.Subtotal.ToString("N0") ₫</div>
        </div>
    </div>

    <!-- Card 3: Tổng cộng thanh toán -->
    <div class="card">
        <div class="card-header fw-bold bg-white">
            Tổng cộng thanh toán
        </div>
        <div class="card-body text-end">
            <div class="text-muted mb-2">VAT: @Model.VatAmount.ToString("N0") ₫</div>
            <div class="text-muted mb-2">Phí dịch vụ: @Model.ServiceFee.ToString("N0") ₫</div>
            @if (Model.DiscountAmount > 0)
            {
                <div class="text-muted mb-2">Giảm giá: -@Model.DiscountAmount.ToString("N0") ₫</div>
            }
            <div class="fs-4 fw-bold text-primary mt-2 mb-3">@Model.TotalAmount.ToString("N0") ₫</div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <a href="@Url.Action(nameof(CashierPaymentFlowController.DownloadReceipt), "CashierPaymentFlow", new { orderId = Model.OrderId })" 
                   class="btn btn-success">
                    Tải hóa đơn PDF
                </a>
                <a href="@Url.Action(nameof(CashierPaymentFlowController.OrderSelection), "CashierPaymentFlow")" 
                   class="btn btn-outline-secondary">
                    Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>
