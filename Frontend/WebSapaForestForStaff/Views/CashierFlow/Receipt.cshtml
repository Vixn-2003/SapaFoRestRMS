@model WebSapaForestForStaff.DTOs.Payment.OrderDetailDto

@using WebSapaForestForStaff.Controllers

@{
    ViewData["Title"] = "Hóa đơn thanh toán";
    Layout = "~/Views/Shared/_counterstaffLayout.cshtml";
    var tables = Model.TableNumbers != null && Model.TableNumbers.Any()
        ? string.Join(", ", Model.TableNumbers)
        : Model.TableNumber ?? "—";
}

<style>
    body {
        background-color: #f5f7fa;
    }

    .cashier-shell {
        padding: 32px 40px;
    }

    .cashier-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 18px 40px rgba(15, 139, 131, 0.08);
    }
</style>

<div class="cashier-shell">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="mb-1">Hóa đơn thanh toán</h2>
            <div class="text-muted">Đơn #@(Model.OrderCode ?? $"#{Model.OrderId}") &nbsp; | &nbsp; Bàn: @tables</div>
            <div class="text-muted small mt-1">
                Thu ngân: @(Model.StaffName ?? Model.WaiterName ?? "—") &nbsp;|&nbsp; Phương thức: @(Model.PaymentMethod ?? "—")
            </div>
        </div>
        <a href="@Url.Action(nameof(CashierPaymentFlowController.OrderSelection), "CashierPaymentFlow")"
           class="btn btn-outline-secondary">
            ← Quay lại danh sách
        </a>
    </div>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger d-flex align-items-start gap-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle fs-4 mt-1"></i>
            <div class="flex-grow-1">
                <h6 class="alert-heading mb-2">Lỗi khi tải hóa đơn</h6>
                <p class="mb-0">@errorMessage</p>
                <hr class="my-2">
                <small class="text-muted">
                    <strong>Gợi ý:</strong>
                    <ul class="mb-0 mt-1" style="padding-left: 20px;">
                        <li>Kiểm tra đơn hàng đã được thanh toán chưa</li>
                        <li>Thử tải lại hóa đơn sau vài giây</li>
                        <li>Liên hệ quản trị viên nếu vấn đề vẫn tiếp tục</li>
                    </ul>
                </small>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-check-circle fs-4"></i>
            <span>@successMessage</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card mb-3 cashier-card">
                <div class="card-header fw-bold bg-white">
                    Thông tin khách hàng
                </div>
                <div class="card-body">
                    <div class="row gy-3">
                        <div class="col-sm-6">
                            <div class="text-muted small">Khách hàng</div>
                            <div class="fw-bold fs-5">@(Model.CustomerName ?? "Khách lẻ")</div>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <div class="text-muted small">Điện thoại</div>
                            <div class="fw-bold">@(Model.CustomerPhone ?? "—")</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Thời gian tạo</div>
                            <div class="fw-semibold">@(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "--")</div>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <div class="text-muted small">Thời gian thanh toán</div>
                            <div class="fw-semibold">@(Model.PaidAt?.ToString("dd/MM/yyyy HH:mm") ?? "--")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card cashier-card">
                <div class="card-header fw-bold bg-white">
                    Danh sách món ăn / đồ uống
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0">
                            <thead class="table-light text-center">
                                <tr>
                                    <th>STT</th>
                                    <th>Tên món</th>
                                    <th>SL dùng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var index = 1;
                                    if (Model.Items == null || !Model.Items.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">Không có món nào trong đơn hàng.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var item in Model.Items)
                                        {
                                            var usedQuantity = item.QuantityUsed > 0 ? item.QuantityUsed : item.Quantity;
                                            <tr>
                                                <td class="text-center">@index</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.ComboName))
                                                    {
                                                        <div>@item.ComboName</div>
                                                        <div class="text-muted small fst-italic">Combo</div>
                                                    }
                                                    else
                                                    {
                                                        @item.MenuItemName
                                                    }
                                                </td>
                                                <td class="text-center">@usedQuantity</td>
                                                <td class="text-end">@item.UnitPrice.ToString("N0") ₫</td>
                                                <td class="text-end">@item.TotalPrice.ToString("N0") ₫</td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="fw-semibold ps-3">Tạm tính</td>
                                    <td class="text-end fw-bold">@Model.Subtotal.ToString("N0") ₫</td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="fw-semibold ps-3">VAT</td>
                                    <td class="text-end fw-bold">@Model.VatAmount.ToString("N0") ₫</td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="fw-semibold ps-3">Phí dịch vụ</td>
                                    <td class="text-end fw-bold">@Model.ServiceFee.ToString("N0") ₫</td>
                                </tr>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <tr>
                                        <td colspan="4" class="fw-semibold ps-3">Giảm giá</td>
                                        <td class="text-end fw-bold text-danger">-@Model.DiscountAmount.ToString("N0") ₫</td>
                                    </tr>
                                }
                                <tr class="table-success">
                                    <td colspan="4" class="fw-bold fs-5 ps-3">Tổng cộng thanh toán</td>
                                    <td class="text-end fw-bold text-primary fs-4">@Model.TotalAmount.ToString("N0") ₫</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card cashier-card">
                <div class="card-header fw-bold bg-white">
                    Thông tin đơn hàng
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-6 text-muted small">Mã đơn</dt>
                        <dd class="col-6 fw-semibold text-end">@(Model.OrderCode ?? $"#{Model.OrderId}")</dd>

                        <dt class="col-6 text-muted small">Bàn</dt>
                        <dd class="col-6 fw-semibold text-end">@tables</dd>

                        <dt class="col-6 text-muted small">Thu ngân xử lý</dt>
                        <dd class="col-6 fw-semibold text-end">@(Model.StaffName ?? Model.WaiterName ?? "—")</dd>

                        <dt class="col-6 text-muted small">Phương thức thanh toán</dt>
                        <dd class="col-6 fw-semibold text-end">@(Model.PaymentMethod ?? "—")</dd>
                    </dl>
                </div>
                <div class="card-footer bg-white d-flex flex-wrap gap-2 justify-content-end">
                    <a href="@Url.Action(nameof(CashierPaymentFlowController.DownloadReceipt), "CashierPaymentFlow", new { orderId = Model.OrderId })"
                       class="btn btn-success">
                        <i class="bi bi-download me-2"></i>Tải hóa đơn PDF
                    </a>
                    <a href="@Url.Action(nameof(CashierPaymentFlowController.OrderSelection), "CashierPaymentFlow")"
                       class="btn btn-outline-secondary">
                        Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
