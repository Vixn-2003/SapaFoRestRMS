@model WebSapaForestForStaff.ViewModels.Payment.PaymentConfirmViewModel

@using WebSapaForestForStaff.Controllers

@{
    ViewData["Title"] = "Xác nhận thanh toán";
    Layout = "~/Views/Shared/_LayoutManager.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h2 class="mb-1">Xác nhận thanh toán</h2>
        <div class="text-muted">Mã phiên: @Model.Session.SessionId</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action(nameof(CashierPaymentFlowController.Payment), "CashierPaymentFlow", new { id = Model.OrderId })" 
           class="btn btn-outline-secondary">
            ← Quay lại chọn phương thức
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger mb-3">@errorMessage</div>
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success mb-3">@successMessage</div>
}

<div class="page-content">
    <div class="row g-3">
        <!-- QR Code Section -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header fw-bold bg-white text-center">
                    Mã QR thanh toán
                </div>
                <div class="card-body text-center p-4">
                    @if (!string.IsNullOrEmpty(Model.Session.QrCodeUrl))
                    {
                        <img src="@Model.Session.QrCodeUrl" 
                             class="img-fluid" 
                             alt="QR Thanh toán" 
                             style="max-width: 100%; height: auto;" />
                    }
                    else
                    {
                        <div class="text-muted py-4">Không có mã QR</div>
                    }
                </div>
            </div>
        </div>

        <!-- Payment Details Section -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header fw-bold bg-white">
                    Thông tin thanh toán
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="text-muted mb-1">Mã phiên thanh toán</div>
                        <div class="fw-bold fs-5">@Model.Session.SessionId</div>
                    </div>
                    <div class="mb-4">
                        <div class="text-muted mb-1">Số tiền cần thanh toán</div>
                        <div class="fs-3 fw-bold text-primary">@Model.Session.Amount.ToString("N0") ₫</div>
                    </div>
                    <form asp-action="ConfirmPayment" asp-controller="CashierPaymentFlow" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="OrderId" value="@Model.OrderId" />
                        <input type="hidden" name="SessionId" value="@Model.Session.SessionId" />
                        <div class="d-flex justify-content-end gap-2">
                            <a class="btn btn-outline-secondary" 
                               href="@Url.Action(nameof(CashierPaymentFlowController.Payment), "CashierPaymentFlow", new { id = Model.OrderId })">
                                Hủy
                            </a>
                            <button type="submit" class="btn btn-success">
                                Xác nhận giao dịch
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
