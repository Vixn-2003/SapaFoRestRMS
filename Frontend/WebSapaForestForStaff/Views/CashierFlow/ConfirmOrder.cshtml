@model WebSapaForestForStaff.DTOs.Payment.OrderDetailDto

@using WebSapaForestForStaff.Controllers
@using System.Security.Claims

@{
    ViewData["Title"] = "Xác Nhận Hóa Đơn";
    Layout = "~/Views/Shared/_counterstaffLayout.cshtml";

    var tables = Model.TableNumbers != null && Model.TableNumbers.Any()
        ? string.Join(", ", Model.TableNumbers)
        : Model.TableNumber ?? "—";

    var normalizedStatus = Model.Status?.ToLowerInvariant();
    var isConfirmed = normalizedStatus == "confirmed"
                      || normalizedStatus == "pending-payment"
                      || normalizedStatus == "paid"
                      || normalizedStatus == "completed";
    var isPaid = normalizedStatus == "paid" || normalizedStatus == "completed";
    var canEdit = !isConfirmed && !isPaid;
    var canUndoConfirm = isConfirmed && !isPaid;
    var canProceedPayment = isConfirmed && !isPaid;
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0";

    // Split items by BillingType
    var kitchenItems = Model.Items?.Where(x => x.IsKitchenItem).ToList() ?? new List<WebSapaForestForStaff.DTOs.Payment.OrderItemDto>();
    var consumptionItems = Model.Items?.Where(x => x.IsConsumptionItem).ToList() ?? new List<WebSapaForestForStaff.DTOs.Payment.OrderItemDto>();
}

<style>
    /* === Main Layout === */
    .confirmation-container {
        padding: 24px;
        background: #f8f9fa;
        min-height: calc(100vh - 80px);
    }
    
    .confirmation-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        margin-bottom: 20px;
    }
    
    .card-header-custom {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 16px 24px;
        border-radius: 12px 12px 0 0;
        font-weight: 600;
        font-size: 18px;
    }
    
    .card-body-custom {
        padding: 24px;
    }
    
    /* === Section Headers === */
    .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid #e9ecef;
    }
    
    .section-icon {
        font-size: 24px;
    }
    
    .section-title {
        font-size: 20px;
        font-weight: 600;
        color: #2d3748;
        margin: 0;
    }
    
    .section-subtitle {
        font-size: 14px;
        color: #718096;
        margin: 0;
    }
    
    /* === Kitchen Items Table === */
    .kitchen-section {
        margin-bottom: 32px;
    }
    
    .table-kitchen {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }
    
    .table-kitchen thead {
        background: #f7fafc;
    }
    
    .table-kitchen th {
        padding: 12px 16px;
        text-align: left;
        font-weight: 600;
        color: #4a5568;
        border-bottom: 2px solid #e2e8f0;
        font-size: 14px;
    }
    
    .table-kitchen td {
        padding: 16px;
        border-bottom: 1px solid #e2e8f0;
        font-size: 14px;
    }
    
    /* Row background colors based on status */
    .bg-cancelable {
        background-color: #E8FBE8 !important; /* Xanh nhạt - có thể hủy */
    }
    
    .bg-non-cancelable {
        background-color: #F5F5F5 !important; /* Xám nhạt - không thể hủy */
    }
    
    .table-kitchen tbody tr:hover {
        filter: brightness(0.97);
    }
    
    /* === Kitchen Status Badges === */
    .badge-kitchen-notstarted {
        background: #48bb78;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    
    .badge-kitchen-cooking {
        background: #ed8936;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    
    .badge-kitchen-done {
        background: #4299e1;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    
    .badge-kitchen-removed {
        background: #e53e3e;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    
    /* === Consumption Items Section === */
    .consumption-section {
        margin-bottom: 32px;
    }
    
    .quantity-input {
        width: 80px;
        text-align: center;
        border: 2px solid #cbd5e0;
        border-radius: 6px;
        padding: 8px;
        font-size: 14px;
        font-weight: 600;
    }
    
    .quantity-input:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }
    
    .quantity-input.invalid, .quantity-input.is-invalid {
        border-color: #fc8181;
        background-color: #fff5f5;
    }
    
    .quantity-info {
        font-size: 12px;
        color: #718096;
        margin-top: 4px;
    }
    
    /* === Tooltips === */
    .tooltip-icon {
        display: inline-block;
        width: 18px;
        height: 18px;
        background: #4299e1;
        color: white;
        border-radius: 50%;
        text-align: center;
        line-height: 18px;
        font-size: 12px;
        cursor: help;
        margin-left: 6px;
    }
    
    /* === Action Buttons === */
    .btn-cancel-item {
        background: #fc8181;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .btn-cancel-item:hover {
        background: #e53e3e;
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(229, 62, 62, 0.3);
    }
    
    .btn-cancel-item:disabled {
        background: #cbd5e0;
        cursor: not-allowed;
        transform: none;
    }
    
    /* === Summary Section === */
    .summary-section {
        background: #f7fafc;
        padding: 24px;
        border-radius: 8px;
        margin-top: 24px;
    }
    
    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        font-size: 15px;
    }
    
    .summary-row.highlight {
        font-weight: 600;
        font-size: 18px;
        padding-top: 16px;
        margin-top: 16px;
        border-top: 2px solid #cbd5e0;
        color: #2d3748;
    }
    
    .summary-label {
        color: #4a5568;
    }
    
    .summary-value {
        color: #2d3748;
        font-weight: 600;
    }
    
    /* === Action Footer === */
    .action-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1px solid #e2e8f0;
    }
    
    .btn-confirm-order {
        background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
        color: white;
        padding: 14px 32px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 12px rgba(72, 187, 120, 0.4);
    }
    
    .btn-confirm-order:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(72, 187, 120, 0.5);
        color: white;
    }
    
    .btn-confirm-order:disabled {
        background: #cbd5e0;
        cursor: not-allowed;
        box-shadow: none;
        transform: none;
    }
    
    .btn-back {
        background: #e2e8f0;
        color: #2d3748;
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
    }
    
    .btn-back:hover {
        background: #cbd5e0;
        color: #2d3748;
        text-decoration: none;
    }
    
    /* === QR Modal === */
    .qr-modal-content {
        text-align: center;
    }
    
    .qr-image {
        max-width: 100%;
        height: auto;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        margin: 20px 0;
    }
    
    .qr-details {
        background: #f7fafc;
        padding: 16px;
        border-radius: 8px;
        margin-top: 16px;
    }
    
    .qr-details p {
        margin: 8px 0;
        font-size: 14px;
    }
    
    /* === Payment Method Buttons === */
    .payment-method-btn {
        flex: 1;
        padding: 16px;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        background: white;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
    }
    
    .payment-method-btn:hover {
        border-color: #667eea;
        background: #f7fafc;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.2);
    }
    
    .payment-method-btn .icon {
        font-size: 48px;
        margin-bottom: 8px;
    }
    
    .payment-method-btn .label {
        font-size: 16px;
        font-weight: 600;
        color: #2d3748;
    }
    
    /* === Alert Messages === */
    .alert-custom {
        padding: 16px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .alert-info {
        background: #ebf8ff;
        border-left: 4px solid #4299e1;
        color: #2c5282;
    }
    
    .alert-warning {
        background: #fffaf0;
        border-left: 4px solid #ed8936;
        color: #7c2d12;
    }
    
    .alert-success {
        background: #d1fae5;
        border-left: 4px solid #48bb78;
        color: #22543d;
    }
    
    .alert-danger {
        background: #fff5f5;
        border-left: 4px solid #e53e3e;
        color: #742a2a;
    }
    
    /* === Empty State === */
    .empty-state {
        text-align: center;
        padding: 48px 24px;
        color: #718096;
    }
    
    .empty-state-icon {
        font-size: 48px;
        margin-bottom: 16px;
    }
    
    /* === Responsive === */
    @@media (max-width: 768px) {
        .confirmation-container {
            padding: 16px;
        }
        
        .table-kitchen {
            font-size: 13px;
        }
        
        .table-kitchen th,
        .table-kitchen td {
            padding: 10px 8px;
        }
        
        .action-footer {
            flex-direction: column;
            gap: 12px;
        }
        
        .btn-confirm-order,
        .btn-back {
            width: 100%;
        }
    }
</style>

<div class="confirmation-container">
    <!-- Header -->
    <div class="confirmation-card">
        <div class="card-header-custom">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <div style="font-size: 24px; margin-bottom: 4px;">🧾 Xác Nhận Hóa Đơn</div>
                    <div style="font-size: 14px; font-weight: 400; opacity: 0.9;">
                        Đơn hàng #@(Model.OrderCode ?? $"#{Model.OrderId}") | 
                        Bàn: @tables
                    </div>
                </div>
                <div style="text-align: right;">
                    <div style="font-size: 13px; opacity: 0.8;">Khách hàng</div>
                    <div style="font-size: 16px;">@(Model.CustomerName ?? "Khách vãng lai")</div>
                </div>
            </div>
        </div>
    </div>
    
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert-custom alert-danger">
            <i class="bi bi-exclamation-triangle" style="font-size: 20px;"></i>
            <span>@errorMessage</span>
        </div>
    }
    
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert-custom alert-success">
            <i class="bi bi-check-circle" style="font-size: 20px;"></i>
            <span>@successMessage</span>
        </div>
    }
    
    <form asp-action="ConfirmOrder"
          asp-controller="CashierPaymentFlow"
          method="post"
          id="confirmOrderForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="OrderId" value="@Model.OrderId" />
        
        <!-- SECTION 1: Kitchen Items -->
        @if (kitchenItems.Any())
        {
            <div class="confirmation-card kitchen-section">
                <div class="card-body-custom">
                    <div class="section-header">
                        <span class="section-icon">🍳</span>
                        <div>
                            <h3 class="section-title">Món Chế Biến Trong Bếp</h3>
                            <p class="section-subtitle">
                                Các món này bắt buộc thanh toán 100% số lượng đã đặt nếu bếp đã bắt đầu chế biến
                                <span class="tooltip-icon" title="Món ở trạng thái 'Chưa chế biến' có thể hủy. Món đang hoặc đã chế biến không thể hủy.">?</span>
                            </p>
                        </div>
                    </div>
                    
                    <table class="table-kitchen">
                        <thead>
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th>Tên Món</th>
                                <th style="width: 100px; text-align: center;">SL Đặt</th>
                                <th style="width: 180px;">Trạng Thái Bếp</th>
                                <th style="width: 120px; text-align: right;">Đơn Giá</th>
                                <th style="width: 140px; text-align: right;">Thành Tiền</th>
                                @if (canEdit)
                                {
                                    <th style="width: 100px; text-align: center;">Tác Vụ</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var kitchenIndex = 1;
                                foreach (var item in kitchenItems)
                                {
                                    var rowClass = item.CanCancel ? "bg-cancelable" : "bg-non-cancelable";
                                    var statusBadge = item.KitchenStatus?.ToLower() switch
                                    {
                                        "pending" or "confirmed" or null => "badge-kitchen-notstarted",
                                        "cooking" => "badge-kitchen-cooking",
                                        "done" or "served" => "badge-kitchen-done",
                                        "removed" => "badge-kitchen-removed",
                                        _ => "badge-kitchen-notstarted"
                                    };
                                    var statusDisplay = item.KitchenStatus?.ToLower() switch
                                    {
                                        "pending" or "confirmed" or null => "Chưa chế biến",
                                        "cooking" => "Đang nấu",
                                        "done" => "Đã xong",
                                        "served" => "Đã phục vụ",
                                        "removed" => "Đã hủy",
                                        _ => item.KitchenStatus
                                    };
                                    
                                    <tr class="@rowClass">
                                        <td style="text-align: center; font-weight: 600;">@kitchenIndex</td>
                                        <td>
                                            <div style="font-weight: 600;">@item.Name</div>
                                            @if (!string.IsNullOrEmpty(item.ComboName))
                                            {
                                                <div style="font-size: 12px; color: #718096;">Combo</div>
                                            }
                                        </td>
                                        <td style="text-align: center; font-weight: 600; font-size: 16px;">
                                            @item.Quantity
                                        </td>
                                        <td>
                                            <span class="@statusBadge">@statusDisplay</span>
                                            @if (item.CanCancel && canEdit)
                                            {
                                                <div style="font-size: 11px; color: #48bb78; margin-top: 4px;">
                                                    ✓ Có thể hủy món
                                                </div>
                                            }
                                        </td>
                                        <td style="text-align: right; font-weight: 500;">
                                            @item.UnitPrice.ToString("N0") ₫
                                        </td>
                                        <td style="text-align: right; font-weight: 600; color: #2d3748; font-size: 15px;">
                                            @item.TotalPrice.ToString("N0") ₫
                                        </td>
                                        @if (canEdit)
                                        {
                                            <td style="text-align: center;">
                                                @if (item.CanCancel)
                                                {
                                                    <button type="button" class="btn-cancel-item" 
                                                            onclick="cancelKitchenItem(@item.OrderDetailId)">
                                                        ❌ Hủy món
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span style="color: #cbd5e0;">—</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                    kitchenIndex++;
                                }
                            }
                        </tbody>
                    </table>
                    
                    <div style="margin-top: 16px; padding: 12px; background: #f7fafc; border-radius: 6px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-weight: 600; color: #4a5568;">Tổng tiền món bếp:</span>
                            <span style="font-size: 18px; font-weight: 700; color: #2d3748;">
                                @kitchenItems.Sum(x => x.TotalPrice).ToString("N0") ₫
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <!-- SECTION 2: Consumption Items -->
        @if (consumptionItems.Any())
        {
            <div class="confirmation-card consumption-section">
                <div class="card-body-custom">
                    <div class="section-header">
                        <span class="section-icon">🧃</span>
                        <div>
                            <h3 class="section-title">Món Tính Theo Số Lượng Sử Dụng Thực Tế</h3>
                            <p class="section-subtitle">
                                Bia, nước ngọt, khăn lạnh... Khách chỉ thanh toán số lượng đã sử dụng
                                <span class="tooltip-icon" title="Nhập số lượng thực tế khách đã sử dụng. Chỉ tính tiền theo số lượng này.">?</span>
                            </p>
                        </div>
                    </div>
                    
                    <table class="table-kitchen">
                        <thead>
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th>Tên Món</th>
                                <th style="width: 100px; text-align: center;">SL Đặt</th>
                                <th style="width: 140px; text-align: center;">
                                    SL Dùng 
                                    <span class="tooltip-icon" title="Số lượng thực tế khách đã sử dụng">?</span>
                                </th>
                                <th style="width: 120px; text-align: right;">Đơn Giá</th>
                                <th style="width: 140px; text-align: right;">Thành Tiền</th>
                            </tr>
                        </thead>
                        <tbody id="consumptionItemsTable">
                            @{
                                var consumptionIndex = 1;
                                var itemListIndex = 0;
                                foreach (var item in consumptionItems)
                                {
                                    <tr data-item-id="@item.OrderDetailId" data-unit-price="@item.UnitPrice">
                                        <td style="text-align: center; font-weight: 600;">@consumptionIndex</td>
                                        <td>
                                            <div style="font-weight: 600;">@item.Name</div>
                                        </td>
                                        <td style="text-align: center; font-weight: 600; font-size: 16px; color: #718096;">
                                            @item.Quantity
                                        </td>
                                        <td style="text-align: center;">
                                            <input type="hidden" name="Items[@itemListIndex].OrderDetailId" value="@item.OrderDetailId" />
                                            <input type="hidden" name="Items[@itemListIndex].Quantity" value="@item.Quantity" />
                                            <input type="hidden" name="Items[@itemListIndex].IsRemoved" value="false" />
                                            
                                            @if (canEdit)
                                            {
                                                <input type="number" 
                                                       class="quantity-input consumption-quantity"
                                                       name="Items[@itemListIndex].QuantityUsed"
                                                       data-item-id="@item.OrderDetailId"
                                                       data-max="@item.Quantity"
                                                       value="@item.QuantityUsed"
                                                       min="0"
                                                       max="@item.Quantity"
                                                       onchange="updateConsumptionTotal(@item.OrderDetailId)"
                                                       oninput="validateQuantityInput(this)" />
                                                <div class="quantity-info">Max: @item.Quantity</div>
                                            }
                                            else
                                            {
                                                <span style="font-weight: 600; font-size: 16px;">@item.QuantityUsed</span>
                                                <input type="hidden" name="Items[@itemListIndex].QuantityUsed" value="@item.QuantityUsed" />
                                            }
                                        </td>
                                        <td style="text-align: right; font-weight: 500;">
                                            @item.UnitPrice.ToString("N0") ₫
                                        </td>
                                        <td style="text-align: right; font-weight: 600; color: #2d3748; font-size: 15px;">
                                            <span class="item-total" data-item-id="@item.OrderDetailId">
                                                @((item.QuantityUsed * item.UnitPrice).ToString("N0")) ₫
                                            </span>
                                        </td>
                                    </tr>
                                    consumptionIndex++;
                                    itemListIndex++;
                                }
                            }
                        </tbody>
                    </table>
                    
                    <div style="margin-top: 16px; padding: 12px; background: #f7fafc; border-radius: 6px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-weight: 600; color: #4a5568;">Tổng tiền món tiêu hao:</span>
                            <span id="consumptionSubtotal" style="font-size: 18px; font-weight: 700; color: #2d3748;">
                                @consumptionItems.Sum(x => x.QuantityUsed * x.UnitPrice).ToString("N0") ₫
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <!-- Notes Section -->
        <div class="confirmation-card">
            <div class="card-body-custom">
                <div style="margin-bottom: 12px;">
                    <label style="font-weight: 600; color: #4a5568; display: block; margin-bottom: 8px;">
                        Ghi chú
                    </label>
                    <textarea class="form-control"
                              name="Notes"
                              rows="2"
                              placeholder="Ví dụ: Khách bỏ món ..."
                              @(canEdit ? "" : "disabled")
                              style="border: 2px solid #e2e8f0; border-radius: 8px;"></textarea>
                </div>
            </div>
        </div>
        
        <!-- Summary Section -->
        <div class="confirmation-card">
            <div class="card-body-custom">
                <div class="summary-section">
                    <div class="summary-row">
                        <span class="summary-label">Tạm tính:</span>
                        <span class="summary-value" id="subtotalDisplay">@Model.Subtotal.ToString("N0") ₫</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">VAT (10%):</span>
                        <span class="summary-value" id="vatDisplay">@Model.VatAmount.ToString("N0") ₫</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Phí dịch vụ (5%):</span>
                        <span class="summary-value" id="serviceFeeDisplay">@Model.ServiceFee.ToString("N0") ₫</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="summary-row">
                            <span class="summary-label">Giảm giá:</span>
                            <span class="summary-value" style="color: #e53e3e;">
                                -@Model.DiscountAmount.ToString("N0") ₫
                            </span>
                        </div>
                    }
                    @if (Model.DepositPaid == true && Model.DepositAmount.HasValue && Model.DepositAmount.Value > 0)
                    {
                        <div class="summary-row" style="background-color: #d1fae5; padding: 8px 12px; margin: 8px -12px; border-radius: 6px;">
                            <span class="summary-label">
                                <i class="fa-solid fa-hand-holding-dollar me-1"></i>
                                Đã đặt cọc:
                            </span>
                            <span class="summary-value" style="color: #059669;">
                                -@Model.DepositAmount.Value.ToString("N0") ₫
                            </span>
                        </div>
                    }
                    <div class="summary-row highlight">
                        <span>Tổng cộng thanh toán:</span>
                        <span id="totalDisplay" style="color: #667eea; font-size: 22px;">
                            @Model.TotalAmount.ToString("N0") ₫
                        </span>
                    </div>
                </div>
                
                <div class="action-footer">
                    <a href="@Url.Action(nameof(CashierPaymentFlowController.OrderSelection), "CashierPaymentFlow")" class="btn-back">
                        ← Quay lại danh sách
                    </a>
                    
                    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                        @if (canUndoConfirm)
                        {
                            <button type="button"
                                    class="btn btn-warning"
                                    data-bs-toggle="modal"
                                    data-bs-target="#undoConfirmModal">
                                <i class="fa-solid fa-rotate-left me-1"></i> Hoàn tác xác nhận
                            </button>
                        }
                        
                        @if (canEdit)
                        {
                            <button type="submit" class="btn-confirm-order">
                                ✓ Khách Đã Xác Nhận
                            </button>
                        }
                        else if (canProceedPayment)
                        {
                            <button type="button"
                                    class="btn btn-success"
                                    onclick="showPaymentMethodSelection()">
                                <i class="fa-solid fa-credit-card me-2"></i>
                                Xử Lý Thanh Toán
                            </button>
                        }
                        else if (isPaid)
                        {
                            <a href="/api/payment/orders/@Model.OrderId/receipt" 
                               target="_blank"
                               class="btn btn-primary">
                                🖨️ In Hóa Đơn PDF
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Payment Method Selection Modal -->
<div class="modal fade" id="paymentMethodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">💳 Chọn Phương Thức Thanh Toán</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div style="display: flex; gap: 16px;">
                    <div class="payment-method-btn" onclick="selectCashPayment()">
                        <div class="icon">💵</div>
                        <div class="label">Tiền Mặt</div>
                    </div>
                    <div class="payment-method-btn" onclick="selectQRPayment()">
                        <div class="icon">📱</div>
                        <div class="label">QR Ngân Hàng</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- QR Payment Modal -->
<div class="modal fade" id="qrPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">📱 Quét Mã QR Để Thanh Toán</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body qr-modal-content">
                <img id="qrImageDisplay" src="" alt="VietQR" class="qr-image" />
                <div class="qr-details">
                    <p><strong>Ngân hàng:</strong> Vietcombank (VCB)</p>
                    <p><strong>Số tài khoản:</strong> 0123456789</p>
                    <p><strong>Tổng tiền:</strong> <span id="qrTotalAmount"></span></p>
                    <p><strong>Nội dung:</strong> <span id="qrDescription"></span></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" onclick="confirmQRPayment()">
                    ✓ Đã Nhận Tiền
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Undo Confirm Modal -->
@if (canUndoConfirm)
{
    <div class="modal fade" id="undoConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Hoàn tác xác nhận đơn hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="undoConfirmForm">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Lý do hoàn tác</label>
                            <textarea class="form-control" name="Reason" rows="3" required placeholder="Nhập lý do..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning">
                            <i class="fa-solid fa-rotate-left me-1"></i> Xác nhận hoàn tác
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;">
    <div id="cashierToast" class="toast align-items-center text-bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="cashierToastMessage">Thông báo</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const toastElement = document.getElementById('cashierToast');
        const toastBody = document.getElementById('cashierToastMessage');
        let currentTransactionId = null;

        function showToast(message, type = 'info') {
            if (!toastElement || !toastBody) return;
            toastElement.classList.remove('text-bg-primary', 'text-bg-success', 'text-bg-danger', 'text-bg-warning');
            const typeClass = type === 'success'
                ? 'text-bg-success'
                : type === 'error'
                    ? 'text-bg-danger'
                    : type === 'warning'
                        ? 'text-bg-warning'
                        : 'text-bg-primary';
            toastElement.classList.add(typeClass);
            toastBody.textContent = message;
            bootstrap.Toast.getOrCreateInstance(toastElement, { delay: 3500 }).show();
        }

        // Validate quantity input
        function validateQuantityInput(input) {
            const max = parseInt(input.dataset.max);
            const value = parseInt(input.value) || 0;
            
            if (value < 0) {
                input.value = 0;
                input.classList.add('invalid');
            } else if (value > max) {
                input.value = max;
                input.classList.add('invalid');
                setTimeout(() => input.classList.remove('invalid'), 300);
            } else {
                input.classList.remove('invalid');
            }
        }
        
        // Update consumption item total
        function updateConsumptionTotal(itemId) {
            const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
            if (!row) return;
            
            const input = row.querySelector('.consumption-quantity');
            const quantityUsed = parseInt(input.value) || 0;
            const unitPrice = parseFloat(row.dataset.unitPrice);
            const totalPrice = quantityUsed * unitPrice;
            
            const totalSpan = row.querySelector(`.item-total[data-item-id="${itemId}"]`);
            if (totalSpan) {
                totalSpan.textContent = totalPrice.toLocaleString('vi-VN') + ' ₫';
            }
            
            // Recalculate consumption subtotal
            updateConsumptionSubtotal();
        }
        
        // Update consumption subtotal
        function updateConsumptionSubtotal() {
            let total = 0;
            document.querySelectorAll('#consumptionItemsTable tr').forEach(row => {
                const itemId = row.dataset.itemId;
                if (!itemId) return;
                
                const input = row.querySelector('.consumption-quantity');
                const quantityUsed = parseInt(input.value) || 0;
                const unitPrice = parseFloat(row.dataset.unitPrice);
                
                total += quantityUsed * unitPrice;
            });
            
            const subtotalEl = document.getElementById('consumptionSubtotal');
            if (subtotalEl) {
                subtotalEl.textContent = total.toLocaleString('vi-VN') + ' ₫';
            }
        }

        // Form validation
        (() => {
            const form = document.getElementById('confirmOrderForm');
            if (!form) return;

            form.addEventListener('submit', (event) => {
                const inputs = form.querySelectorAll('input[name$=".QuantityUsed"][data-max]');
                let isValid = true;
                inputs.forEach(input => {
                    const max = parseInt(input.dataset.max, 10) || 0;
                    const value = parseInt(input.value, 10) || 0;
                    if (value > max || value < 0) {
                        isValid = false;
                        input.classList.add('is-invalid');
                    } else {
                        input.classList.remove('is-invalid');
                    }
                });

                if (!isValid) {
                    event.preventDefault();
                    showToast('Số lượng khách sử dụng phải nằm trong khoảng hợp lệ.', 'warning');
                }
            });
        })();

        // === PAYMENT METHODS ===
        
        function showPaymentMethodSelection() {
            const modal = new bootstrap.Modal(document.getElementById('paymentMethodModal'));
            modal.show();
        }

        async function selectCashPayment() {
            // Close payment method modal
            bootstrap.Modal.getInstance(document.getElementById('paymentMethodModal'))?.hide();
            
            // Prompt for cash amount
            const totalAmount = @Model.TotalAmount;
            const cashGiven = prompt(`Tổng tiền: ${totalAmount.toLocaleString('vi-VN')} ₫\n\nNhập số tiền khách đưa:`);
            
            if (!cashGiven) return;
            
            const cashAmount = parseFloat(cashGiven.replace(/,/g, ''));
            if (isNaN(cashAmount) || cashAmount < totalAmount) {
                showToast('Số tiền không hợp lệ hoặc chưa đủ!', 'error');
                return;
            }
            
            try {
                const token = getCookie('jwtToken');
                
                // Start payment
                const startResponse = await fetch('/api/payment/start', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        orderId: @Model.OrderId,
                        paymentMethod: 'Cash'
                    })
                });
                
                if (!startResponse.ok) throw new Error('Không thể khởi tạo thanh toán');
                
                const transaction = await startResponse.json();
                
                // Manual confirm
                const confirmResponse = await fetch('/api/payment/manual-confirm', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        orderId: @Model.OrderId,
                        transactionId: transaction.transactionId,
                        cashGiven: cashAmount,
                        notes: `Tiền mặt. Khách đưa: ${cashAmount.toLocaleString('vi-VN')} ₫`
                    })
                });
                
                if (confirmResponse.ok) {
                    const change = cashAmount - totalAmount;
                    if (change > 0) {
                        alert(`✓ Thanh toán thành công!\n\nTiền thối lại: ${change.toLocaleString('vi-VN')} ₫`);
                    } else {
                        alert('✓ Thanh toán thành công!');
                    }
                    window.location.reload();
                } else {
                    const error = await confirmResponse.json();
                    showToast('Lỗi: ' + (error.message || 'Không thể xác nhận thanh toán'), 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Lỗi: ' + error.message, 'error');
            }
        }

        async function selectQRPayment() {
            // Close payment method modal
            bootstrap.Modal.getInstance(document.getElementById('paymentMethodModal'))?.hide();
            
            try {
                const token = getCookie('jwtToken');
                
                // Start payment
                const startResponse = await fetch('/api/payment/start', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        orderId: @Model.OrderId,
                        paymentMethod: 'QRBankTransfer'
                    })
                });
                
                if (!startResponse.ok) throw new Error('Không thể khởi tạo thanh toán');
                
                const transaction = await startResponse.json();
                currentTransactionId = transaction.transactionId;
                
                // Generate QR
                const qrResponse = await fetch(`/api/payment/vietqr/@Model.OrderId?bankCode=VCB&account=0123456789`, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                
                if (!qrResponse.ok) throw new Error('Không thể tạo mã QR');
                
                const qrData = await qrResponse.json();
                
                // Display QR modal
                document.getElementById('qrImageDisplay').src = qrData.qrUrl;
                document.getElementById('qrTotalAmount').textContent = qrData.total.toLocaleString('vi-VN') + ' ₫';
                document.getElementById('qrDescription').textContent = qrData.description;
                
                const qrModal = new bootstrap.Modal(document.getElementById('qrPaymentModal'));
                qrModal.show();
                
            } catch (error) {
                console.error('Error:', error);
                showToast('Lỗi: ' + error.message, 'error');
            }
        }

        async function confirmQRPayment() {
            if (!currentTransactionId) {
                showToast('Không tìm thấy thông tin giao dịch', 'error');
                return;
            }
            
            try {
                const token = getCookie('jwtToken');
                
                const response = await fetch('/api/payment/manual-confirm', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        orderId: @Model.OrderId,
                        transactionId: currentTransactionId,
                        notes: 'QR Bank Transfer - Đã xác nhận nhận tiền'
                    })
                });
                
                if (response.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('qrPaymentModal'))?.hide();
                    showToast('✓ Thanh toán thành công!', 'success');
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    const error = await response.json();
                    showToast('Lỗi: ' + (error.message || 'Không thể xác nhận thanh toán'), 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Lỗi: ' + error.message, 'error');
            }
        }

        // Cancel kitchen item
        async function cancelKitchenItem(orderDetailId) {
            const confirmCancel = confirm('Bạn có chắc chắn muốn hủy món này?');
            if (!confirmCancel) return;
            
            const reason = prompt('Nhập lý do hủy món:');
            if (!reason || reason.trim() === '') {
                showToast('Vui lòng nhập lý do hủy món', 'warning');
                return;
            }
            
            try {
                const token = getCookie('jwtToken');
                const response = await fetch('/api/payment/cancel-item', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        orderDetailId: orderDetailId,
                        reason: reason
                    })
                });
                
                if (response.ok) {
                    showToast('Hủy món thành công!', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    const error = await response.json();
                    showToast('Không thể hủy món: ' + (error.message || 'Lỗi không xác định'), 'error');
                }
            } catch (error) {
                console.error('Error cancelling item:', error);
                showToast('Có lỗi xảy ra khi hủy món', 'error');
            }
        }

        // Utility: Get cookie
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        // Initialize tooltips
        document.querySelectorAll('.tooltip-icon').forEach(el => {
            el.title = el.getAttribute('title');
        });
    </script>

    @if (canUndoConfirm)
    {
        <script>
            (() => {
                const form = document.getElementById('undoConfirmForm');
                if (!form) return;

                const endpoint = '@Url.Content($"~/api/payment/orders/{Model.OrderId}/undo-confirm")';
                const staffId = '@userIdClaim';
                const modalEl = document.getElementById('undoConfirmModal');
                const undoModal = modalEl ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;

                form.addEventListener('submit', async (ev) => {
                    ev.preventDefault();
                    const reason = (form.querySelector('textarea[name="Reason"]')?.value || '').trim();

                    if (!reason) {
                        showToast('Vui lòng nhập lý do hoàn tác.', 'warning');
                        return;
                    }

                    try {
                        const response = await fetch(endpoint, {
                            method: 'PUT',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                staffId: parseInt(staffId, 10) || 0,
                                reason
                            })
                        });

                        if (response.ok) {
                            undoModal?.hide();
                            showToast('Đã hoàn tác xác nhận thành công!', 'success');
                            setTimeout(() => window.location.reload(), 900);
                        } else {
                            const data = await response.json().catch(() => null);
                            showToast(data?.message || 'Không thể hoàn tác xác nhận.', 'error');
                        }
                    } catch {
                        showToast('Có lỗi xảy ra. Vui lòng thử lại sau.', 'error');
                    }
                });
            })();
        </script>
    }
}
