@model WebSapaForestForStaff.DTOs.Payment.OrderDetailDto

@using WebSapaForestForStaff.Controllers
@using System.Security.Claims

@{
    ViewData["Title"] = "Xác Nhận Hóa Đơn";
    Layout = "~/Views/Shared/_counterstaffLayout.cshtml";

    var tables = Model.TableNumbers != null && Model.TableNumbers.Any()
        ? string.Join(", ", Model.TableNumbers)
        : Model.TableNumber ?? "—";

    var normalizedStatus = Model.Status?.ToLowerInvariant();
    var isConfirmed = normalizedStatus == "confirmed"
                      || normalizedStatus == "pending-payment"
                      || normalizedStatus == "paid"
                      || normalizedStatus == "completed";
    var isPaid = normalizedStatus == "paid" || normalizedStatus == "completed";
    var canEdit = !isConfirmed && !isPaid;
    var canUndoConfirm = isConfirmed && !isPaid;
    var canProceedPayment = isConfirmed && !isPaid;
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0";

    // Split items by BillingType
    var kitchenItems = Model.Items?.Where(x => x.IsKitchenItem).ToList() ?? new List<WebSapaForestForStaff.DTOs.Payment.OrderItemDto>();
    var consumptionItems = Model.Items?.Where(x => x.IsConsumptionItem).ToList() ?? new List<WebSapaForestForStaff.DTOs.Payment.OrderItemDto>();
}

<!-- External CSS -->
<link rel="stylesheet" href="~/css/cashier/confirm-order.css" />

<div class="confirmation-container">
    <!-- Header -->
    <div class="confirmation-card">
        <div class="card-header-custom">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <div style="font-size: 24px; margin-bottom: 4px;">🧾 Xác Nhận Hóa Đơn</div>
                    <div style="font-size: 14px; font-weight: 400; opacity: 0.9;">
                        Đơn hàng #@(Model.OrderCode ?? $"#{Model.OrderId}") | 
                        Bàn: @tables
                    </div>
                </div>
                <div style="text-align: right;">
                    <div style="font-size: 13px; opacity: 0.8;">Khách hàng</div>
                    <div style="font-size: 16px;">@(Model.CustomerName ?? "Khách vãng lai")</div>
                </div>
            </div>
        </div>
    </div>
    
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert-custom alert-danger">
            <i class="bi bi-exclamation-triangle" style="font-size: 20px;"></i>
            <span>@errorMessage</span>
        </div>
    }
    
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert-custom alert-success">
            <i class="bi bi-check-circle" style="font-size: 20px;"></i>
            <span>@successMessage</span>
        </div>
    }
    
    <form asp-action="ConfirmOrder"
          asp-controller="CashierPaymentFlow"
          method="post"
          id="confirmOrderForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="OrderId" value="@Model.OrderId" />
        
        <!-- SECTION 1: Kitchen Items -->
        @if (kitchenItems.Any())
        {
            <div class="confirmation-card kitchen-section">
                <div class="card-body-custom">
                    <div class="section-header">
                        <span class="section-icon">🍳</span>
                        <div>
                            <h3 class="section-title">Món Chế Biến Trong Bếp</h3>
                            <p class="section-subtitle">
                                Các món này bắt buộc thanh toán 100% số lượng đã đặt nếu bếp đã bắt đầu chế biến
                                <span class="tooltip-icon" title="Món ở trạng thái 'Chưa chế biến' có thể hủy. Món đang hoặc đã chế biến không thể hủy.">?</span>
                            </p>
                        </div>
                    </div>
                    
                    <table class="table-kitchen">
                        <thead>
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th>Tên Món</th>
                                <th style="width: 100px; text-align: center;">SL Đặt</th>
                                <th style="width: 180px;">Trạng Thái Bếp</th>
                                <th style="width: 120px; text-align: right;">Đơn Giá</th>
                                <th style="width: 140px; text-align: right;">Thành Tiền</th>
                                @if (canEdit)
                                {
                                    <th style="width: 100px; text-align: center;">Tác Vụ</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var kitchenIndex = 1;
                                foreach (var item in kitchenItems)
                                {
                                    var rowClass = item.CanCancel ? "bg-cancelable" : "bg-non-cancelable";
                                    var statusBadge = item.KitchenStatus?.ToLower() switch
                                    {
                                        "pending" or "confirmed" or null => "badge-kitchen-notstarted",
                                        "cooking" => "badge-kitchen-cooking",
                                        "done" or "served" => "badge-kitchen-done",
                                        "removed" => "badge-kitchen-removed",
                                        _ => "badge-kitchen-notstarted"
                                    };
                                    var statusDisplay = item.KitchenStatus?.ToLower() switch
                                    {
                                        "pending" or "confirmed" or null => "Chưa chế biến",
                                        "cooking" => "Đang nấu",
                                        "done" => "Đã xong",
                                        "served" => "Đã phục vụ",
                                        "removed" => "Đã hủy",
                                        _ => item.KitchenStatus
                                    };
                                    
                                    <tr class="@rowClass">
                                        <td style="text-align: center; font-weight: 600;">@kitchenIndex</td>
                                        <td>
                                            <div style="font-weight: 600;">@item.Name</div>
                                            @if (!string.IsNullOrEmpty(item.ComboName))
                                            {
                                                <div style="font-size: 12px; color: #718096;">Combo</div>
                                            }
                                        </td>
                                        <td style="text-align: center; font-weight: 600; font-size: 16px;">
                                            @item.Quantity
                                        </td>
                                        <td>
                                            <span class="@statusBadge">@statusDisplay</span>
                                            @if (item.CanCancel && canEdit)
                                            {
                                                <div style="font-size: 11px; color: #48bb78; margin-top: 4px;">
                                                    ✓ Có thể hủy món
                                                </div>
                                            }
                                        </td>
                                        <td style="text-align: right; font-weight: 500;">
                                            @item.UnitPrice.ToString("N0") ₫
                                        </td>
                                        <td style="text-align: right; font-weight: 600; color: #2d3748; font-size: 15px;">
                                            @item.TotalPrice.ToString("N0") ₫
                                        </td>
                                        @if (canEdit)
                                        {
                                            <td style="text-align: center;">
                                                @if (item.CanCancel)
                                                {
                                                    <button type="button" class="btn-cancel-item" 
                                                            onclick="cancelKitchenItem(@item.OrderDetailId)">
                                                        ❌ Hủy món
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span style="color: #cbd5e0;">—</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                    kitchenIndex++;
                                }
                            }
                        </tbody>
                    </table>
                    
                    <div style="margin-top: 16px; padding: 12px; background: #f7fafc; border-radius: 6px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-weight: 600; color: #4a5568;">Tổng tiền món bếp:</span>
                            <span style="font-size: 18px; font-weight: 700; color: #2d3748;">
                                @kitchenItems.Sum(x => x.TotalPrice).ToString("N0") ₫
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <!-- SECTION 2: Consumption Items -->
        @if (consumptionItems.Any())
        {
            <div class="confirmation-card consumption-section">
                <div class="card-body-custom">
                    <div class="section-header">
                        <span class="section-icon">🧃</span>
                        <div>
                            <h3 class="section-title">Món Tính Theo Số Lượng Sử Dụng Thực Tế</h3>
                            <p class="section-subtitle">
                                Bia, nước ngọt, khăn lạnh... Khách chỉ thanh toán số lượng đã sử dụng
                                <span class="tooltip-icon" title="Nhập số lượng thực tế khách đã sử dụng. Chỉ tính tiền theo số lượng này.">?</span>
                            </p>
                        </div>
                    </div>
                    
                    <table class="table-kitchen">
                        <thead>
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th>Tên Món</th>
                                <th style="width: 100px; text-align: center;">SL Đặt</th>
                                <th style="width: 140px; text-align: center;">
                                    SL Dùng 
                                    <span class="tooltip-icon" title="Số lượng thực tế khách đã sử dụng">?</span>
                                </th>
                                <th style="width: 120px; text-align: right;">Đơn Giá</th>
                                <th style="width: 140px; text-align: right;">Thành Tiền</th>
                            </tr>
                        </thead>
                        <tbody id="consumptionItemsTable">
                            @{
                                var consumptionIndex = 1;
                                var itemListIndex = 0;
                                foreach (var item in consumptionItems)
                                {
                                    <tr data-item-id="@item.OrderDetailId" data-unit-price="@item.UnitPrice">
                                        <td style="text-align: center; font-weight: 600;">@consumptionIndex</td>
                                        <td>
                                            <div style="font-weight: 600;">@item.Name</div>
                                        </td>
                                        <td style="text-align: center; font-weight: 600; font-size: 16px; color: #718096;">
                                            @item.Quantity
                                        </td>
                                        <td style="text-align: center;">
                                            <input type="hidden" name="Items[@itemListIndex].OrderDetailId" value="@item.OrderDetailId" />
                                            <input type="hidden" name="Items[@itemListIndex].Quantity" value="@item.Quantity" />
                                            <input type="hidden" name="Items[@itemListIndex].IsRemoved" value="false" />
                                            
                                            @if (canEdit)
                                            {
                                                <input type="number" 
                                                       class="quantity-input consumption-quantity"
                                                       name="Items[@itemListIndex].QuantityUsed"
                                                       data-item-id="@item.OrderDetailId"
                                                       data-max="@item.Quantity"
                                                       value="@item.QuantityUsed"
                                                       min="0"
                                                       max="@item.Quantity"
                                                       onchange="updateConsumptionTotal(@item.OrderDetailId)"
                                                       oninput="validateQuantityInput(this)" />
                                                <div class="quantity-info">Max: @item.Quantity</div>
                                            }
                                            else
                                            {
                                                <span style="font-weight: 600; font-size: 16px;">@item.QuantityUsed</span>
                                                <input type="hidden" name="Items[@itemListIndex].QuantityUsed" value="@item.QuantityUsed" />
                                            }
                                        </td>
                                        <td style="text-align: right; font-weight: 500;">
                                            @item.UnitPrice.ToString("N0") ₫
                                        </td>
                                        <td style="text-align: right; font-weight: 600; color: #2d3748; font-size: 15px;">
                                            <span class="item-total" data-item-id="@item.OrderDetailId">
                                                @((item.QuantityUsed * item.UnitPrice).ToString("N0")) ₫
                                            </span>
                                        </td>
                                    </tr>
                                    consumptionIndex++;
                                    itemListIndex++;
                                }
                            }
                        </tbody>
                    </table>
                    
                    <div style="margin-top: 16px; padding: 12px; background: #f7fafc; border-radius: 6px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-weight: 600; color: #4a5568;">Tổng tiền món tiêu hao:</span>
                            <span id="consumptionSubtotal" style="font-size: 18px; font-weight: 700; color: #2d3748;">
                                @consumptionItems.Sum(x => x.QuantityUsed * x.UnitPrice).ToString("N0") ₫
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <!-- Notes Section -->
        <div class="confirmation-card">
            <div class="card-body-custom">
                <div style="margin-bottom: 12px;">
                    <label style="font-weight: 600; color: #4a5568; display: block; margin-bottom: 8px;">
                        Ghi chú
                    </label>
                    <textarea class="form-control"
                              name="Notes"
                              rows="2"
                              placeholder="Ví dụ: Khách bỏ món ..."
                              @(canEdit ? "" : "disabled")
                              style="border: 2px solid #e2e8f0; border-radius: 8px;"></textarea>
                </div>
            </div>
        </div>
        
        <!-- Summary Section -->
        <div class="confirmation-card">
            <div class="card-body-custom">
                <div class="summary-section">
                    <div class="summary-row">
                        <span class="summary-label">Tạm tính:</span>
                        <span class="summary-value" id="subtotalDisplay">@Model.Subtotal.ToString("N0") ₫</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">VAT (10%):</span>
                        <span class="summary-value" id="vatDisplay">@Model.VatAmount.ToString("N0") ₫</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Phí dịch vụ (5%):</span>
                        <span class="summary-value" id="serviceFeeDisplay">@Model.ServiceFee.ToString("N0") ₫</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="summary-row">
                            <span class="summary-label">Giảm giá:</span>
                            <span class="summary-value" style="color: #e53e3e;">
                                -@Model.DiscountAmount.ToString("N0") ₫
                            </span>
                        </div>
                    }
                    @if (Model.DepositPaid == true && Model.DepositAmount.HasValue && Model.DepositAmount.Value > 0)
                    {
                        <div class="summary-row" style="background-color: #d1fae5; padding: 8px 12px; margin: 8px -12px; border-radius: 6px;">
                            <span class="summary-label">
                                <i class="fa-solid fa-hand-holding-dollar me-1"></i>
                                Đã đặt cọc:
                            </span>
                            <span class="summary-value" style="color: #059669;">
                                -@Model.DepositAmount.Value.ToString("N0") ₫
                            </span>
                        </div>
                    }
                    <div class="summary-row highlight">
                        <span>Tổng cộng thanh toán:</span>
                        <span id="totalDisplay" style="color: #667eea; font-size: 22px;">
                            @Model.TotalAmount.ToString("N0") ₫
                        </span>
                    </div>
                </div>
                
                <div class="action-footer">
                    <a href="@Url.Action(nameof(CashierPaymentFlowController.OrderSelection), "CashierPaymentFlow")" class="btn-back">
                        ← Quay lại danh sách
                    </a>
                    
                    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                        @if (canUndoConfirm)
                        {
                            <button type="button"
                                    class="btn btn-warning"
                                    data-bs-toggle="modal"
                                    data-bs-target="#undoConfirmModal">
                                <i class="fa-solid fa-rotate-left me-1"></i> Hoàn tác xác nhận
                            </button>
                        }
                        
                        @if (canEdit)
                        {
                            <button type="submit" class="btn-confirm-order">
                                ✓ Khách Đã Xác Nhận
                            </button>
                        }
                        else if (canProceedPayment)
                        {
                            <button type="button"
                                    class="btn btn-success"
                                    onclick="showPaymentMethodSelection()">
                                <i class="fa-solid fa-credit-card me-2"></i>
                                Xử Lý Thanh Toán
                            </button>
                        }
                        else if (isPaid)
                        {
                            <a href="/api/payment/orders/@Model.OrderId/receipt" 
                               target="_blank"
                               class="btn btn-primary">
                                🖨️ In Hóa Đơn PDF
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Payment Method Selection Modal -->
<div class="modal fade" id="paymentMethodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">💳 Chọn Phương Thức Thanh Toán</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div style="display: flex; gap: 16px;">
                    <div class="payment-method-btn" onclick="selectCashPayment()">
                        <div class="icon">💵</div>
                        <div class="label">Tiền Mặt</div>
                    </div>
                    <div class="payment-method-btn" onclick="selectQRPayment()">
                        <div class="icon">📱</div>
                        <div class="label">QR Ngân Hàng</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- QR Payment Modal -->
<div class="modal fade" id="qrPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">📱 Quét Mã QR Để Thanh Toán</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body qr-modal-content">
                <img id="qrImageDisplay" src="" alt="VietQR" class="qr-image" />
                <div class="qr-details">
                    <p><strong>Ngân hàng:</strong> Vietcombank (VCB)</p>
                    <p><strong>Số tài khoản:</strong> 0123456789</p>
                    <p><strong>Tổng tiền:</strong> <span id="qrTotalAmount"></span></p>
                    <p><strong>Nội dung:</strong> <span id="qrDescription"></span></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" onclick="confirmQRPayment()">
                    ✓ Đã Nhận Tiền
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Undo Confirm Modal -->
@if (canUndoConfirm)
{
    <div class="modal fade" id="undoConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Hoàn tác xác nhận đơn hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="undoConfirmForm">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Lý do hoàn tác</label>
                            <textarea class="form-control" name="Reason" rows="3" required placeholder="Nhập lý do..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning">
                            <i class="fa-solid fa-rotate-left me-1"></i> Xác nhận hoàn tác
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;">
    <div id="cashierToast" class="toast align-items-center text-bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="cashierToastMessage">Thông báo</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <!-- External JS -->
    <script src="~/js/cashier/confirm-order.js"></script>
    
    <!-- Initialize page with order data -->
    <script>
        // Pass server-side data to client-side JavaScript
        document.addEventListener('DOMContentLoaded', function() {
            initConfirmOrderPage({
                orderId: @Model.OrderId,
                orderCode: '@(Model.OrderCode ?? Model.OrderId.ToString())',
                totalAmount: @Model.TotalAmount,
                canUndoConfirm: @canUndoConfirm.ToString().ToLower(),
                undoEndpoint: '@Url.Content($"~/api/payment/orders/{Model.OrderId}/undo-confirm")',
                staffId: '@userIdClaim'
            });
        });
    </script>
}
