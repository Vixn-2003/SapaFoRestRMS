@model WebSapaForestForStaff.DTOs.Payment.OrderDetailDto

@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@using WebSapaForestForStaff.Controllers

@{
    ViewData["Title"] = "Thanh toán";
    Layout = "~/Views/Shared/_counterstaffLayout.cshtml";
    var tables = Model.TableNumbers != null && Model.TableNumbers.Any()
        ? string.Join(", ", Model.TableNumbers)
        : Model.TableNumber ?? "—";

    string GetStatusBadgeClass(string? status)
    {
        var normalized = status?.ToLowerInvariant();
        return normalized switch
        {
            "waitingconfirmation" => "bg-warning text-dark",
            "confirmed" => "bg-primary",
            "pendingpayment" => "bg-info text-dark",
            "paid" => "bg-success",
            "completed" => "bg-success",
            "cancelled" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    string GetStatusDisplayText(string? status)
    {
        var normalized = status?.ToLowerInvariant();
        return normalized switch
        {
            "waitingconfirmation" => "Chờ xác nhận",
            "confirmed" => "Đã xác nhận",
            "pendingpayment" => "Chờ thanh toán",
            "paid" => "Đã thanh toán",
            "completed" => "Hoàn tất",
            "cancelled" => "Đã hủy",
            _ => status ?? "Không rõ"
        };
    }

    var orderJson = JsonSerializer.Serialize(new
    {
        Model.OrderId,
        Model.OrderCode,
        Tables = tables,
        Subtotal = Model.Subtotal,
        Vat = Model.VatAmount,
        ServiceFee = Model.ServiceFee,
        Discount = Model.DiscountAmount,
        DepositAmount = Model.DepositAmount,
        DepositPaid = Model.DepositPaid,
        // DepositRefundAmount = Model.DepositRefundAmount,
        Total = Model.TotalAmount,
        Items = (Model.Items ?? new List<WebSapaForestForStaff.DTOs.Payment.OrderItemDto>()).Select(i => new
        {
            i.Name,
            i.Quantity,
            i.QuantityUsed,
            i.UnitPrice,
            i.TotalPrice
        })
    });

    // Pass voucher list to JavaScript context (for initial load)
    var availableVouchersJson = ViewData["AvailableVouchers"] != null
        ? JsonSerializer.Serialize(ViewData["AvailableVouchers"])
        : "[]";
}

@section Styles {
    <link href="~/css/cashier/payment.css" rel="stylesheet" />
}

<div class="cashier-shell">
    <!-- ✅ HIỂN THỊ TOAST NOTIFICATION TỪ TEMPDATA -->
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                showToast('@Html.Raw(TempData["SuccessMessage"])', 'success');
            });
        </script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                showToast('@Html.Raw(TempData["ErrorMessage"])', 'error');
            });
        </script>
    }
    
    <!-- HEADER FULL-WIDTH: Thông tin đơn + khách + trạng thái -->
    <div class="payment-page-header">
        <div class="payment-header-card">
            <div class="payment-header-main">
                <div class="payment-header-icon">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <div class="payment-header-text">
                    <h2 class="page-title mb-1">Thanh toán đơn hàng</h2>
                    <div class="payment-header-sub">
                        <span>Đơn <strong>#@(Model.OrderCode ?? $"#{Model.OrderId}")</strong></span>
                        <span>Bàn <strong class="text-warning">@tables</strong></span>
                        @if (!string.IsNullOrEmpty(Model.WaiterName) || !string.IsNullOrEmpty(Model.StaffName))
                        {
                            <span>
                                <i class="bi bi-people me-1"></i>
                                Phục vụ: <strong>@(Model.WaiterName ?? Model.StaffName ?? "—")</strong>
                            </span>
                        }
                    </div>
                    <div class="customer-info mt-1">
                        <span>
                            <i class="bi bi-person-circle me-1"></i>
                           Thông tin khách hàng : 
                        </span>
                        <span>
                            <i class="bi bi-person-circle me-1"></i>
                            @(Model.CustomerName ?? "Khách lẻ")
                        </span>
                        <span>
                            <i class="bi bi-telephone me-1"></i>
                            @(Model.CustomerPhone ?? "Không có số điện thoại")
                        </span>
                    </div>
                </div>
            </div>
            <div class="payment-header-right">
                @if (!string.IsNullOrWhiteSpace(Model.Status))
                {
                    <span class="badge @GetStatusBadgeClass(Model.Status) px-3 py-2">
                        @GetStatusDisplayText(Model.Status)
                    </span>
                }
               
            </div>
        </div>
    </div>

    <!-- LEFT: Payment area -->
    <div class="payment-area">
        <!-- Thông tin quy trình thanh toán -->
        <div class="alert alert-info mb-2">
            <div class="d-flex">
                <i class="bi bi-lightning-charge me-2 fs-4"></i>
                <div>
                    <strong>Quy trình thanh toán:</strong>
                    <p class="mb-0 small">
                        Chọn phương thức → Thu thập thông tin qua modal → Hệ thống gửi yêu cầu khởi tạo thanh toán
                        → Nếu cần xác nhận QR, màn hình chuyển sang bước Confirm → Hoàn tất và xem hóa đơn.
                    </p>
                </div>
            </div>
        </div>

        <!-- Lưới phương thức thanh toán -->
        <div class="payment-grid row g-3">
            <div class="col-sm-12">
                <button type="button" class="payment-card" onclick="openPromotionModal()">
                    <div class="icon mb-3">🎁</div>
                    <h5>Ưu đãi / Khuyến mãi</h5>
                    <p class="text-muted mb-0">Áp dụng mã giảm giá, chương trình khuyến mãi trước khi thu tiền.</p>
                </button>
            </div>
            <div class="col-sm-6">
                <button type="button" class="payment-card" onclick="openCashPaymentModal()">
                    <div class="icon mb-3">💵</div>
                    <h5>Tiền mặt</h5>
                    <p class="text-muted mb-0">Nhập số tiền khách đưa, tính tiền thối tự động.</p>
                </button>
            </div>
            <div class="col-sm-6">
                <button type="button" class="payment-card" onclick="openQrPaymentModal()">
                    <div class="icon mb-3">📱</div>
                    <h5>QR / Ví điện tử</h5>
                    <p class="text-muted mb-0">Sinh mã VietQR, xác nhận sau khi khách chuyển khoản.</p>
                </button>
            </div>
            <div class="col-sm-6">
                <button type="button" class="payment-card" onclick="openCombinedPaymentModal()">
                    <div class="icon mb-3">💳</div>
                    <h5>Thanh toán kết hợp</h5>
                    <p class="text-muted mb-0">Chia tổng tiền giữa tiền mặt và QR.</p>
                </button>
            </div>
            <div class="col-sm-6">
                <button type="button" class="payment-card" onclick="openSplitBillModal()">
                    <div class="icon mb-3">🧾</div>
                    <h5>Chia hóa đơn</h5>
                    <p class="text-muted mb-0">Chia đều hoặc tùy chỉnh theo nhóm khách.</p>
                </button>
            </div>
        </div>
    </div>

    <!-- RIGHT: Order sidebar -->
    <div class="order-sidebar">
        <!-- Quick info: nhấn mạnh áp dụng ưu đãi trước khi thanh toán -->
        <div class="quick-info mb-2">
            <strong>Lưu ý:</strong> Hãy áp dụng <strong>Ưu đãi / Khuyến mãi</strong> trước khi chọn phương thức thanh toán
            để tổng tiền được cập nhật chính xác theo chương trình khuyến mãi.
        </div>

        <div class="card flex-grow-1">
            <div class="card-header fw-bold">
                Danh sách món ăn / đồ uống
                @{
                    var billableCount = Model.Items?.Where(i =>
                    {
                        var status = (i.KitchenStatus ?? "").Trim().ToLower();
                        
                        // Bỏ qua các món đã bị hủy
                        if (status == "cancelled" || status == "đã hủy" || status == "removed")
                        {
                            return false;
                        }
                        
                        // ✅ Bỏ qua các món có trạng thái "Pending" (áp dụng cho cả món lẻ và combo)
                        if (status == "pending" || status == "chờ xác nhận" || string.IsNullOrEmpty(status))
                        {
                            return false;
                        }
                        
                        // ✅ Các món có trạng thái khác "Pending" và không bị hủy → đếm
                        return true;
                    }).Count() ?? 0;
                }
                <span class="badge bg-primary ms-2">@billableCount món</span>
            </div>
            <div class="card-body p-0 d-flex flex-column">
                <div class="table-responsive order-items-scroll">
                    <table class="table table-bordered align-middle mb-0">
                        <thead class="table-light text-center">
                        <tr>
                                <th>STT</th>
                                <th>Tên món</th>
                                <th>SL</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var index = 1;
                                if (Model.Items == null || !Model.Items.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">Đơn hàng chưa có món.</td>
                                    </tr>
                                }
                                else
                                {
                                    // ✅ Filter logic:
                                    // 1. Bỏ qua các món đã bị hủy (cancelled/removed)
                                    // 2. Bỏ qua các món có trạng thái "Pending" (áp dụng cho cả món lẻ và combo)
                                    // 3. Chỉ hiển thị các món có trạng thái khác "Pending" và không bị hủy
                                    var billableItems = Model.Items.Where(i =>
                                    {
                                        var status = (i.KitchenStatus ?? "").Trim().ToLower();
                                        
                                        // Bỏ qua các món đã bị hủy
                                        if (status == "cancelled" || status == "đã hủy" || status == "removed")
                                        {
                                            return false;
                                        }
                                        
                                        // ✅ Bỏ qua các món có trạng thái "Pending" (áp dụng cho cả món lẻ và combo)
                                        if (status == "pending" || status == "chờ xác nhận" || string.IsNullOrEmpty(status))
                                        {
                                            return false;
                                        }
                                        
                                        // ✅ Các món có trạng thái khác "Pending" và không bị hủy → hiển thị
                                        return true;
                                    }).ToList();

                                    if (!billableItems.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">Không có món nào cần thanh toán.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var item in billableItems)
                                        {
                                            var usedQuantity = item.QuantityUsed > 0 ? item.QuantityUsed : item.Quantity;
                                            <tr>
                                                <td class="text-center">@index</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.ComboName))
                                                    {
                                                        <div>@item.ComboName</div>
                                                        <div class="text-muted small fst-italic">Combo</div>
                                                    }
                                                    else
                                                    {
                                                        @item.MenuItemName
                                                    }
                                                </td>
                                                <td class="text-center">@usedQuantity</td>
                                                <td class="text-end">@item.UnitPrice.ToString("N0") ₫</td>
                                                <td class="text-end fw-bold">@item.TotalPrice.ToString("N0") ₫</td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                }
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="fw-semibold ps-3 align-middle">
                                    <i class="bi bi-receipt-cutoff me-2 text-secondary"></i>
                                    Tạm tính
                                    <small class="text-muted d-block">
                                        Giá món trước thuế và phí
                                    </small>
                                </td>
                                <td class="text-end fw-bold align-middle">@Model.Subtotal.ToString("N0") ₫</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="fw-semibold ps-3 align-middle">
                                    <i class="bi bi-percent me-2 text-secondary"></i>
                                    VAT (10%)
                                    <i class="bi bi-info-circle ms-1 text-primary"
                                       data-bs-toggle="tooltip"
                                       title="Thuế Giá Trị Gia Tăng 10% theo quy định nhà nước."></i>
                                    <small class="text-muted d-block">
                                        Thuế VAT (10%): Thuế giá trị gia tăng theo quy định
                                    </small>
                                </td>
                                <td class="text-end fw-bold align-middle">@Model.VatAmount.ToString("N0") ₫</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="fw-semibold ps-3 align-middle">
                                    <i class="bi bi-hand-index-thumb me-2 text-secondary"></i>
                                    Phí phục vụ (5%)
                                    <i class="bi bi-info-circle ms-1 text-primary"
                                       data-bs-toggle="tooltip"
                                       title="Phụ thu 5% khi khách sử dụng dịch vụ phục vụ tại bàn."></i>
                                    <small class="text-muted d-block">
                                        Phí phục vụ (5%): Phụ thu phục vụ tại bàn
                                    </small>
                                </td>
                                <td class="text-end fw-bold align-middle">@Model.ServiceFee.ToString("N0") ₫</td>
                            </tr>
                            
                                <tr>
                                    <td colspan="4" class="fw-semibold ps-3 align-middle">
                                        <i class="bi bi-tags me-2 text-secondary"></i>
                                        Giảm giá
                                        <i class="bi bi-info-circle ms-1 text-primary"
                                           data-bs-toggle="tooltip"
                                           title="Giảm giá theo chương trình khuyến mãi hoặc mã ưu đãi áp dụng."></i>, 
                                        <small class="text-muted d-block">
                                            Giảm giá – theo chương trình khuyến mãi / mã giảm giá đã áp dụng
                                        </small>
                                    </td>
                                    <td class="text-end fw-bold text-danger align-middle">-@Model.DiscountAmount.ToString("N0") ₫</td>
                                </tr>
                            
                            @if (Model.DepositPaid == true && Model.DepositAmount.HasValue && Model.DepositAmount.Value > 0)
                            {
                                <tr class="table-info">
                                    <td colspan="4" class="fw-semibold ps-3 align-middle">
                                        <i class="fa-solid fa-hand-holding-dollar me-1"></i>
                                        Đã đặt cọc
                                        <small class="text-muted d-block">
                                            Số tiền khách đã thanh toán trước sẽ được trừ vào hóa đơn
                                        </small>
                                    </td>
                                    <td class="text-end fw-bold text-success align-middle">-@Model.DepositAmount.Value.ToString("N0") ₫</td>
                                </tr>
                            }
                             @if (Model.DepositRefundAmount.HasValue && Model.DepositRefundAmount.Value > 0)
                             {
                                 <tr class="table-warning">
                                     <td colspan="4" class="fw-semibold ps-3 align-middle">
                                         <i class="fa-solid fa-money-bill-wave me-1 text-warning"></i>
                                         Tiền cần trả lại cho khách
                                         <small class="text-muted d-block">
                                             Tiền cọc lớn hơn tổng tiền thanh toán, cần trả lại tiền thừa
                                         </small>
                                     </td>
                                     <td class="text-end fw-bold text-warning align-middle" style="font-size:1.3rem;">
                                         +@Model.DepositRefundAmount.Value.ToString("N0") ₫
                                     </td>
                                 </tr>
                             }
                            @{
                                var totalBeforeDeposit = Model.Subtotal + Model.VatAmount + Model.ServiceFee - Model.DiscountAmount;
                            }
                            <tr class="table-info">
                                <td colspan="4" class="fw-bold ps-3 align-middle" style="background:#e7f3ff;">
                                    <span class="d-flex align-items-center gap-2">
                                        <i class="bi bi-calculator text-info fs-4"></i>
                                        <span class="fs-5">Tổng cộng thanh toán</span>
                                    </span>
                                    <small class="text-muted d-block mt-1">
                                        Tạm tính + VAT + Phí phục vụ - Giảm giá
                                    </small>
                                </td>
                                <td class="text-end fw-bold text-info align-middle" style="background:#e7f3ff; font-size:1.6rem;">
                                    @totalBeforeDeposit.ToString("N0") ₫
                                </td>
                            </tr>
                            @if (Model.DepositPaid == true && Model.DepositAmount.HasValue && Model.DepositAmount.Value > 0)
                            {
                                <tr class="table-success">
                                    <td colspan="4" class="fw-bold ps-3 align-middle" style="background:#f0faf9;">
                                        <span class="d-flex align-items-center gap-2">
                                            <i class="bi bi-cash-coin text-primary fs-4"></i>
                                            <span class="fs-5">Số tiền khách hàng phải trả</span>
                                        </span>
                                        <small class="text-muted d-block mt-1">
                                            Tổng cộng thanh toán - Đặt cọc (@Model.DepositAmount.Value.ToString("N0") ₫)
                                            @if (Model.AmountReceived.HasValue && Model.AmountReceived.Value > 0)
                                            {
                                                <span class="text-info d-block mt-1">
                                                    <i class="bi bi-cash-stack me-1"></i>Số tiền khách đưa: @Model.AmountReceived.Value.ToString("N0") ₫
                                                </span>
                                            }
                                            @if (Model.ChangeAmount.HasValue && Model.ChangeAmount.Value > 0)
                                            {
                                                <span class="text-warning d-block mt-1">
                                                    <i class="bi bi-arrow-left-right me-1"></i>Tiền thối lại: @Model.ChangeAmount.Value.ToString("N0") ₫
                                                </span>
                                            }
                                        </small>
                                    </td>
                                    <td class="text-end fw-bold text-primary align-middle" style="background:#f0faf9; font-size:1.8rem;">
                                        @Model.TotalAmount.ToString("N0") ₫
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr class="table-success">
                                    <td colspan="4" class="fw-bold ps-3 align-middle" style="background:#f0faf9;">
                                        <span class="d-flex align-items-center gap-2">
                                            <i class="bi bi-cash-coin text-primary fs-4"></i>
                                            <span class="fs-5">Số tiền khách hàng phải trả</span>
                                        </span>
                                        <small class="text-muted d-block mt-1">
                                            Tổng cộng thanh toán (không có đặt cọc)
                                            @if (Model.AmountReceived.HasValue && Model.AmountReceived.Value > 0)
                                            {
                                                <span class="text-info d-block mt-1">
                                                    <i class="bi bi-cash-stack me-1"></i>Số tiền khách đưa: @Model.AmountReceived.Value.ToString("N0") ₫
                                                </span>
                                            }
                                            @if (Model.ChangeAmount.HasValue && Model.ChangeAmount.Value > 0)
                                            {
                                                <span class="text-warning d-block mt-1">
                                                    <i class="bi bi-arrow-left-right me-1"></i>Tiền thối lại: @Model.ChangeAmount.Value.ToString("N0") ₫
                                                </span>
                                            }
                                        </small>
                                    </td>
                                    <td class="text-end fw-bold text-primary align-middle" style="background:#f0faf9; font-size:1.8rem;">
                                        @Model.TotalAmount.ToString("N0") ₫
                                    </td>
                                </tr>
                            }
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="paymentActionForm"
      asp-action="InitiatePayment"
      asp-controller="CashierPaymentFlow"
      method="post"
      class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="OrderId" value="@Model.OrderId" />
    <input type="hidden" name="PaymentMethod" id="paymentMethodInput" />
    <input type="hidden" name="Amount" id="paymentAmountInput" value="@Model.TotalAmount" />
</form>

<form id="cashPaymentForm"
      asp-action="ProcessCashPayment"
      asp-controller="CashierPaymentFlow"
      method="post"
      class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="OrderId" id="cashPaymentOrderId" />
    <input type="hidden" name="AmountReceived" id="cashPaymentAmountReceived" />
    <input type="hidden" name="Notes" id="cashPaymentNotes" />
</form>

<form id="qrConfirmForm"
      asp-action="ConfirmQrPayment"
      asp-controller="CashierPaymentFlow"
      method="post"
      class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="OrderId" id="qrConfirmOrderId" />
    <input type="hidden" name="Notes" id="qrConfirmNotes" />
</form>

<script>
    // ✅ DEBUG: Add event listener để trace form submit
    document.addEventListener('DOMContentLoaded', function() {
        const cashPaymentForm = document.getElementById('cashPaymentForm');
        if (cashPaymentForm) {
            // Log khi form được submit
            cashPaymentForm.addEventListener('submit', function(e) {
                console.log('[DEBUG] Form submit event triggered');
                console.log('[DEBUG] Form action:', this.action);
                console.log('[DEBUG] Form method:', this.method);
                console.log('[DEBUG] Form data:', {
                    OrderId: document.getElementById('cashPaymentOrderId').value,
                    AmountReceived: document.getElementById('cashPaymentAmountReceived').value,
                    Notes: document.getElementById('cashPaymentNotes').value
                });
                
                // Kiểm tra xem có event nào đang preventDefault không
                if (e.defaultPrevented) {
                    console.warn('[WARNING] Form submit was prevented by another handler!');
                }
            });
            
            // Log khi form submit hoàn tất (nếu có)
            cashPaymentForm.addEventListener('submit', function() {
                console.log('[DEBUG] Form submit completed');
            }, { once: true });
        }
    });
</script>

<form id="combinedPaymentForm"
      asp-action="ProcessCombinedPayment"
      asp-controller="CashierPaymentFlow"
      method="post"
      class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="OrderId" id="combinedPaymentOrderId" />
    <input type="hidden" name="CashAmount" id="combinedPaymentCashAmount" />
    <input type="hidden" name="CashReceived" id="combinedPaymentCashReceived" />
    <input type="hidden" name="QrAmount" id="combinedPaymentQrAmount" />
    <input type="hidden" name="Notes" id="combinedPaymentNotes" />
</form>

<form id="splitBillForm"
      asp-action="ProcessSplitBill"
      asp-controller="CashierPaymentFlow"
      method="post"
      class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="orderId" id="splitBillOrderId" />
    <input type="hidden" name="partsJson" id="splitBillPartsJson" />
    <input type="hidden" name="notes" id="splitBillNotes" />
</form>
</div>

@await Html.PartialAsync("~/Views/CashierFlow/Modals/_CashPaymentModal.cshtml")
@await Html.PartialAsync("~/Views/CashierFlow/Modals/_QRPaymentModal.cshtml")
@await Html.PartialAsync("~/Views/CashierFlow/Modals/_CombinedPaymentModal.cshtml")
@await Html.PartialAsync("~/Views/CashierFlow/Modals/_SplitBillModal.cshtml")
@await Html.PartialAsync("~/Views/CashierFlow/Modals/_PromotionModal.cshtml")

@section Scripts {
    <script src="~/js/cashier/toast.js"></script>
    <script src="~/js/cashier/payment-core.js"></script>
    <script src="~/js/cashier/cash-payment.js"></script>
    <script src="~/js/cashier/qr-payment.js"></script>
    <script src="~/js/cashier/combined-payment.js"></script>
    <script src="~/js/cashier/promotion-voucher.js"></script>
    <script src="~/js/cashier/split-bill.js"></script>
    <script>
      

        const orderContext = @Html.Raw(orderJson);

        const cashModal = new bootstrap.Modal('#cashPaymentModal');
        const qrModal = new bootstrap.Modal('#qrPaymentModal');
        const combinedModal = new bootstrap.Modal('#combinedPaymentModal');
        const splitModal = new bootstrap.Modal('#splitBillModal');
        const promoModal = new bootstrap.Modal('#promotionModal');

        const paymentForm = document.getElementById('paymentActionForm');
        const methodInput = document.getElementById('paymentMethodInput');
        const amountInput = document.getElementById('paymentAmountInput');

        function formatCurrency(value) {
            return (value || 0).toLocaleString('vi-VN') + ' ₫';
        }

        function submitPayment(method, amountOverride) {
            methodInput.value = method;
            amountInput.value = amountOverride ?? orderContext.Total;
            paymentForm.submit();
        }

        function populateOrderSummary(prefix) {
            const orderCode = document.getElementById(`${prefix}OrderCode`);
            if (orderCode) orderCode.textContent = orderContext.OrderCode;
            const tableNumber = document.getElementById(`${prefix}TableNumber`);
            if (tableNumber) tableNumber.textContent = orderContext.Tables;
            const totalAmount = document.getElementById(`${prefix}TotalAmount`);
            if (totalAmount) totalAmount.textContent = formatCurrency(orderContext.Total);
            const subtotalEl = document.getElementById(`${prefix}Subtotal`);
            if (subtotalEl) subtotalEl.textContent = formatCurrency(orderContext.Subtotal);
            const vatEl = document.getElementById(`${prefix}Vat`);
            if (vatEl) vatEl.textContent = formatCurrency(orderContext.Vat);
            const serviceEl = document.getElementById(`${prefix}ServiceFee`);
            if (serviceEl) serviceEl.textContent = formatCurrency(orderContext.ServiceFee);
            const discountEl = document.getElementById(`${prefix}Discount`);
            if (discountEl) discountEl.textContent = '-' + formatCurrency(orderContext.Discount || 0);
        }

        // Cash payment logic
        function openCashPaymentModal() {
            populateOrderSummary('cash');
            const total = parseFloat(orderContext.Total ?? 0);
            const depositRefund = parseFloat(orderContext.DepositRefundAmount ?? 0);
            
            // ✅ XỬ LÝ TRƯỜNG HỢP DEPOSIT > TOTAL
            if (total === 0 && depositRefund > 0) {
                // Đã thanh toán đủ bằng tiền cọc, chỉ cần trả lại tiền thừa
                document.getElementById('amountReceived').value = '0';
                document.getElementById('amountReceived').disabled = true;
                document.getElementById('changeDisplay').classList.remove('d-none');
                document.getElementById('refundAmount').textContent = formatCurrency(depositRefund);
                document.getElementById('refundAmount').parentElement.innerHTML = `
                    <i class="bi bi-arrow-left-right me-2 fs-4 text-warning"></i>
                    <div>
                        <strong class="text-warning">Tiền cần trả lại cho khách (từ tiền cọc):</strong>
                        <span class="fs-4 ms-2 text-warning fw-bold" id="refundAmount">${formatCurrency(depositRefund)}</span>
                    </div>
                `;
                document.getElementById('underpaidWarning').classList.add('d-none');
                document.getElementById('refundConfirmation').classList.remove('d-none');
                document.getElementById('refundConfirmed').checked = false;
                document.getElementById('confirmCashPaymentBtn').disabled = true;
            } else {
                // Trường hợp bình thường
                document.getElementById('amountReceived').value = '';
                document.getElementById('amountReceived').disabled = false;
                document.getElementById('changeDisplay').classList.add('d-none');
                document.getElementById('underpaidWarning').classList.add('d-none');
                document.getElementById('refundConfirmation').classList.add('d-none');
                document.getElementById('refundConfirmed').checked = false;
                document.getElementById('confirmCashPaymentBtn').disabled = true;
            }
            cashModal.show();
        }

        function calculateCashChange() {
            const receivedInput = document.getElementById('amountReceived');
            const received = parseFloat(receivedInput.value ?? 0);
            const total = parseFloat(orderContext.Total ?? 0);

            document.getElementById('receivedAmount').textContent = formatCurrency(received);
            document.getElementById('requiredAmount').textContent = formatCurrency(total);

            const changeWrapper = document.getElementById('changeDisplay');
            const refundAmount = document.getElementById('refundAmount');
            const warning = document.getElementById('underpaidWarning');
            const missingAmount = document.getElementById('missingAmount');
            const refundConfirmGroup = document.getElementById('refundConfirmation');

            if (!receivedInput.value) {
                changeWrapper.classList.add('d-none');
                warning.classList.add('d-none');
                document.getElementById('confirmCashPaymentBtn').disabled = true;
                return;
            }

            if (received < total) {
                warning.classList.remove('d-none');
                changeWrapper.classList.add('d-none');
                missingAmount.textContent = formatCurrency(total - received);
                document.getElementById('confirmCashPaymentBtn').disabled = true;
                return;
            }

            warning.classList.add('d-none');
            const change = received - total;
            refundAmount.textContent = formatCurrency(change);
            changeWrapper.classList.toggle('d-none', change === 0);
            refundConfirmGroup.classList.toggle('d-none', change === 0);

            document.getElementById('confirmCashPaymentBtn').disabled = change > 0 && !document.getElementById('refundConfirmed').checked;
            if (change === 0) {
                document.getElementById('confirmCashPaymentBtn').disabled = false;
            }
        }

        function toggleConfirmButton() {
            const changeWrapper = document.getElementById('changeDisplay');
            if (changeWrapper.classList.contains('d-none')) {
                document.getElementById('confirmCashPaymentBtn').disabled = false;
            } else {
                document.getElementById('confirmCashPaymentBtn').disabled = !document.getElementById('refundConfirmed').checked;
            }
        }

        function confirmCashPayment() {
            // ✅ DEBUG: Log để trace
            console.log('[DEBUG] confirmCashPayment() called');
            
            try {
                const total = parseFloat(orderContext.Total ?? 0);
                const depositRefund = parseFloat(orderContext.DepositRefundAmount ?? 0);
                const orderId = orderContext.OrderId;
                
                console.log('[DEBUG] OrderId:', orderId, 'Total:', total, 'DepositRefund:', depositRefund);
                
                // ✅ XỬ LÝ TRƯỜNG HỢP DEPOSIT > TOTAL
                if (total === 0 && depositRefund > 0) {
                    // Đã thanh toán đủ bằng tiền cọc, chỉ cần xác nhận đã trả lại tiền
                    if (!document.getElementById('refundConfirmed').checked) {
                        console.log('[DEBUG] Refund not confirmed');
                        showToast('Vui lòng xác nhận đã trả lại tiền cho khách hàng.', 'warning');
                        return;
                    }
                    
                    // Submit form với AmountReceived = 0
                    console.log('[DEBUG] Submitting form with AmountReceived = 0');
                    document.getElementById('cashPaymentOrderId').value = orderId;
                    document.getElementById('cashPaymentAmountReceived').value = '0';
                    document.getElementById('cashPaymentNotes').value = `Đã thanh toán đủ bằng tiền cọc. Trả lại tiền thừa: ${depositRefund.toLocaleString('vi-VN')} ₫`;

                    const form = document.getElementById('cashPaymentForm');
                    console.log('[DEBUG] Form element:', form);
                    console.log('[DEBUG] Form action:', form?.action);
                    console.log('[DEBUG] Form method:', form?.method);
                    console.log('[DEBUG] Form values:', {
                        OrderId: document.getElementById('cashPaymentOrderId').value,
                        AmountReceived: document.getElementById('cashPaymentAmountReceived').value,
                        Notes: document.getElementById('cashPaymentNotes').value
                    });

                    // Set processing state for result modal
                    sessionStorage.setItem('cashPaymentProcessing', 'true');
                    sessionStorage.setItem('cashPaymentOrderId', orderId);

                    // Show loading modal
                    showCashPaymentLoadingModal();

                    form.submit();
                    console.log('[DEBUG] Form submitted');
                } else {
                    // Trường hợp bình thường
                    const received = parseFloat(document.getElementById('amountReceived').value ?? 0);
                    console.log('[DEBUG] Amount received:', received);
                    
                    if (!received || received < total) {
                        console.log('[DEBUG] Invalid amount received');
                        showToast('Vui lòng nhập số tiền hợp lệ.', 'warning');
                        return;
                    }
                    
                    if (received > total && !document.getElementById('refundConfirmed').checked) {
                        console.log('[DEBUG] Refund required but not confirmed');
                        showToast('Vui lòng xác nhận đã trả lại tiền thối cho khách hàng.', 'warning');
                        return;
                    }
                    
                    // Submit form với AmountReceived
                    console.log('[DEBUG] Submitting form with AmountReceived =', received);
                    document.getElementById('cashPaymentOrderId').value = orderId;
                    document.getElementById('cashPaymentAmountReceived').value = received;
                    document.getElementById('cashPaymentNotes').value = document.getElementById('paymentNotes')?.value || '';

                    const form = document.getElementById('cashPaymentForm');
                    console.log('[DEBUG] Form element:', form);
                    console.log('[DEBUG] Form action:', form?.action);
                    console.log('[DEBUG] Form method:', form?.method);
                    console.log('[DEBUG] Form values:', {
                        OrderId: document.getElementById('cashPaymentOrderId').value,
                        AmountReceived: document.getElementById('cashPaymentAmountReceived').value,
                        Notes: document.getElementById('cashPaymentNotes').value
                    });

                    // Set processing state for result modal
                    sessionStorage.setItem('cashPaymentProcessing', 'true');
                    sessionStorage.setItem('cashPaymentOrderId', orderId);

                    // Show loading modal
                    showCashPaymentLoadingModal();

                    form.submit();
                    console.log('[DEBUG] Form submitted');
                }
            } catch (error) {
                console.error('[ERROR] Error in confirmCashPayment:', error);
                showToast('Có lỗi xảy ra khi xử lý thanh toán. Vui lòng thử lại.', 'error');
            }
        }
                function generateVietQrUrl(bank, account, amount, addInfo) {
            return `https://img.vietqr.io/image/${bank}-${account}-compact.png`
                + `?amount=${amount}`
                + `&addInfo=${encodeURIComponent(addInfo)}`;
        }

        // QR payment logic
        function openQrPaymentModal() {
            populateOrderSummary('qr');
            document.getElementById('qrLoading').classList.remove('d-none');
            document.getElementById('qrContent').classList.add('d-none');
            document.getElementById('qrError').classList.add('d-none');
            document.getElementById('confirmQRPaymentBtn').classList.add('d-none');
            qrModal.show();
            setTimeout(loadQrPreview, 600);
        }

                      function loadQrPreview() {
            const amount = orderContext.Total;
            const orderCode = orderContext.OrderCode;
            const transactionCode = `TXN-${Date.now()}`;

            const bank = "MB";
            const account = "0397604824";
            const addInfo = `RMS#${orderCode}`;

            // Tạo URL VietQR
            const qrUrl = generateVietQrUrl(bank, account, amount, addInfo);

            // Update UI
            document.getElementById('qrLoading').classList.add('d-none');
            document.getElementById('qrContent').classList.remove('d-none');
            document.getElementById('qrAmount').textContent = formatCurrency(amount);
            document.getElementById('qrDescription').textContent = addInfo;
            document.getElementById('qrTransactionCode').textContent = transactionCode;
            document.getElementById('qrImage').src = qrUrl;

            document.getElementById('confirmQRPaymentBtn').classList.remove('d-none');
        }



        function retryLoadQR() {
            openQrPaymentModal();
        }

        function confirmQRPayment() {
            const btn = document.getElementById('confirmQRPaymentBtn');
            const original = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xác nhận...';
            }

            try {
                // Submit form tới controller (không dùng fetch)
                document.getElementById('qrConfirmOrderId').value = orderContext.OrderId;
                document.getElementById('qrConfirmNotes').value = 'Thu ngân xác nhận đã nhận tiền qua QR';

                // Set processing state for result modal
                sessionStorage.setItem('qrPaymentProcessing', 'true');
                sessionStorage.setItem('qrPaymentOrderId', orderContext.OrderId);

                // Show loading modal
                showQrPaymentLoadingModal();

                document.getElementById('qrConfirmForm').submit();
            } catch (error) {
                console.error('[ERROR] confirmQRPayment:', error);
                showToast(error.message || 'Đã xảy ra lỗi khi xác nhận thanh toán QR.', 'error');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = original;
                }
            }
        }

        // Combined payment logic
        function openCombinedPaymentModal() {
            populateOrderSummary('combined');
            const total = parseFloat(orderContext.Total || 0);
            const halfAmount = Math.round(total / 2);
            
            // Reset các giá trị
            document.getElementById('cashAmount').value = halfAmount;
            document.getElementById('cashReceived').value = '';
            document.getElementById('cashChangeDisplay').classList.add('d-none');
            document.getElementById('combinedTotalValidation').classList.add('d-none');
            document.getElementById('combinedErrorMessages').innerHTML = '';
            
            // Reset QR display
            document.getElementById('combinedQrLoading').classList.add('d-none');
            document.getElementById('combinedQrContent').classList.add('d-none');
            document.getElementById('generateQrBtn').disabled = false;
            
            // Tính toán lại số tiền QR (tự động)
            updateCombinedPayment();
            combinedModal.show();
        }

        function updateCombinedPayment() {
            const cashAmountInput = document.getElementById('cashAmount');
            const cashReceivedInput = document.getElementById('cashReceived');
            
            // Lấy giá trị và đảm bảo là số hợp lệ
            let cashAmount = parseFloat(cashAmountInput.value || 0);
            const cashReceived = parseFloat(cashReceivedInput.value || 0);
            const total = parseFloat(orderContext.Total || 0);
            
            // Đảm bảo cashAmount không vượt quá total
            if (cashAmount > total) {
                cashAmount = total;
                cashAmountInput.value = total.toFixed(0);
            }
            
            // Đảm bảo cashAmount không âm
            if (cashAmount < 0) {
                cashAmount = 0;
                cashAmountInput.value = '0';
            }
            
            // Tính số tiền QR còn lại (tự động) - không cần input nữa
            const remaining = total - cashAmount;
            const qrAmount = remaining > 0 ? remaining : 0;
            
            // Cập nhật hiển thị tiền thối lại
            const changeDisplay = document.getElementById('cashChangeDisplay');
            const changeAmount = document.getElementById('cashChangeAmount');
            
            if (cashReceived > cashAmount && cashAmount > 0) {
                changeDisplay.classList.remove('d-none');
                changeAmount.textContent = formatCurrency(cashReceived - cashAmount);
            } else {
                changeDisplay.classList.add('d-none');
            }
            
            // Cập nhật QR amount nếu đã hiển thị QR
            const qrContent = document.getElementById('combinedQrContent');
            if (qrContent && !qrContent.classList.contains('d-none')) {
                document.getElementById('combinedQrAmount').textContent = formatCurrency(qrAmount);
            }

            validateCombinedPayment();
        }

        function validateCombinedPayment() {
            const cashAmount = parseFloat(document.getElementById('cashAmount').value || 0);
            const cashReceived = parseFloat(document.getElementById('cashReceived').value || 0);
            const total = parseFloat(orderContext.Total || 0);
            
            // Tính qrAmount từ total - cashAmount (không lấy từ input nữa)
            const qrAmount = total - cashAmount;
            
            const validation = document.getElementById('combinedTotalValidation');
            const partsTotal = document.getElementById('combinedPartsTotal');
            const billTotal = document.getElementById('combinedBillTotal');
            const errorContainer = document.getElementById('combinedErrorMessages');

            const sum = cashAmount + qrAmount;
            partsTotal.textContent = formatCurrency(sum);
            billTotal.textContent = formatCurrency(total);

            const errors = [];

            if (cashAmount < 0 || qrAmount < 0) {
                errors.push('Giá trị không được âm.');
            }

            if (cashAmount > 0 && cashReceived > 0 && cashReceived < cashAmount) {
                errors.push('Số tiền khách đưa nhỏ hơn phần thanh toán tiền mặt.');
            }

            validation.classList.toggle('d-none', sum === total);
            errorContainer.innerHTML = errors.map(err => `<div class="alert alert-warning mb-2">${err}</div>`).join('');

            document.getElementById('confirmCombinedPaymentBtn').disabled = (sum !== total) || errors.length > 0;
        }

               function generateCombinedQR() {
            document.getElementById('combinedQrLoading').classList.remove('d-none');
            document.getElementById('combinedQrContent').classList.add('d-none');
            document.getElementById('generateQrBtn').disabled = true;

            setTimeout(() => {
                document.getElementById('combinedQrLoading').classList.add('d-none');
                document.getElementById('combinedQrContent').classList.remove('d-none');

                const cashAmount = parseFloat(document.getElementById('cashAmount').value || 0);
                const total = parseFloat(orderContext.Total || 0);
                const qrAmount = total - cashAmount;

                const orderCode = orderContext.OrderCode;
                const transactionCode = `TXN-${Date.now()}`;
                const bank = "MB";
                const account = "0397604824";
                const addInfo = `RMS#${orderCode}`;

                const qrUrl = generateVietQrUrl(bank, account, qrAmount, addInfo);

                document.getElementById('combinedQrAmount').textContent = formatCurrency(qrAmount);
                document.getElementById('combinedQrDescription').textContent = addInfo;
                document.getElementById('combinedQrTransactionCode').textContent = transactionCode;
                document.getElementById('combinedQrImage').src = qrUrl;

                document.getElementById('generateQrBtn').disabled = false;
            }, 600);
        }


        function confirmCombinedPayment() {
            if (document.getElementById('confirmCombinedPaymentBtn').disabled) {
                showToast('Vui lòng đảm bảo tổng hai phần khớp với tổng hóa đơn.', 'warning');
                return;
            }

            const cashAmount = parseFloat(document.getElementById('cashAmount').value || 0);
            const cashReceived = parseFloat(document.getElementById('cashReceived').value || 0) || null;
            const total = parseFloat(orderContext.Total || 0);
            
            // Tính qrAmount từ total - cashAmount (không lấy từ input nữa)
            const qrAmount = total - cashAmount;
            const notes = document.getElementById('combinedNotes')?.value || '';

            if (cashAmount <= 0 || qrAmount <= 0) {
                showToast('Vui lòng nhập số tiền hợp lệ cho cả hai phần.', 'warning');
                return;
            }

            const btn = document.getElementById('confirmCombinedPaymentBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...';

            try {
                // Gán giá trị vào form và submit (không dùng fetch)
                document.getElementById('combinedPaymentOrderId').value = orderContext.OrderId;
                document.getElementById('combinedPaymentCashAmount').value = cashAmount;
                document.getElementById('combinedPaymentCashReceived').value = cashReceived ?? '';
                document.getElementById('combinedPaymentQrAmount').value = qrAmount;
                document.getElementById('combinedPaymentNotes').value = notes;

                // Set processing state for result modal
                sessionStorage.setItem('combinedPaymentProcessing', 'true');
                sessionStorage.setItem('combinedPaymentOrderId', orderContext.OrderId);

                // Show loading modal
                showCombinedPaymentLoadingModal();

                document.getElementById('combinedPaymentForm').submit();
            } catch (error) {
                console.error('Error:', error);
                showToast('Lỗi: ' + (error.message || 'Không thể xử lý thanh toán. Vui lòng thử lại.'), 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Xác nhận thanh toán';
            }
        }

        // Split bill logic (delegates to dedicated split-bill.js)
        function openSplitBillModal() {
            // Sử dụng module SplitBill (wwwroot/js/split-bill.js)
            if (window.SplitBill && typeof window.SplitBill.openSplitBill === 'function') {
                window.SplitBill.openSplitBill(orderContext.OrderId, {
                    orderCode: orderContext.OrderCode,
                    tableNumber: orderContext.Tables,
                    total: orderContext.Total
                });
            } else {
                showToast('Không thể mở chức năng chia hóa đơn. Vui lòng tải lại trang.', 'error');
            }
        }

        // Promotion modal logic - load voucher list khi mở modal
        async function openPromotionModal() {
            // Hiển thị loading state
            const voucherListContainer = document.getElementById('voucherListContainer');
            if (voucherListContainer) {
                voucherListContainer.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Đang tải...</span></div><p class="mt-2 text-muted">Đang tải danh sách voucher...</p></div>';
            }
            
            promoModal.show();
            
            // Load voucher list qua AJAX
            try {
                const subtotal = parseFloat(orderContext.Subtotal || 0);
                const response = await fetch(`/cashier-flow/vouchers/available?subtotal=${subtotal}`);
                
                if (!response.ok) {
                    throw new Error('Không thể tải danh sách voucher');
                }
                
                const vouchers = await response.json();
                renderVoucherList(vouchers);
            } catch (error) {
                console.error('Error loading vouchers:', error);
                const voucherListContainer = document.getElementById('voucherListContainer');
                if (voucherListContainer) {
                    voucherListContainer.innerHTML = `
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-exclamation-triangle fs-1 d-block mb-2"></i>
                            <p class="mb-0">Không thể tải danh sách voucher.</p>
                            <small>Vui lòng nhập mã voucher thủ công ở cột bên trái.</small>
                        </div>
                    `;
                }
            }
        }

        // Render voucher list vào modal
        function renderVoucherList(vouchers) {
            const voucherListContainer = document.getElementById('voucherListContainer');
            if (!voucherListContainer) return;

            // Update count badge
            updateVoucherCount(vouchers ? vouchers.length : 0);

            if (!vouchers || vouchers.length === 0) {
                voucherListContainer.innerHTML = `
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        <p class="mb-0">Không có voucher nào khả dụng cho đơn hàng này.</p>
                        <small>Vui lòng nhập mã voucher thủ công ở cột bên trái.</small>
                    </div>
                `;
                return;
            }

            const voucherHtml = vouchers.map(voucher => {
                const discountText = voucher.discountType === "Phần trăm" 
                    ? `${voucher.discountValue}%` 
                    : `${parseFloat(voucher.discountValue).toLocaleString('vi-VN')} ₫`;
                const conditionText = voucher.minOrderValue 
                    ? `Đơn tối thiểu ${parseFloat(voucher.minOrderValue).toLocaleString('vi-VN')} ₫` 
                    : "Không giới hạn";
                
                // Escape HTML để tránh XSS
                const code = (voucher.code || '').replace(/['"]/g, '');
                const description = (voucher.description || '').replace(/['"]/g, '');
                
                return `
                    <div class="voucher-item" onclick="selectVoucher('${code}')">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="voucher-code">${code}</div>
                                ${description ? `<div class="voucher-desc">${description}</div>` : ''}
                                <div class="voucher-condition">
                                    <i class="bi bi-info-circle me-1"></i>${conditionText}
                                    ${voucher.maxDiscount && voucher.discountType === "Phần trăm" 
                                        ? ` • Tối đa ${parseFloat(voucher.maxDiscount).toLocaleString('vi-VN')} ₫` 
                                        : ''}
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="voucher-discount">-${discountText}</div>
                                <small class="text-muted">Giảm giá</small>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            voucherListContainer.innerHTML = voucherHtml;
        }

        // Tự động mở modal nếu có lỗi từ server (để user thấy và sửa)
        @if (!string.IsNullOrEmpty(ViewData["DiscountErrorMessage"] as string))
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                promoModal.show();
            });
            </text>
        }

        // Hiển thị toast thành công nếu có
        @if (!string.IsNullOrEmpty(ViewData["DiscountSuccessMessage"] as string))
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                showToast('@ViewData["DiscountSuccessMessage"]', 'success');
            });
            </text>
        }

        // Cash Payment Loading/Result Modal Functions
        function showCashPaymentLoadingModal() {
            const modal = new bootstrap.Modal(document.getElementById('cashPaymentLoadingModal'), {
                backdrop: 'static',
                keyboard: false
            });
            modal.show();
        }

        function hideCashPaymentLoadingModal() {
            const modal = bootstrap.Modal.getInstance(document.getElementById('cashPaymentLoadingModal'));
            if (modal) {
                modal.hide();
            }
        }

        function showCashPaymentResultModal(success, message, redirectUrl = null) {
            const resultModal = document.getElementById('cashPaymentResultModal');
            const resultIcon = document.getElementById('cashPaymentResultIcon');
            const resultTitle = document.getElementById('cashPaymentResultTitle');
            const resultMessage = document.getElementById('cashPaymentResultMessage');
            const resultBtn = document.getElementById('cashPaymentResultBtn');

            // Set result content
            if (success) {
                resultIcon.innerHTML = '<i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>';
                resultTitle.textContent = 'Thành công';
                resultBtn.textContent = 'Xem hóa đơn';
                resultBtn.className = 'btn btn-success';
                resultBtn.onclick = function() {
                    if (redirectUrl) {
                        window.location.href = redirectUrl;
                    } else {
                        const orderId = sessionStorage.getItem('cashPaymentOrderId');
                        window.location.href = orderId ? `/cashier-flow/receipt/${orderId}` : '/cashier-flow/orders';
                    }
                };
            } else {
                resultIcon.innerHTML = '<i class="bi bi-x-circle-fill text-danger" style="font-size: 3rem;"></i>';
                resultTitle.textContent = 'Thất bại';
                resultBtn.textContent = 'Đóng';
                resultBtn.className = 'btn btn-secondary';
                resultBtn.onclick = function() {
                    closeCashPaymentResultModal();
                };
            }

            resultMessage.textContent = message || '';

            const modal = new bootstrap.Modal(resultModal);
            modal.show();
        }

        window.closeCashPaymentResultModal = function() {
            const modal = bootstrap.Modal.getInstance(document.getElementById('cashPaymentResultModal'));
            if (modal) {
                modal.hide();
            }
            // Clear processing state
            sessionStorage.removeItem('cashPaymentProcessing');
            sessionStorage.removeItem('cashPaymentOrderId');
        };

        // Check for cash payment processing result on page load
        document.addEventListener('DOMContentLoaded', function() {
            checkCashPaymentResult();
        });

        function checkCashPaymentResult() {
            // Check if we just processed a cash payment
            const wasProcessing = sessionStorage.getItem('cashPaymentProcessing');
            if (wasProcessing === 'true') {
                // Clear processing state
                sessionStorage.removeItem('cashPaymentProcessing');

                // Check for success/error messages from TempData
                const successMessage = getTempDataMessage('SuccessMessage');
                const errorMessage = getTempDataMessage('ErrorMessage');

                if (successMessage) {
                    // Find redirect URL from success message or construct it
                    const orderId = sessionStorage.getItem('cashPaymentOrderId');
                    const redirectUrl = orderId ? `/cashier-flow/receipt/${orderId}` : null;
                    showCashPaymentResultModal(true, successMessage, redirectUrl);
                } else if (errorMessage) {
                    showCashPaymentResultModal(false, errorMessage);
                }

                // Clear stored orderId
                sessionStorage.removeItem('cashPaymentOrderId');
            }
        }

        function getTempDataMessage(key) {
            // Try to get TempData messages from various sources
            // This is a simplified approach - in reality, TempData is server-side only
            // We'll check for success/error indicators in the page
            const alerts = document.querySelectorAll('.alert');
            for (let alert of alerts) {
                if (key === 'SuccessMessage' && alert.classList.contains('alert-success')) {
                    return alert.textContent.trim();
                }
                if (key === 'ErrorMessage' && alert.classList.contains('alert-danger')) {
                    return alert.textContent.trim();
                }
            }
            return null;
        }

