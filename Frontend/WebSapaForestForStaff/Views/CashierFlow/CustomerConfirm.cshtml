@model WebSapaForestForStaff.DTOs.Payment.OrderDetailDto

@using WebSapaForestForStaff.Controllers

@{
    ViewData["Title"] = "Khách xác nhận món";
    Layout = "~/Views/Shared/_LayoutManager.cshtml";
    var tables = Model.TableNumbers != null && Model.TableNumbers.Any()
        ? string.Join(", ", Model.TableNumbers)
        : Model.TableNumber ?? "—";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h2 class="mb-1">Khách xác nhận món</h2>
        <div class="text-muted">Đơn #@(Model.OrderCode ?? $"#{Model.OrderId}") &nbsp; | &nbsp; Bàn: @tables</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action(nameof(CashierPaymentFlowController.OrderDetail), "CashierPaymentFlow", new { id = Model.OrderId })" 
           class="btn btn-outline-secondary">
            ← Quay lại
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger mb-3">@errorMessage</div>
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success mb-3">@successMessage</div>
}

<div class="page-content">
    <form asp-action="ConfirmOrder" asp-controller="CashierPaymentFlow" method="post" class="card">
        @Html.AntiForgeryToken()
        <div class="card-header fw-bold bg-white">
            Xác nhận số lượng món đã dùng
        </div>
        <div class="card-body">
            <input type="hidden" name="OrderId" value="@Model.OrderId" />

            <div class="table-responsive mb-3">
                <table class="table table-bordered align-middle">
                    <thead class="table-light text-center">
                        <tr>
                            <th>STT</th>
                            <th>Tên món</th>
                            <th class="text-center">Số lượng đặt</th>
                            <th class="text-center">Số lượng dùng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items == null || !Model.Items.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Đơn hàng chưa có món.</td>
                            </tr>
                        }
                        else
                        {
                            @for (var i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                <tr>
                                    <td class="text-center">@(i + 1)</td>
                                    <td>
                                        @item.MenuItemName
                                        <input type="hidden" name="Items[@i].OrderDetailId" value="@item.OrderDetailId" />
                                    </td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td>
                                        <input type="number"
                                               class="form-control text-center"
                                               name="Items[@i].QuantityUsed"
                                               value="@item.Quantity"
                                               min="0"
                                               max="@item.Quantity"
                                               required />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="mb-3">
                <label for="notes" class="form-label fw-bold">Ghi chú</label>
                <textarea id="notes" 
                          name="Notes" 
                          class="form-control" 
                          rows="2" 
                          placeholder="Ví dụ: Khách bỏ món ..."></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="@Url.Action(nameof(CashierPaymentFlowController.OrderDetail), "CashierPaymentFlow", new { id = Model.OrderId })"
                   class="btn btn-outline-secondary">
                    Hủy
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-2"></i>Khách đã xác nhận
                </button>
            </div>
        </div>
    </form>
</div>
