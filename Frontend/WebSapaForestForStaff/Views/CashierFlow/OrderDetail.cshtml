@model WebSapaForestForStaff.DTOs.Payment.OrderDetailDto

@using WebSapaForestForStaff.Controllers

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_LayoutManager.cshtml";
    var tables = Model.TableNumbers != null && Model.TableNumbers.Any()
        ? string.Join(", ", Model.TableNumbers)
        : Model.TableNumber ?? "—";
    
    // Kiểm tra xem đơn hàng đã được khách xác nhận chưa
    var isConfirmed = !string.IsNullOrEmpty(Model.Status) && 
                      (Model.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) ||
                       Model.Status.Equals("Paid", StringComparison.OrdinalIgnoreCase) ||
                       Model.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase));
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h2 class="mb-1">Chi tiết đơn hàng</h2>
        <div class="text-muted">Đơn #@(Model.OrderCode ?? $"#{Model.OrderId}") &nbsp; | &nbsp; Bàn: @tables</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action(nameof(CashierPaymentFlowController.OrderSelection), "CashierPaymentFlow")" 
           class="btn btn-outline-secondary">
            ← Quay lại danh sách
        </a>
        @if (!isConfirmed)
        {
            <a href="@Url.Action(nameof(CashierPaymentFlowController.CustomerConfirm), "CashierPaymentFlow", new { orderId = Model.OrderId })" 
               class="btn btn-success">
                Khách xác nhận món
            </a>
        }
    </div>
</div>

<div class="page-content">
    <!-- Card 1: Danh sách món ăn / đồ uống -->
    <div class="card mb-3">
        <div class="card-header fw-bold bg-white">
            Danh sách món ăn / đồ uống
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light text-center">
                        <tr>
                            <th>STT</th>
                            <th>Tên món</th>
                            <th>SL</th>
                            <th class="text-end">Giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 1;
                            if (Model.Items == null || !Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">Đơn hàng chưa có món.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="text-center">@index</td>
                                        <td>@item.MenuItemName</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("N0") ₫</td>
                                        <td class="text-end">@item.TotalPrice.ToString("N0") ₫</td>
                                    </tr>
                                    index++;
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Card 2: Tổng tạm tính -->
    <div class="card mb-3">
        <div class="card-header fw-bold bg-white">
            Tổng tạm tính
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="fw-bold fs-5">@Model.Subtotal.ToString("N0") ₫</div>
                <div class="d-flex align-items-center gap-2">
                    <label for="promoCode" class="fw-bold text-muted mb-0">Ưu đãi:</label>
                    <input type="text" 
                           id="promoCode" 
                           class="form-control" 
                           style="max-width:150px;" 
                           placeholder="Nhập mã" />
                    <button class="btn btn-outline-success">Áp dụng mã</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Tổng cộng thanh toán -->
    <div class="card">
        <div class="card-header fw-bold bg-white">
            Tổng cộng thanh toán
        </div>
        <div class="card-body text-end">
            <div class="text-muted mb-2">VAT: @Model.VatAmount.ToString("N0") ₫</div>
            <div class="text-muted mb-2">Phí dịch vụ: @Model.ServiceFee.ToString("N0") ₫</div>
            @if (Model.DiscountAmount > 0)
            {
                <div class="text-muted mb-2">Giảm giá: -@Model.DiscountAmount.ToString("N0") ₫</div>
            }
            <div class="fs-4 fw-bold text-primary mt-2 mb-3">@Model.TotalAmount.ToString("N0") ₫</div>
            
            @if (!isConfirmed)
            {
                <div class="alert alert-warning mb-3 text-start">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Chưa thể thanh toán:</strong> Đơn hàng chưa được khách xác nhận. Vui lòng yêu cầu khách xác nhận số lượng món đã dùng trước khi thanh toán.
                </div>
            }
            
            <div class="d-flex justify-content-end gap-2 mt-3">
                <a href="@Url.Action(nameof(CashierPaymentFlowController.OrderSelection), "CashierPaymentFlow")" 
                   class="btn btn-outline-secondary">
                    Cập nhật đơn
                </a>
                <button type="button" 
                        class="btn btn-outline-danger" 
                        onclick="alert('Tính năng hủy đơn sẽ được bổ sung')">
                    Hủy đơn
                </button>
                @if (isConfirmed)
                {
                    <a href="@Url.Action(nameof(CashierPaymentFlowController.Payment), "CashierPaymentFlow", new { id = Model.OrderId })" 
                       class="btn btn-success">
                        Thanh Toán
                    </a>
                }
                else
                {
                    <a href="@Url.Action(nameof(CashierPaymentFlowController.CustomerConfirm), "CashierPaymentFlow", new { orderId = Model.OrderId })" 
                       class="btn btn-warning">
                        <i class="bi bi-check-circle me-2"></i>Khách xác nhận món
                    </a>
                    <button type="button" 
                            class="btn btn-success" 
                            disabled
                            title="Vui lòng yêu cầu khách xác nhận món trước khi thanh toán">
                        Thanh Toán
                    </button>
                }
            </div>
        </div>
    </div>
</div>
