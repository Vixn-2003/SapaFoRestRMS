@model WebSapaForestForStaff.DTOs.Customers.CustomerVipStatisticsDto
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Chi tiết khách hàng";
    Layout = "~/Views/Shared/_LayoutManager.cshtml";
    var antiToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Chi tiết khách hàng</h2>
        <div class="text-muted">ID: @Model.CustomerId</div>
    </div>
    <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Quay lại danh sách</a>
  </div>

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center">
            <div class="me-3">
                <div class="fw-bold">@(!string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName : "Khách lẻ")</div>
                <div class="text-muted">@Model.Phone</div>
            </div>
            <span id="vipBadge" class="badge @(Model.IsVip ? "bg-warning text-dark" : "bg-secondary")">
                @(Model.IsVip ? "VIP" : "Normal")
            </span>
            @if (Model.IsManualOverride)
            {
                <span class="badge bg-info text-dark ms-2">Manual</span>
            }
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted">Tổng chi tiêu</div>
                <div id="totalSpend" class="fs-4 fw-bold">@Model.TotalSpend.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted">Số hóa đơn</div>
                <div id="totalBills" class="fs-4 fw-bold">@Model.TotalBills</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted">Tổng khách</div>
                <div id="totalGuests" class="fs-4 fw-bold">@Model.TotalGuests</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted">Lượt đặt bàn</div>
                <div id="reservationCount" class="fs-4 fw-bold">@Model.NumberOfReservations</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted">Trung bình / Khách</div>
                <div id="avgPerPerson" class="fs-4 fw-bold">@Model.AverageSpendPerPerson.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted">Trung bình / Hóa đơn</div>
                <div id="avgPerBill" class="fs-4 fw-bold">@Model.AverageSpendPerBill.ToString("N0")</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <button id="recalcVip" class="btn btn-primary">Recalculate VIP</button>
    <div id="detailMessage" class="d-none alert mb-0 flex-grow-1"></div>
</div>

<script>
    (() => {
        const antiToken = '@antiToken';
        const customerId = @Model.CustomerId;
        const messageBox = document.getElementById('detailMessage');
        const badge = document.getElementById('vipBadge');

        const showMessage = (text, isError = false) => {
            messageBox.classList.remove('d-none', 'alert-success', 'alert-danger');
            messageBox.classList.add(isError ? 'alert-danger' : 'alert-success');
            messageBox.textContent = text;
        };

        const setBadge = (isVip, isManual) => {
            badge.classList.remove('bg-warning', 'text-dark', 'bg-secondary');
            if (isVip) {
                badge.classList.add('bg-warning', 'text-dark');
                badge.textContent = 'VIP';
            } else {
                badge.classList.add('bg-secondary');
                badge.textContent = 'Normal';
            }

            const manualBadge = badge.parentElement.querySelector('.badge.bg-info');
            if (manualBadge) {
                manualBadge.remove();
            }
            if (isManual) {
                const manual = document.createElement('span');
                manual.className = 'badge bg-info text-dark ms-2';
                manual.textContent = 'Manual';
                badge.parentElement.appendChild(manual);
            }
        };

        const renderStats = (data) => {
            document.getElementById('totalSpend').textContent = (data.totalSpend ?? data.TotalSpend ?? 0).toLocaleString();
            document.getElementById('totalBills').textContent = data.totalBills ?? data.TotalBills ?? 0;
            document.getElementById('totalGuests').textContent = data.totalGuests ?? data.TotalGuests ?? 0;
            document.getElementById('reservationCount').textContent = data.numberOfReservations ?? data.NumberOfReservations ?? 0;
            document.getElementById('avgPerPerson').textContent = (data.averageSpendPerPerson ?? data.AverageSpendPerPerson ?? 0).toLocaleString();
            document.getElementById('avgPerBill').textContent = (data.averageSpendPerBill ?? data.AverageSpendPerBill ?? 0).toLocaleString();
            setBadge(data.isVip ?? data.IsVip ?? false, data.isManualOverride ?? data.IsManualOverride ?? false);
        };

        document.getElementById('recalcVip')?.addEventListener('click', async () => {
            try {
                const payload = new URLSearchParams();
                payload.append('customerId', customerId.toString());

                const response = await fetch('@Url.Action("Recalculate", "ManagerCustomer")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiToken
                    },
                    body: payload.toString()
                });

                if (!response.ok) {
                    throw new Error('Không thể tính lại VIP');
                }

                const result = await response.json();
                if (!result?.success) {
                    throw new Error(result?.message || 'Không thể tính lại VIP');
                }

                renderStats(result.data || result);
                showMessage('Đã tính lại trạng thái VIP');
            } catch (error) {
                showMessage(error.message, true);
            }
        });
    })();
</script>

