@model object

@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    // Handle both UserDetailsResponse and User models
    WebSapaForestForStaff.DTOs.UserManagement.UserDetailsResponse? userDetails = Model as WebSapaForestForStaff.DTOs.UserManagement.UserDetailsResponse;
    WebSapaForestForStaff.DTOs.User? user = Model as WebSapaForestForStaff.DTOs.User;

    string fullName = userDetails?.FullName ?? user?.FullName ?? "Unknown";
    string email = userDetails?.Email ?? user?.Email ?? "";
    string? phone = userDetails?.Phone ?? user?.Phone;
    string roleName = userDetails?.RoleName ?? user?.RoleName ?? "Unknown";
    int status = userDetails?.Status ?? user?.Status ?? 0;
    string? avatarUrl = userDetails?.AvatarUrl ?? user?.AvatarUrl;
    DateTime? createdAt = userDetails?.CreatedAt ?? user?.CreatedAt;
    DateTime? modifiedAt = userDetails?.ModifiedAt ?? user?.ModifiedAt;
    DateTime? lastLoginAt = userDetails?.LastLoginAt;
    string? createdByName = userDetails?.CreatedByName;
    string? modifiedByName = userDetails?.ModifiedByName;
    int userId = userDetails?.UserId ?? user?.UserId ?? 0;
}

<!-- Page Header -->
<div class="page-header">
    <div class="row align-items-center">
        <div class="col">
            <h3 class="page-title">User Details</h3>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="HomeManager" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">User Management</a></li>
                <li class="breadcrumb-item active">@fullName</li>
            </ul>
        </div>
        <div class="col-auto">
            <a asp-action="Edit" asp-route-id="@userId" class="btn btn-primary">
                <i class="fas fa-edit"></i> Edit User
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

<div class="row">
    <!-- User Profile Card -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(avatarUrl))
                {
                    <img src="@avatarUrl" alt="User Avatar" class="img-fluid rounded-circle mb-3" style="width: 120px; height: 120px; object-fit: cover;">
                }
                else
                {
                    <div class="avatar avatar-xl mb-3 mx-auto">
                        <div class="avatar-img rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 120px; height: 120px; font-size: 48px;">
                            <span>@fullName.Split(' ').LastOrDefault()?.Substring(0, 1)?.ToUpper()</span>
                        </div>
                    </div>
                }
                <h4>@fullName</h4>
                <p class="text-muted">@email</p>
                <div class="mb-3">
                    <span class="badge @(status == 1 ? "badge-success" : "badge-danger") badge-lg">
                        @(status == 1 ? "Active" : "Inactive")
                    </span>
                </div>
                <div class="mb-3">
                    <span class="badge badge-pill @(userDetails?.RoleId == 1 ? "badge-danger" : userDetails?.RoleId == 2 ? "badge-warning" : userDetails?.RoleId == 3 ? "badge-info" : "badge-secondary")">
                        @roleName
                    </span>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    @if (status == 1)
                    {
                        <button type="button" class="btn btn-warning" onclick="changeStatus(@userId, 0)">
                            <i class="fas fa-ban"></i> Deactivate User
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success" onclick="changeStatus(@userId, 1)">
                            <i class="fas fa-check"></i> Activate User
                        </button>
                    }
                    <button type="button" class="btn btn-danger" onclick="openDeleteModal(@userId, '@fullName')">
                        <i class="fas fa-trash"></i> Delete User
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- User Information -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Basic Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Full Name</label>
                            <p>@fullName</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Email</label>
                            <p>@email</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Phone</label>
                            <p>@(string.IsNullOrEmpty(phone) ? "Not provided" : phone)</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Role</label>
                            <p>@roleName</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Status</label>
                            <p>
                                <span class="badge @(status == 1 ? "badge-success" : "badge-danger")">
                                    @(status == 1 ? "Active" : "Inactive")
                                </span>
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Last Login</label>
                            <p>@(lastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "Never logged in")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Account Information -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Account Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">User ID</label>
                            <p>@userId</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Created Date</label>
                            <p>@(createdAt?.ToString("dd/MM/yyyy HH:mm") ?? "Unknown")</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Created By</label>
                            <p>@(createdByName ?? "System")</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Last Modified</label>
                            <p>@(modifiedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Never modified")</p>
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(modifiedByName))
                {
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Modified By</label>
                                <p>@modifiedByName</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (userDetails != null && userDetails.LoginHistory.Any())
        {
            <!-- Login History -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Recent Login History</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Login Time</th>
                                    <th>IP Address</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var login in userDetails.LoginHistory.Take(10))
                                {
                                    <tr>
                                        <td>@login.LoginTime.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@(login.IpAddress ?? "Unknown")</td>
                                        <td>
                                            <span class="badge @(login.IsSuccessful ? "badge-success" : "badge-danger")">
                                                @(login.IsSuccessful ? "Success" : "Failed")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (userDetails != null && userDetails.RecentActivities.Any())
        {
            <!-- Recent Activities -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Recent Activities</h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        @foreach (var activity in userDetails.RecentActivities.Take(10))
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-primary"></div>
                                <div class="timeline-content">
                                    <h6 class="timeline-title">@activity.ActivityType</h6>
                                    <p class="timeline-text">@activity.Description</p>
                                    <small class="text-muted">@activity.ActivityTime.ToString("dd/MM/yyyy HH:mm")</small>
                                    @if (!string.IsNullOrEmpty(activity.IpAddress))
                                    {
                                        <small class="text-muted ml-2">IP: @activity.IpAddress</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete User</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-danger"><strong>Warning: This action cannot be undone!</strong></p>
                <p>Are you sure you want to permanently delete this user?</p>
                <p><strong>Name:</strong> <span id="deleteUserName"></span></p>
                <div class="form-group">
                    <label for="deleteReason">Reason (optional)</label>
                    <textarea id="deleteReason" class="form-control" rows="3" placeholder="Enter reason for deletion..."></textarea>
                </div>
                <input type="hidden" id="deleteUserId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="submitDelete()">Delete Permanently</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/users-management.js"></script>
    <script>
        // Show success/error messages from TempData
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            toastr.success('@TempData["SuccessMessage"]');
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            toastr.error('@TempData["ErrorMessage"]');
            </text>
        }
    </script>
}
